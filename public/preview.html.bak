        const filteredTrainersList = computed(() => {
            return trainersListSim.value.filter(t => {
                if (trainerSearchFilter.value) {
                    const q = trainerSearchFilter.value.toLowerCase();
                    const match = t.name.toLowerCase().includes(q) || t.nik.toLowerCase().includes(q) || t.department.toLowerCase().includes(q);
                    if (!match) return false;
                }
                if (trainerTypeFilter.value && t.trainer_type !== trainerTypeFilter.value) return false;
                if (trainerRosterFilter.value && t.today_roster.status !== trainerRosterFilter.value) return false;
                return true;
            });
        });

        // Modal Angkat Manpower
        const showPromoteTrainerModal = ref(false);
        const promoteTrainerForm = reactive({
            manpower_id: '',
