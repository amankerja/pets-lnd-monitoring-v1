        const saveCompetencySim = () => {
            if (!competencyModalSim.code || !competencyModalSim.name) {
                notify('Harap lengkapi Kode dan Nama Kompetensi!', 'error');
                return;
            }
            const cleanCode = competencyModalSim.code.toUpperCase().trim();
            if (competencyModalSim.isEdit) {
                const item = skills.value.find(s => s.id === competencyModalSim.id);
                if (item) {
                    item.code = cleanCode;
                    item.name = competencyModalSim.name;
                    item.category = competencyModalSim.category;
                    item.competency_type = competencyModalSim.competency_type;
                    item.description = competencyModalSim.description;
                }
                notify(`Master Kompetensi [${cleanCode}] berhasil diperbarui!`);
            } else {
                const newId = Math.max(...skills.value.map(s => s.id), 0) + 1;
                skills.value.push({
                    id: newId,
                    code: cleanCode,
                    name: competencyModalSim.name,
                    category: competencyModalSim.category,
                    competency_type: competencyModalSim.competency_type,
                    description: competencyModalSim.description,
                });
                notify(`Master Kompetensi [${cleanCode}] berhasil ditambahkan!`);
            }
            competencyModalSim.open = false;
        };

        const deleteCompetencySim = (c) => {
            if (window.confirm(`Hapus Master Kompetensi [${c.code}] ${c.name}?`)) {
