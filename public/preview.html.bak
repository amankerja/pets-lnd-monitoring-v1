        });

        const submitPromoteTrainerSim = () => {
            const p = participants.value.find(x => x.id === Number(promoteTrainerForm.manpower_id));
            if (!p) {
                notify('Pilih karyawan manpower terlebih dahulu!', 'error');
                return;
            }
            const newTrId = trainersListSim.value.length + 1;
            const newSkills = promoteTrainerForm.skill_ids.map((skId, idx) => {
                const sk = skills.value.find(s => s.id === skId);
                return {
                    id: newTrId * 10 + idx,
