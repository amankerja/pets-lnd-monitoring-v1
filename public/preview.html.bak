                                <span>Pendaftaran, Progress &amp; Sertifikat</span>
                            </button>
                            <button v-if="['lnd'].includes(activeRoleSim)" @click="currentView = 'admin-trainer-management'; selectedTrainerDetail = null;" :class="['w-full flex items-center justify-between px-2.5 py-2 rounded-lg text-left transition-all', currentView === 'admin-trainer-management' && !selectedTrainerDetail ? 'bg-blue-600 text-white font-bold shadow-sm shadow-blue-500/30' : 'text-slate-600 hover:bg-blue-50/80 hover:text-blue-700 font-semibold']">
                                <span>Manajemen Trainer &amp; Roster</span>
                                <span class="px-1.5 py-0.5 rounded bg-blue-50 text-blue-700 border border-blue-200 text-[9px] font-bold">360°</span>
                            </button>
                        </div>
                    </div>

                    <!-- 3. COMPETENCY -->
                    <div class="rounded-xl border border-slate-200/80 bg-slate-50/70 overflow-hidden shadow-sm">
                        <button @click="openSidebarGroups.competency = !openSidebarGroups.competency" class="w-full px-3 py-2.5 flex items-center justify-between text-left hover:bg-slate-100/90 transition-colors group">
                            <span class="text-[11px] font-black uppercase tracking-wider text-slate-600 group-hover:text-blue-700">3. COMPETENCY</span>
                            <span v-if="!isSidebarCollapsed" class="text-[10px] text-slate-400 group-hover:text-slate-600">{{ openSidebarGroups.competency ? '▲' : '▼' }}</span>
