<script>
window.PREVIEW_TRAINING_CATALOG = /*PREVIEW_TRAINING_CATALOG*/ [];
const { createApp, ref, reactive, computed, onMounted, onUnmounted } = Vue;

// ============================================================================
// ISO/IEC 18004 Version 2-L (25x25) Native SVG QR Code Matrix Generator
// ============================================================================
function generateQrMatrix(textInput) {
    const text = String(textInput || 'LND-PANI');
    const bytes = Array.from(new TextEncoder().encode(text)).slice(0, 32);
    const size = 25;
    const matrix = Array.from({ length: size }, () => Array(size).fill(null));
    const reserved = Array.from({ length: size }, () => Array(size).fill(false));

    const placeFinder = (row, col) => {
        for (let r = -1; r <= 7; r++) {
            for (let c = -1; c <= 7; c++) {
                const rr = row + r, cc = col + c;
                if (rr >= 0 && rr < size && cc >= 0 && cc < size) {
                    const inOuter = r >= 0 && r <= 6 && c >= 0 && c <= 6 && (r === 0 || r === 6 || c === 0 || c === 6);
                    const inInner = r >= 2 && r <= 4 && c >= 2 && c <= 4;
                    matrix[rr][cc] = (inOuter || inInner) ? 1 : 0;
                    reserved[rr][cc] = true;
                }
            }
        }
    };
    placeFinder(0, 0);
    placeFinder(0, size - 7);
    placeFinder(size - 7, 0);

    for (let r = -2; r <= 2; r++) {
        for (let c = -2; c <= 2; c++) {
            const isBorder = Math.abs(r) === 2 || Math.abs(c) === 2;
            const isCenter = r === 0 && c === 0;
            matrix[18 + r][18 + c] = (isBorder || isCenter) ? 1 : 0;
            reserved[18 + r][18 + c] = true;
        }
    }

    for (let i = 8; i < size - 8; i++) {
        if (!reserved[6][i]) { matrix[6][i] = i % 2 === 0 ? 1 : 0; reserved[6][i] = true; }
        if (!reserved[i][6]) { matrix[i][6] = i % 2 === 0 ? 1 : 0; reserved[i][6] = true; }
    }

    matrix[size - 8][8] = 1;
    reserved[size - 8][8] = true;
    for (let i = 0; i < 9; i++) { reserved[8][i] = true; reserved[i][8] = true; }
    for (let i = 0; i < 8; i++) { reserved[8][size - 1 - i] = true; reserved[size - 1 - i][8] = true; }

    const bits = [];
    const pushBits = (val, len) => { for (let i = len - 1; i >= 0; i--) bits.push((val >> i) & 1); };
    pushBits(0b0100, 4);
    pushBits(bytes.length, 8);
    bytes.forEach(b => pushBits(b, 8));
    pushBits(0, Math.min(4, 34 * 8 - bits.length));
    while (bits.length % 8 !== 0) bits.push(0);

    const dataWords = [];
    for (let i = 0; i < bits.length; i += 8) {
        let byte = 0;
        for (let b = 0; b < 8; b++) byte = (byte << 1) | bits[i + b];
        dataWords.push(byte);
    }
    const padBytes = [0xec, 0x11];
    let padIdx = 0;
    while (dataWords.length < 34) { dataWords.push(padBytes[padIdx % 2]); padIdx++; }

    const gfExp = new Uint8Array(512);
    const gfLog = new Uint8Array(256);
    let x = 1;
    for (let i = 0; i < 255; i++) {
        gfExp[i] = x; gfLog[x] = i;
        x <<= 1; if (x & 0x100) x ^= 0x11d;
    }
    for (let i = 255; i < 512; i++) gfExp[i] = gfExp[i - 255];
    const gfMul = (a, b) => (a === 0 || b === 0 ? 0 : gfExp[gfLog[a] + gfLog[b]]);

    let gen = [1];
    for (let i = 0; i < 10; i++) {
        const next = new Array(gen.length + 1).fill(0);
        for (let j = 0; j < gen.length; j++) {
            next[j] ^= gen[j];
            next[j + 1] ^= gfMul(gen[j], gfExp[i]);
        }
        gen = next;
    }

    const msg = [...dataWords, ...new Array(10).fill(0)];
    for (let i = 0; i < dataWords.length; i++) {
        const coef = msg[i];
        if (coef !== 0) {
            for (let j = 0; j < gen.length; j++) msg[i + j] ^= gfMul(gen[j], coef);
        }
    }
    const ecWords = msg.slice(dataWords.length);
    const allWords = [...dataWords, ...ecWords];
    const finalBits = [];
    allWords.forEach(w => { for (let i = 7; i >= 0; i--) finalBits.push((w >> i) & 1); });

    let bitIdx = 0, upward = true;
    for (let col = size - 1; col > 0; col -= 2) {
        if (col === 6) col--;
        for (let step = 0; step < size; step++) {
            const row = upward ? size - 1 - step : step;
            for (let cOffset = 0; cOffset < 2; cOffset++) {
                const cc = col - cOffset;
                if (!reserved[row][cc]) {
                    const bit = bitIdx < finalBits.length ? finalBits[bitIdx++] : 0;
                    const mask = (row + cc) % 2 === 0 ? 1 : 0;
                    matrix[row][cc] = bit ^ mask;
                }
            }
        }
        upward = !upward;
    }

    const formatBits = [1, 1, 1, 0, 1, 1, 1, 1, 1, 0, 0, 0, 1, 0, 0];
    const formatCoords1 = [[8,0],[8,1],[8,2],[8,3],[8,4],[8,5],[8,7],[8,8],[7,8],[5,8],[4,8],[3,8],[2,8],[1,8],[0,8]];
    const formatCoords2 = [[24,8],[23,8],[22,8],[21,8],[20,8],[19,8],[18,8],[8,17],[8,18],[8,19],[8,20],[8,21],[8,22],[8,23],[8,24]];
    for (let i = 0; i < 15; i++) {
        matrix[formatCoords1[i][0]][formatCoords1[i][1]] = formatBits[i];
        matrix[formatCoords2[i][0]][formatCoords2[i][1]] = formatBits[i];
    }
    return matrix;
}

// Deterministic HMAC-like hash for browser preview matching PHP `getDynamicPayload`
function computeWindowHmac(sessionId, secret, windowVal) {
    const str = `${sessionId}:${secret}:${windowVal}`;
    let h1 = 0xdeadbeef ^ str.length, h2 = 0x41c6ce57 ^ str.length;
    for (let i = 0, ch; i < str.length; i++) {
        ch = str.charCodeAt(i);
        h1 = Math.imul(h1 ^ ch, 2654435761);
        h2 = Math.imul(h2 ^ ch, 1597334677);
    }
    h1 = Math.imul(h1 ^ (h1 >>> 16), 2246822507) ^ Math.imul(h2 ^ (h2 >>> 13), 3266489909);
    h2 = Math.imul(h2 ^ (h2 >>> 16), 2246822507) ^ Math.imul(h1 ^ (h1 >>> 13), 3266489909);
    const hex = ((h1 >>> 0).toString(16).padStart(8, '0') + (h2 >>> 0).toString(16).padStart(8, '0')).toUpperCase().slice(0, 12);
    const pin = String(parseInt(hex.slice(0, 6), 16) % 1000000).padStart(6, '0');
    return { signature: hex, payload: `${sessionId}:${hex}`, manual_code: pin };
}

