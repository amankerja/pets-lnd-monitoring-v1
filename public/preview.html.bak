            const cleanCode = courseModalSim.code.toUpperCase().trim();
            const newId = Math.max(...courses.value.map(c => c.id), 0) + 1;
            const skillItem = skills.value.find(s => s.id === Number(courseModalSim.skill_id));
            courses.value.push({
                id: newId,
                code: cleanCode,
                title: courseModalSim.title,
                skill_id: Number(courseModalSim.skill_id),
                granted_skill_level: Number(courseModalSim.granted_skill_level),
