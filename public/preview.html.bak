            { nik: 'VND240002', name: 'Rahmat Hidayat (Mitra Kerja)', site: 'PT Sangati Soerya Sejahtera', department: 'Processing', level: 'Staff' },
            { nik: 'VND240003', name: 'Budi Wahyudi (Mitra Kerja)', site: 'PT Elabram Systems', department: 'Engineering', level: 'Non-Staff' },
            { nik: 'VND240004', name: 'Heri Gunawan (Mitra Kerja)', site: 'PT Sangati Soerya Sejahtera', department: 'Occupational Health & Safety', level: 'Officer' },
            { nik: 'GSM210089', name: 'Eka Saputri', site: 'PT Gorontalo Sejahtera Mining', department: 'Commercial', level: 'Staff' },
            { nik: 'GSM230019', name: 'Farhan Maulana', site: 'PT Gorontalo Sejahtera Mining', department: 'Mining', level: 'Supervisor' },
            { nik: 'GSM250062', name: 'Gita Wulandari', site: 'PT Gorontalo Sejahtera Mining', department: 'Processing', level: 'Staff' },
        ];

        // Generate Peserta MDKA beserta Skill Matrix & Enrollments (Internal Dept & External Contractor)
        const participants = ref(mdkaRoster.map((item, idx) => {
            const isContractor = item.nik.startsWith('VND') || item.site.includes('Elabram') || item.site.includes('Sangati');
            const dept = item.department;
            const org_type = isContractor ? 'contractor' : 'internal_dept';
            const skills_map = {};
            skills.value.forEach((s, sIdx) => {
                let target = 3;
                if (dept === 'Mining' && ['SKL-OPS-01', 'SKL-OPS-02', 'SKL-HSE-01'].includes(s.code)) target = 4;
                if (dept === 'Processing' && ['SKL-MNT-01', 'SKL-HSE-01'].includes(s.code)) target = 5;
                if (dept === 'Occupational Health & Safety' && ['SKL-HSE-01', 'SKL-HSE-02', 'SKL-LDR-01'].includes(s.code)) target = 5;
                const current = Math.max(1, Math.min(5, ((idx + sIdx * 2) % 5) + 1));
                let status = current < target ? 'gap' : 'valid';
                let valid_until = null;
                let days_left = null;
                let cert_no = null;

                if (current >= target) {
                    if ((idx + sIdx) % 7 === 0) {
                        status = 'expired';
                        valid_until = '05 Okt 2026';
                        days_left = -20;
                        cert_no = `CERT/MDKA-${s.code}/2024/10/00${String(idx + 1).padStart(2, '0')}`;
                    } else if ((idx + sIdx) % 5 === 0) {
                        status = 'warning_h60';
                        valid_until = '22 Nov 2026';
                        days_left = 28;
                        cert_no = `CERT/MDKA-${s.code}/2024/11/00${String(idx + 1).padStart(2, '0')}`;
                    } else {
                        status = 'valid';
                        valid_until = '15 Okt 2028';
                        days_left = 720;
                        cert_no = `CERT/MDKA-${s.code}/2026/10/00${String(idx + 1).padStart(2, '0')}`;
                    }
                }

                skills_map[s.id] = {
                    skill_id: s.id,
                    current_level: current,
                    target_level: target,
                    gap: current - target,
                    status,
                    valid_until,
                    days_left,
                    cert_no,
                };
            });

            return {
                id: idx + 1,
                name: item.name,
                nik: item.nik,
                department: item.department,
                org_type,
                site: item.site,
                job_level: item.level,
                email: `${item.nik.toLowerCase()}@pani.co.id`,
                skills_map,
            };
        }));

        const individualSearch = ref('');
        const selectedIndividualUserId = ref(participants.value[0]?.id || null);
        const individualParticipants = computed(() => {
            const query = individualSearch.value.trim().toLowerCase();
            if (!query) return participants.value;
            return participants.value.filter((person) =>
                [person.name, person.nik, person.department].some((value) =>
                    String(value || '').toLowerCase().includes(query)
                )
            );
        });
        const selectedIndividualUser = computed(() =>
            participants.value.find((person) => person.id === Number(selectedIndividualUserId.value)) || null
        );
        const previewRequirementType = (training) => {
            const course = courses.value.find((item) => item.title === training.title);
            if (!course) return 'NR';
            return course.is_mandatory ? 'M' : 'NM';
        };
        const previewTrainingStatus = (person, index, requirement) => {
            if (requirement === 'NR') return 'N/A';
            const statusSeed = (person.id * 17 + index * 7) % 12;
            if (statusSeed < 6) return 'Completed';
            if (statusSeed < 8) return 'Expired';
            return 'Not Yet Completed';
        };
        const individualTrainingRows = computed(() => {
            const person = selectedIndividualUser.value;
            if (!person) return [];
            return previewTrainingCatalog.map((training, index) => {
                const course = courses.value.find((item) => item.title === training.title);
                const requirement = previewRequirementType(training);
                const completion = previewTrainingStatus(person, index, requirement);
                return {
                    id: index + 1,
                    code: course?.code || '—',
                    title: training.title,
                    category: training.category || 'General',
                    source: course?.training_source || 'internal',
                    requirement,
                    completion,
                    expiry: completion === 'Expired' ? '01/09/2026' : completion === 'Completed' ? '01/09/2028' : '—',
                };
            });
        });
        const individualTrainingSummary = computed(() => ({
            completed: individualTrainingRows.value.filter((training) => training.completion === 'Completed').length,
            not_yet: individualTrainingRows.value.filter((training) => training.completion === 'Not Yet Completed').length,
            expired: individualTrainingRows.value.filter((training) => training.completion === 'Expired').length,
            not_required: individualTrainingRows.value.filter((training) => training.completion === 'N/A').length,
        }));
        const trainingTypeSummaryRows = computed(() => previewTrainingCatalog.map((training, index) => {
            const course = courses.value.find((item) => item.title === training.title);
            const required = previewRequirementType(training) === 'M' ? participants.value : [];
            const statuses = required.map((person) => previewTrainingStatus(person, index, 'M'));
            const completed = statuses.filter((status) => status === 'Completed' || status === 'Expired').length;
            return {
                id: index + 1,
                code: course?.code || '—',
                title: training.title,
                category: training.category || 'General',
                executor: course?.training_source || 'internal',
                total_required: required.length,
                completed,
                not_yet: statuses.filter((status) => status === 'Not Yet Completed').length,
                expired: statuses.filter((status) => status === 'Expired').length,
                completion_pct: required.length ? Math.round((completed / required.length) * 100) : 0,
            };
        }));
        const divisionSummaryRows = computed(() => {
            const departmentsInRoster = [...new Set(participants.value.map((person) => person.department))];
            return departmentsInRoster.map((department) => {
                const workers = participants.value.filter((person) => person.department === department);
                let mandatoryInternal = 0;
                let mandatoryExternal = 0;
                let nonMandatory = 0;
                previewTrainingCatalog.forEach((training) => {
                    const requirement = previewRequirementType(training);
                    const course = courses.value.find((item) => item.title === training.title);
                    if (requirement === 'M' && course?.training_source === 'external') mandatoryExternal += workers.length;
                    else if (requirement === 'M') mandatoryInternal += workers.length;
                    else if (requirement === 'NM') nonMandatory += workers.length;
                });
                return {
                    department,
                    employee_count: workers.length,
                    mandatory_internal: mandatoryInternal,
                    mandatory_external: mandatoryExternal,
                    total_mandatory: mandatoryInternal + mandatoryExternal,
                    non_mandatory: nonMandatory,
                };
            });
        });
        const employeeCompletionRows = computed(() => participants.value.map((person) => {
            const mandatory = previewTrainingCatalog
                .map((training, index) => ({ training, index }))
                .filter(({ training }) => previewRequirementType(training) === 'M');
            const statuses = mandatory.map(({ index }) => previewTrainingStatus(person, index, 'M'));
            const expired = statuses.filter((status) => status === 'Expired').length;
            const notYet = statuses.filter((status) => status === 'Not Yet Completed').length;
            return {
                ...person,
                mandatory_count: mandatory.length,
                completed_count: statuses.filter((status) => status === 'Completed' || status === 'Expired').length,
                expired_count: expired,
                not_yet_count: notYet,
                fully_completed: mandatory.length > 0 && expired === 0 && notYet === 0 ? 'YES' : 'NO',
            };
        }));

        // Enrollments lintas 4 Course dengan tanggal & nomor sertifikat
        const enrollments = ref([]);
        let enrId = 1;
        const sampleDates = ['2026-08-12', '2026-09-15', '2026-10-14', '2026-10-20', '2026-10-24'];
        participants.value.slice(0, 20).forEach((p, idx) => {
            const status = idx >= 18 ? 'pending' : 'approved';
            const completedCount = status === 'approved' ? (idx % 5) : 0;
            const completed_modules = {};
            courses.value[0].modules.forEach((m, mIdx) => {
                completed_modules[m.id] = mIdx < completedCount;
            });
            const dateStr = sampleDates[idx % sampleDates.length];
            enrollments.value.push({
                id: enrId,
                user_id: p.id,
                course_id: 1,
                status,
                created_at: dateStr,
                certificate_number: `CERT/PANI/2026/${String(enrId).padStart(4, '0')}`,
                progress_percentage: Math.round((completedCount / 4) * 100),
                completed_modules,
            });
            enrId++;
        });
        participants.value.slice(8, 25).forEach((p, idx) => {
            const status = idx === 16 ? 'pending' : 'approved';
            const completedCount = status === 'approved' ? ((idx + 1) % 5) : 0;
            const cIdx = (idx % 3) + 1; // Course 2, 3, or 4
            const targetCourse = courses.value[cIdx];
            const completed_modules = {};
            targetCourse.modules.forEach((m, mIdx) => {
                completed_modules[m.id] = mIdx < completedCount;
            });
            const dateStr = sampleDates[(idx + 2) % sampleDates.length];
            enrollments.value.push({
                id: enrId,
                user_id: p.id,
                course_id: targetCourse.id,
                status,
                created_at: dateStr,
                certificate_number: `CERT/PANI/2026/${String(enrId).padStart(4, '0')}`,
                progress_percentage: Math.round((Math.min(completedCount, targetCourse.modules.length) / targetCourse.modules.length) * 100),
                completed_modules,
            });
            enrId++;
        });

        const registerPreviewTraining = (training) => {
            const person = selectedIndividualUser.value;
            const course = courses.value.find((item) => item.title === training.title);
            if (!person || !course) {
                notify('Data karyawan atau program training tidak ditemukan.', 'error');
                return;
            }
            const existing = enrollments.value.find((enrollment) =>
                enrollment.user_id === person.id && enrollment.course_id === course.id
            );
            if (existing) {
                notify(`${person.name} sudah terdaftar pada ${course.title}.`, 'error');
                return;
            }

            enrollments.value.push({
                id: enrId++,
                user_id: person.id,
                course_id: course.id,
                status: 'pending',
                created_at: new Date().toISOString().slice(0, 10),
                certificate_number: '',
                progress_percentage: 0,
                completed_modules: Object.fromEntries(course.modules.map((module) => [module.id, false])),
            });
            enrollmentFilter.course_id = String(course.id);
            enrollmentFilter.course_code = course.code;
            currentView.value = 'admin-enrollments';
            notify(`Pendaftaran ${person.name} ke ${course.title} berhasil dibuat dan menunggu approval.`);
        };

        // Attendance Sessions & Live Logs
        const sessions = ref([
            { id: 1, course_id: 1, course_code: 'CRS-2025-001', course_title: courses.value[0].title, title: 'Sesi 1: Kick-off & Regulasi SMKP', session_date: '2026-10-17', short_date: '17 Okt', secret_key: 'SECRET-C1-S1', is_active: false, present_count: 16, permit_count: 2, absent_count: 1 },
            { id: 2, course_id: 1, course_code: 'CRS-2025-001', course_title: courses.value[0].title, title: 'Sesi 2: Workshop HIRA & JSA Lapangan', session_date: '2026-10-24', short_date: '24 Okt', secret_key: 'SECRET-C1-S2-LIVE', is_active: true, present_count: 14, permit_count: 1, absent_count: 0 },
            { id: 3, course_id: 2, course_code: 'CRS-2025-002', course_title: courses.value[1].title, title: 'Sesi 1: Analisa Cycle Time & Hauling', session_date: '2026-10-20', short_date: '20 Okt', secret_key: 'SECRET-C2-S1', is_active: false, present_count: 15, permit_count: 1, absent_count: 0 },
            { id: 4, course_id: 2, course_code: 'CRS-2025-002', course_title: courses.value[1].title, title: 'Sesi 2: Praktek Preventive Hidrolik', session_date: '2026-10-24', short_date: '24 Okt', secret_key: 'SECRET-C2-S2-LIVE', is_active: true, present_count: 12, permit_count: 1, absent_count: 1 },
        ]);

        const activeSessionId = ref(2);
        const activeSession = computed(() => sessions.value.find(s => s.id === Number(activeSessionId.value)) || sessions.value[1]);

        const attendanceLogs = ref(
            participants.value.slice(0, 14).map((p, idx) => ({
                id: idx + 1,
                session_id: 2,
                user_id: p.id,
                name: p.name,
                nik: p.nik,
                department: p.department,
                status: 'present',
                scanned_at: `08:${String(12 + idx * 2).padStart(2, '0')}:15`,
            })).reverse()
        );

        // Peserta yang sedang disimulasikan di Mobile Mode
        const activeParticipantId = ref(15); // Oki Setiana (belum scan di Sesi 2 agar bisa ditest!)
        const activeParticipant = computed(() => participants.value.find(p => p.id === Number(activeParticipantId.value)) || participants.value[0]);

        // Peserta yang dipilih untuk Print Rapor A4
        const printParticipantId = ref(1);
        const printParticipant = computed(() => participants.value.find(p => p.id === Number(printParticipantId.value)) || participants.value[0]);

        // State PWA Install Banner (Preview Android & iOS di Mobile Mode)
        const showPwaBanner = ref(true);
        const previewIosPwa = ref(false);
        const focusManualPinInput = () => {
            const el = document.getElementById('manual-pin-input');
            if (el) el.focus();
        };

        // ====================================================================
        // KPI & Agregasi Dashboard
        // ====================================================================
        const kpis = computed(() => {
            const approved = enrollments.value.filter(e => e.status === 'approved');
            const pending = enrollments.value.filter(e => e.status === 'pending');
            const avgMod = approved.length ? (approved.reduce((a, b) => a + b.progress_percentage, 0) / approved.length).toFixed(1) : 0;
            const totalPresent = sessions.value.reduce((a, s) => a + s.present_count, 0);
            const totalLogs = sessions.value.reduce((a, s) => a + s.present_count + s.permit_count + s.absent_count, 0);
            const attRate = totalLogs ? ((totalPresent / totalLogs) * 100).toFixed(1) : 0;

            return {
                total_participants: participants.value.length,
                total_departments: departments.length,
                active_enrollments: approved.length,
                pending_enrollments: pending.length,
                attendance_rate: attRate,
                present_count: totalPresent,
                total_attendance_records: totalLogs,
                avg_module_progress: avgMod,
            };
        });

        const graduationDistribution = computed(() => {
            const approved = enrollments.value.filter(e => e.status === 'approved');
            return [
                { label: 'Lulus (100%)', value: approved.filter(e => e.progress_percentage === 100).length, color: '#10b981' },
                { label: 'On Track (50-99%)', value: approved.filter(e => e.progress_percentage >= 50 && e.progress_percentage < 100).length, color: '#3b82f6' },
                { label: 'Berjalan (1-49%)', value: approved.filter(e => e.progress_percentage > 0 && e.progress_percentage < 50).length, color: '#f59e0b' },
                { label: 'Belum Mulai (0%)', value: approved.filter(e => e.progress_percentage === 0).length, color: '#94a3b8' },
            ];
        });

        const topSkillGaps = computed(() => {
            return skills.value.map(skill => {
                let deficit = 0, sumTarget = 0, sumCurrent = 0;
                participants.value.forEach(p => {
                    const cell = p.skills_map[skill.id];
                    sumTarget += cell.target_level;
                    sumCurrent += cell.current_level;
                    if (cell.current_level < cell.target_level) deficit++;
                });
                const total = participants.value.length;
                return {
                    ...skill,
                    total_assessed: total,
                    deficit_headcount: deficit,
                    avg_target: (sumTarget / total).toFixed(2),
                    avg_current: (sumCurrent / total).toFixed(2),
                    deficit_percentage: ((deficit / total) * 100).toFixed(1),
                };
            }).sort((a, b) => b.deficit_headcount - a.deficit_headcount).slice(0, 5);
        });

        // ====================================================================
        // Native SVG Bar Chart & Donut Chart Computations
        // ====================================================================
        const hoveredBarIndex = ref(null);
        const barChartData = computed(() => {
            const svgWidth = 720, svgHeight = 260;
            const pad = { top: 26, right: 24, bottom: 52, left: 42 };
            const cw = svgWidth - pad.left - pad.right;
            const ch = svgHeight - pad.top - pad.bottom;
            const maxVal = 20;
            const slotW = cw / sessions.value.length;
            const barW = 44;

            return sessions.value.map((s, idx) => {
                const total = s.present_count + s.permit_count + s.absent_count;
                const presentH = (s.present_count / maxVal) * ch;
                const permitH = (s.permit_count / maxVal) * ch;
                const absentH = (s.absent_count / maxVal) * ch;
                const x = pad.left + idx * slotW + (slotW - barW) / 2;
                const baseY = pad.top + ch;
                const presentY = baseY - presentH;
                const permitY = presentY - permitH;
                const absentY = permitY - absentH;
                const rate = total > 0 ? ((s.present_count / total) * 100).toFixed(1) : 0;

                return {
                    ...s, x, centerX: x + barW / 2, barWidth: barW,
                    presentY, presentH, permitY, permitH, absentY, absentH, present_rate: rate,
                };
            });
        });

        // State interaktif Donut & Bar Chart ala Remotion Elements
        const activeDonutSeg = reactive({ overall: null, internal: null, external: null });
        const activeBarMonthIndex = ref(null);

        const buildDonutSegments = (rawList) => {
            const radius = 70;
            const circ = 2 * Math.PI * radius;
            const total = rawList.reduce((a, b) => a + Number(b.value || 0), 0) || 1;
            let cum = 0;
            return rawList.map((seg, idx) => {
                const frac = seg.value / total;
                const dash = frac * circ;
                const offset = circ * (1 - cum);
                cum += frac;
                return {
                    ...seg,
                    idx,
                    percentage: Math.round(frac * 100),
                    strokeDasharray: `${dash} ${circ - dash}`,
                    strokeDashoffset: offset,
                };
            });
        };

        const overallDonuts = computed(() => {
            const approved = enrollments.value.filter(e => e.status === 'approved');
            const internalApproved = approved.filter(e => e.participant_department !== 'HSE & Quality Control');
            const externalApproved = approved.filter(e => e.participant_department === 'HSE & Quality Control');

            const makeDist = (list) => [
                { label: 'Lulus & Kompeten', value: list.filter(e => e.progress_percentage === 100).length, color: '#10b981' },
                { label: 'On Track (50-99%)', value: list.filter(e => e.progress_percentage >= 50 && e.progress_percentage < 100).length, color: '#3b82f6' },
                { label: 'Sedang Berjalan', value: list.filter(e => e.progress_percentage > 0 && e.progress_percentage < 50).length, color: '#f59e0b' },
                { label: 'Belum Mulai', value: list.filter(e => e.progress_percentage === 0).length, color: '#94a3b8' },
            ];

            return {
                overall: {
                    key: 'overall',
                    title: 'Overall Training Completion',
                    center: 'Overall',
                    note: 'Kepatuhan seluruh pelatihan wajib & non-mandatory.',
                    rate: 85,
                    segments: buildDonutSegments(makeDist(approved)),
                },
                internal: {
                    key: 'internal',
                    title: 'Internal Site Departments',
                    center: 'Internal',
                    note: 'Kepatuhan karyawan site PETS & GSM internal.',
                    rate: 88,
                    segments: buildDonutSegments(makeDist(internalApproved)),
                },
                external: {
                    key: 'external',
                    title: 'External Contractors & Mitra',
                    center: 'Kontraktor',
                    note: 'Kepatuhan personel mitra kontraktor (PAMA, UT).',
                    rate: 76,
                    segments: buildDonutSegments(makeDist(externalApproved)),
                },
            };
        });

        const donutSegments = computed(() => {
            const radius = 76;
            const circ = 2 * Math.PI * radius;
            const total = graduationDistribution.value.reduce((a, b) => a + b.value, 0) || 1;
            let cum = 0;
            return graduationDistribution.value.map(seg => {
                const frac = seg.value / total;
                const dash = frac * circ;
                const offset = circ * (1 - cum);
                cum += frac;
                return {
                    ...seg,
                    percentage: Math.round(frac * 100),
                    strokeDasharray: `${dash} ${circ - dash}`,
                    strokeDashoffset: offset,
                };
            });
        });

        // ====================================================================
        // 5 METRIK UTAMA DASHBOARD LnD
        // ====================================================================
        const currentYear = 2026;
        const monthsLabels = ['Jan', 'Feb', 'Mar', 'Apr', 'Mei', 'Jun', 'Jul', 'Ags', 'Sep', 'Okt', 'Nov', 'Des'];

        const dashboardMetrics = computed(() => {
            const participationTrend = [12, 18, 25, 20, 32, 38, 28, 34, 42, 48, 22, 26];
            const trainerHoursTrend = [16, 24, 38, 30, 52, 60, 44, 50, 68, 74, 34, 40];
            const selfReportTrend = [3, 4, 7, 5, 9, 11, 8, 12, 15, 18, 8, 10];

            // 2. Top 12 Skill Gap Terbesar
            const topSkillGaps = [
                { id: 1, code: 'SFT-K3-01', name: 'Keselamatan & Kesehatan Kerja Umum (K3 Tambang)', total_deficits: 24 },
                { id: 2, code: 'PLT-PLC-02', name: 'Automasi PLC & Sensor Industri Pengolahan Emas', total_deficits: 19 },
                { id: 3, code: 'OPS-DDT-03', name: 'Defensive Driving & Penanganan Jalur Hauling Curam', total_deficits: 17 },
                { id: 4, code: 'SFT-ISO-04', name: 'Investigasi Insiden & Root Cause Analysis (RCA)', total_deficits: 15 },
                { id: 5, code: 'ENG-GEO-05', name: 'Monitoring Kestabilan Lereng & Geoteknik Tambang', total_deficits: 14 },
                { id: 6, code: 'ENV-AMR-06', name: 'Manajemen Air Asam Tambang & Pengelolaan Limbah', total_deficits: 12 },
                { id: 7, code: 'PLT-HYD-07', name: 'Sistem Hidrolik & Pneumatik Alat Berat Crusher', total_deficits: 11 },
                { id: 8, code: 'OPS-RIG-08', name: 'Rigger & Lifting Operation Standard Pertambangan', total_deficits: 10 },
                { id: 9, code: 'SFT-FIR-09', name: 'Emergency Response & Fire Fighting Specialist', total_deficits: 9 },
                { id: 10, code: 'ENG-SUR-10', name: 'Drone Mapping & Survey Pit Topografi Terbuka', total_deficits: 8 },
                { id: 11, code: 'LDR-POP-11', name: 'Pengawas Operasional Pertama (POP) Sertifikasi', total_deficits: 7 },
                { id: 12, code: 'SFT-CS-12', name: 'Confined Space & Gas Testing Monitoring Tanki', total_deficits: 6 },
            ];

            // 3. Tren Pelatihan Time-Series Bulanan
            const monthlyTrainingVolume = monthsLabels.map((m, idx) => ({
                month: m,
                courses_count: Math.max(2, Math.round(participationTrend[idx] / 4)),
                participants: participationTrend[idx],
            }));

            // 4. Manpower Terkompetensi per Perusahaan / Organisasi
            const manpowerCompetencyPerOrg = [
                { org_name: 'Mining Operation', org_type: 'internal_dept', total_manpower: 45, fully_competent_count: 38, competency_percentage: 84.4 },
                { org_name: 'Processing Plant', org_type: 'internal_dept', total_manpower: 38, fully_competent_count: 31, competency_percentage: 81.6 },
                { org_name: 'HSE & Safety Team', org_type: 'internal_dept', total_manpower: 18, fully_competent_count: 17, competency_percentage: 94.4 },
                { org_name: 'Maintenance & Engineering', org_type: 'internal_dept', total_manpower: 30, fully_competent_count: 25, competency_percentage: 83.3 },
                { org_name: 'PT United Tractors (Hauling)', org_type: 'contractor', total_manpower: 28, fully_competent_count: 21, competency_percentage: 75.0 },
                { org_name: 'PT Pamapersada Nusantara', org_type: 'contractor', total_manpower: 36, fully_competent_count: 28, competency_percentage: 77.8 },
                { org_name: 'PT Mandiri Jaya Utama', org_type: 'contractor', total_manpower: 24, fully_competent_count: 16, competency_percentage: 66.7 },
            ];

            // 5. Jadwal Pelatihan Terdekat
            const upcomingSchedules = [
                { id: 101, code: 'CRS-2026-001', title: 'Sistem Manajemen Keselamatan Pertambangan (SMKP Minerba)', category: 'Safety', is_mandatory: true, start_date: '28 Okt 2026', trainer_name: 'Bambang Trianto', competency_name: 'Keselamatan & Kesehatan Kerja Umum (K3 Tambang)' },
                { id: 102, code: 'CRS-2026-002', title: 'Defensive Driving & Penanganan Jalur Hauling Curam', category: 'Operation', is_mandatory: true, start_date: '02 Nov 2026', trainer_name: 'Ir. Agus Wijaya, ST', competency_name: 'Defensive Driving & Penanganan Jalur Hauling Curam' },
                { id: 103, code: 'CRS-2026-003', title: 'Pemeliharaan Listrik & Otomasi PLC Processing Plant', category: 'Plant', is_mandatory: false, start_date: '05 Nov 2026', trainer_name: 'Bambang Trianto', competency_name: 'Automasi PLC & Sensor Industri Pengolahan Emas' },
                { id: 104, code: 'CRS-2026-004', title: 'Sertifikasi Pengawas Operasional Pertama (POP Minerba)', category: 'Pengawas', is_mandatory: true, start_date: '10 Nov 2026', trainer_name: 'Lembaga Sertifikasi Minerba', competency_name: 'Pengawas Operasional Pertama (POP) Sertifikasi' },
                { id: 105, code: 'CRS-2026-005', title: 'Tanggap Darurat Penyelamatan Ruang Terbatas (Confined Space)', category: 'Safety', is_mandatory: true, start_date: '15 Nov 2026', trainer_name: 'Ir. Agus Wijaya, ST', competency_name: 'Confined Space & Gas Testing Monitoring Tanki' },
                { id: 106, code: 'CRS-2026-006', title: 'Teknik Lifting, Rigger & Pengoperasian Crane Tambang', category: 'Operation', is_mandatory: false, start_date: '20 Nov 2026', trainer_name: 'Bambang Trianto', competency_name: 'Rigger & Lifting Operation Standard Pertambangan' },
            ];

            return {
                participationTrend,
                trainerHoursTrend,
                selfReportTrend,
                topSkillGaps,
                monthlyTrainingVolume,
                manpowerCompetencyPerOrg,
                upcomingSchedules,
            };
        });

        const maxParticipation = computed(() => Math.max(...(dashboardMetrics.value?.participationTrend || [10]), 10));
        const maxVolume = computed(() => {
            const list = (dashboardMetrics.value?.monthlyTrainingVolume || []).map(i => i.participants);
            return Math.max(...list, 10);
        });

        // ====================================================================
        // Global Search & Multi-Attribute Filter State (Skill Matrix & Enrollments)
        // ====================================================================
        const sites = [
            'PT Gorontalo Sejahtera Mining',
            'PT Pani Bersama Tambang',
            'PT Puncak Emas Tani Sejatera',
            'PT Panua Bumi Lestari',
            'PT Elabram Systems',
            'PT Sangati Soerya Sejahtera',
            'PT Merdeka Mining Indonesia',
            'Site Pani Project (PETS/GSM)',
            'Jakarta Head Office',
        ];

        const jobLevels = [
            'Non-Staff',
            'Staff',
            'Supervisor',
            'Superintendent',
            'Manager',
        ];

        const matrixFilter = reactive({
            search: '',
            department: '',
            company: '',
            site: '',
            job_level: '',
            course_id: '',
            course_code: '',
            mandatory_type: '',
            training_source: '',
            training_category: '',
            date_mode: 'month',
            date_from: '',
            date_to: '',
            month: '',
        });

        const resetMatrixFilters = () => {
            matrixFilter.search = '';
            matrixFilter.department = '';
            matrixFilter.company = '';
            matrixFilter.site = '';
            matrixFilter.job_level = '';
            matrixFilter.course_id = '';
            matrixFilter.course_code = '';
            matrixFilter.mandatory_type = '';
            matrixFilter.training_source = '';
            matrixFilter.training_category = '';
            matrixFilter.date_mode = 'month';
            matrixFilter.date_from = '';
            matrixFilter.date_to = '';
            matrixFilter.month = '';
        };

        const matchesCourseClassification = (course, filterObj) => {
            if (!course) return false;
            if (filterObj.course_id && Number(course.id) !== Number(filterObj.course_id)) return false;
            if (filterObj.course_code && course.code !== filterObj.course_code) return false;
            if (filterObj.mandatory_type === 'mandatory' && !course.is_mandatory) return false;
            if (filterObj.mandatory_type === 'non_mandatory' && course.is_mandatory) return false;
            if (filterObj.training_source && course.training_source !== filterObj.training_source) return false;
            if (filterObj.training_category && course.training_category !== filterObj.training_category) return false;
            return true;
        };

        const matchesDateFilter = (dateStr, filterObj) => {
            if (!dateStr) return true;
            if (filterObj.date_mode === 'month' && filterObj.month) {
                return dateStr.startsWith(filterObj.month);
            }
            if (filterObj.date_mode === 'range' && filterObj.date_from && filterObj.date_to) {
                return dateStr >= filterObj.date_from && dateStr <= filterObj.date_to;
            }
            if (filterObj.date_from) {
                return dateStr === filterObj.date_from;
            }
            return true;
        };

        const filteredMatrixParticipants = computed(() => {
            return participants.value.filter(p => {
                if (matrixFilter.department && p.department !== matrixFilter.department) return false;
                if (matrixFilter.company && p.department !== matrixFilter.company) return false;
                if (matrixFilter.site && p.site !== matrixFilter.site) return false;
                if (matrixFilter.job_level && p.job_level !== matrixFilter.job_level) return false;

                const userEnrollments = enrollments.value
                    .filter(e => e.user_id === p.id)
                    .map(e => ({ ...e, course: courses.value.find(c => c.id === e.course_id) }));

                const hasCourseAttrFilter = Boolean(
                    matrixFilter.course_id ||
                    matrixFilter.course_code ||
                    matrixFilter.mandatory_type ||
                    matrixFilter.training_source ||
                    matrixFilter.training_category ||
                    matrixFilter.date_from ||
                    matrixFilter.date_to ||
                    matrixFilter.month
                );

                if (hasCourseAttrFilter) {
                    const matchedEnr = userEnrollments.some(e =>
                        matchesCourseClassification(e.course, matrixFilter) &&
                        matchesDateFilter(e.created_at, matrixFilter)
                    );
                    if (!matchedEnr) return false;
                }

                if (matrixFilter.search) {
                    const q = matrixFilter.search.toLowerCase();
                    const matchUser = p.name.toLowerCase().includes(q) || p.nik.toLowerCase().includes(q) || p.department.toLowerCase().includes(q);
                    const matchEnr = userEnrollments.some(e =>
                        (e.certificate_number || '').toLowerCase().includes(q) ||
                        (e.course?.code || '').toLowerCase().includes(q) ||
                        (e.course?.title || '').toLowerCase().includes(q)
                    );
                    if (!matchUser && !matchEnr) return false;
                }
                return true;
            });
        });

        const cellModal = reactive({ open: false, participant: null, skill: null, current_level: 1, target_level: 3 });
        const openCellEditor = (p, s) => {
            const cell = p.skills_map[s.id];
            cellModal.participant = p;
            cellModal.skill = s;
            cellModal.current_level = cell.current_level;
            cellModal.target_level = cell.target_level;
            cellModal.open = true;
        };
        const saveCellEditor = () => {
            if (!cellModal.participant || !cellModal.skill) return;
            const prev = cellModal.participant.skills_map[cellModal.skill.id] || {};
            const isGap = cellModal.current_level < cellModal.target_level;
            let newStatus = isGap ? 'gap' : (prev.status === 'gap' ? 'valid' : (prev.status || 'valid'));
            cellModal.participant.skills_map[cellModal.skill.id] = {
                ...prev,
                skill_id: cellModal.skill.id,
                current_level: cellModal.current_level,
                target_level: cellModal.target_level,
                gap: cellModal.current_level - cellModal.target_level,
                status: newStatus,
                valid_until: !isGap ? (prev.valid_until || '15 Okt 2028') : prev.valid_until,
                days_left: !isGap ? (prev.days_left ?? 720) : prev.days_left,
            };
            cellModal.open = false;
            notify(`Level kompetensi ${cellModal.participant.name} (${cellModal.skill.code}) berhasil diperbarui menjadi ${cellModal.current_level}/${cellModal.target_level}.`);
        };

        // ====================================================================
        // Enrollment & Checklist Progress Modul (dengan Global Multi-Attribute Filter)
        // ====================================================================
        const enrollmentFilter = reactive({
            course_id: '',
            course_code: '',
            status: '',
            search: '',
            department: '',
            company: '',
            site: '',
            job_level: '',
            mandatory_type: '',
            training_source: '',
            training_category: '',
            date_mode: 'month',
            date_from: '',
            date_to: '',
            month: '',
        });

        const resetEnrollmentFilters = () => {
            enrollmentFilter.course_id = '';
            enrollmentFilter.course_code = '';
            enrollmentFilter.status = '';
            enrollmentFilter.search = '';
            enrollmentFilter.department = '';
            enrollmentFilter.company = '';
            enrollmentFilter.site = '';
            enrollmentFilter.job_level = '';
            enrollmentFilter.mandatory_type = '';
            enrollmentFilter.training_source = '';
            enrollmentFilter.training_category = '';
            enrollmentFilter.date_mode = 'month';
            enrollmentFilter.date_from = '';
            enrollmentFilter.date_to = '';
            enrollmentFilter.month = '';
        };

        const activeEnrollmentCourse = computed(() => {
            if (enrollmentFilter.course_id) {
                const byId = courses.value.find(c => c.id === Number(enrollmentFilter.course_id));
                if (byId) return byId;
            }
            if (enrollmentFilter.course_code) {
                const byCode = courses.value.find(c => c.code === enrollmentFilter.course_code);
                if (byCode) return byCode;
            }
            return courses.value[0];
        });

        const filteredEnrollments = computed(() => {
            return enrollments.value
                .map(e => ({
                    ...e,
                    user: participants.value.find(p => p.id === e.user_id),
                    course: courses.value.find(c => c.id === e.course_id),
                }))
                .filter(e => {
                    if (!e.user || !e.course) return false;
                        if (activeEnrollmentCourse.value && e.course.id !== activeEnrollmentCourse.value.id) return false;
                        if (!matchesCourseClassification(e.course, enrollmentFilter)) return false;
                    if (!matchesDateFilter(e.created_at, enrollmentFilter)) return false;
                    if (enrollmentFilter.status && e.status !== enrollmentFilter.status) return false;
                    if (enrollmentFilter.department && e.user.department !== enrollmentFilter.department) return false;
                    if (enrollmentFilter.company && e.user.department !== enrollmentFilter.company) return false;
                    if (enrollmentFilter.site && e.user.site !== enrollmentFilter.site) return false;
                    if (enrollmentFilter.job_level && e.user.job_level !== enrollmentFilter.job_level) return false;
                    if (enrollmentFilter.search) {
                        const q = enrollmentFilter.search.toLowerCase();
                        const match =
                            e.user.name.toLowerCase().includes(q) ||
                            e.user.nik.toLowerCase().includes(q) ||
                            e.user.department.toLowerCase().includes(q) ||
                            e.course.code.toLowerCase().includes(q) ||
                            e.course.title.toLowerCase().includes(q) ||
                            (e.certificate_number || '').toLowerCase().includes(q);
                        if (!match) return false;
                    }
                    return true;
                });
        });

        const changeEnrollmentStatus = (enr, newStatus) => {
            const target = enrollments.value.find(x => x.id === enr.id);
            if (target) {
                target.status = newStatus;
                notify(`Status pendaftaran ${enr.user.name} diubah menjadi ${newStatus.toUpperCase()}.`);
            }
        };

        const toggleModuleCheck = (enr, modId) => {
            const target = enrollments.value.find(x => x.id === enr.id);
            if (!target || target.status !== 'approved') return;
            target.completed_modules[modId] = !target.completed_modules[modId];
            const courseMods = activeEnrollmentCourse.value.modules;
            const doneCount = courseMods.filter(m => target.completed_modules[m.id]).length;
            target.progress_percentage = Math.round((doneCount / courseMods.length) * 100);
            notify(`Progres modul ${enr.user.name} diperbarui (${target.progress_percentage}%).`);
        };

        // ====================================================================
        // Stateless Rotating QR (15-Second HMAC-SHA256)
        // ====================================================================
        const timeWindow = ref(Math.floor(Date.now() / 15000));
        const rotationCountdown = ref(15 - (Math.floor(Date.now() / 1000) % 15));
        const sessionDurationSeconds = ref(2845);

        const dynamicQrPayload = computed(() => {
            const s = activeSession.value;
            const computedHmac = computeWindowHmac(s.id, s.secret_key, timeWindow.value);
            return {
                payload: computedHmac.payload,
                manual_code: computedHmac.manual_code,
                time_window: timeWindow.value,
            };
        });

        const projectorQrMatrix = computed(() => generateQrMatrix(dynamicQrPayload.value.payload));

        const rotateNow = () => {
            timeWindow.value = Math.floor(Date.now() / 15000);
            rotationCountdown.value = 15;
        };

        let timer = null;
        onMounted(() => {
            timer = setInterval(() => {
                if (sessionDurationSeconds.value > 0) sessionDurationSeconds.value--;
                if (rotationCountdown.value <= 1) {
                    timeWindow.value = Math.floor(Date.now() / 15000);
                    rotationCountdown.value = 15;
                } else {
                    rotationCountdown.value--;
                }
            }, 1000);
        });
        onUnmounted(() => { if (timer) clearInterval(timer); });

        // Scan dari Mobile Peserta
        const mobileScanInput = ref('');
        const submitMobileScan = () => {
            const input = mobileScanInput.value.trim().toUpperCase();
            if (!input) return;

            const s = activeSession.value;
            const curHmac = computeWindowHmac(s.id, s.secret_key, timeWindow.value);
            const prevHmac = computeWindowHmac(s.id, s.secret_key, timeWindow.value - 1);

            const isValid = [
                curHmac.payload.toUpperCase(), curHmac.manual_code,
                prevHmac.payload.toUpperCase(), prevHmac.manual_code
            ].includes(input);

            if (!isValid) {
                notify('Kode QR / PIN 6-Digit tidak valid atau sudah kedaluwarsa (>30 detik)!', 'error');
                return;
            }

            const p = activeParticipant.value;
            const exists = attendanceLogs.value.some(l => l.user_id === p.id && l.session_id === s.id);
            if (!exists) {
                const now = new Date();
                const timeStr = now.toTimeString().split(' ')[0];
                attendanceLogs.value.unshift({
                    id: Date.now(),
                    session_id: s.id,
                    user_id: p.id,
                    name: p.name,
                    nik: p.nik,
                    department: p.department,
                    status: 'present',
                    scanned_at: timeStr,
                });
                s.present_count++;
                notify(`Presensi ${p.name} (${p.nik}) berhasil diverifikasi! Cek daftar hadir di Proyektor Trainer.`);
                // TUGAS 3 - Poin 2: Tampilkan form evaluasi / rating trainer
                showMobileEvalCard.value = true;
            } else {
                notify(`Kehadiran ${p.name} sudah tercatat sebelumnya pada sesi ini (Idempotent Safe).`);
                showMobileEvalCard.value = true;
            }
            mobileScanInput.value = '';
        };

        // Simulasi auto-fill PIN aktif di HP Peserta
        const fillCurrentPin = () => {
            mobileScanInput.value = dynamicQrPayload.value.manual_code;
        };

        // ====================================================================
        // Native SVG Radar Chart Helper (Untuk Profil Peserta & Cetak Rapor A4)
        // ====================================================================
        const buildRadarGeometry = (participantObj) => {
            const size = 320, center = 160, maxRadius = 104, maxLevel = 5;
            const list = skills.value.map(s => ({
                ...s,
                current_level: participantObj.skills_map[s.id]?.current_level || 1,
                target_level: participantObj.skills_map[s.id]?.target_level || 3,
                gap: (participantObj.skills_map[s.id]?.current_level || 1) - (participantObj.skills_map[s.id]?.target_level || 3),
            }));
            const count = list.length;

            const getPt = (idx, lvl, rScale = maxRadius) => {
                const angle = (Math.PI * 2 * idx) / count - Math.PI / 2;
                const r = (lvl / maxLevel) * rScale;
                return {
                    x: Number((center + r * Math.cos(angle)).toFixed(2)),
                    y: Number((center + r * Math.sin(angle)).toFixed(2)),
                };
            };

            const rings = [1, 2, 3, 4, 5].map(lvl => ({
                level: lvl,
                points: list.map((_, i) => { const p = getPt(i, lvl); return `${p.x},${p.y}`; }).join(' '),
                labelY: Number((center - (lvl / maxLevel) * maxRadius).toFixed(2)),
            }));

            const axes = list.map((sk, i) => {
                const out = getPt(i, maxLevel);
                const lbl = getPt(i, maxLevel, maxRadius + 26);
                let anchor = 'middle';
                if (lbl.x < center - 15) anchor = 'end';
                else if (lbl.x > center + 15) anchor = 'start';
                return { skill: sk, x2: out.x, y2: out.y, labelX: lbl.x, labelY: lbl.y, anchor };
            });

            const targetPoly = list.map((sk, i) => { const p = getPt(i, sk.target_level); return `${p.x},${p.y}`; }).join(' ');
            const currentPoly = list.map((sk, i) => { const p = getPt(i, sk.current_level); return `${p.x},${p.y}`; }).join(' ');
            const dots = list.map((sk, i) => ({
                ...sk,
                cur: getPt(i, sk.current_level),
                tar: getPt(i, sk.target_level),
            }));

            const compCount = list.filter(s => s.current_level >= s.target_level).length;
            const avgCur = (list.reduce((a, b) => a + b.current_level, 0) / count).toFixed(1);
            const avgTar = (list.reduce((a, b) => a + b.target_level, 0) / count).toFixed(1);

            return { list, rings, axes, targetPoly, currentPoly, dots, compCount, gapCount: count - compCount, avgCur, avgTar };
        };

        const participantRadar = computed(() => buildRadarGeometry(activeParticipant.value));
        const printRadar = computed(() => buildRadarGeometry(printParticipant.value));
        const printVerifyQr = computed(() => generateQrMatrix(`VERIFY:${printParticipant.value.nik}:CERT2026`));

        // ====================================================================
        // Streamed CSV Export (UTF-8 BOM) di Browser
        // ====================================================================
        const downloadSkillMatrixCsv = () => {
            const BOM = '\uFEFF';
            const headers = ['NIK', 'Nama Peserta', 'Departemen'];
            skills.value.forEach(s => {
                headers.push(`[${s.code}] Target`, `[${s.code}] Current`, `[${s.code}] Gap`);
            });
            headers.push('Status Kelulusan');

            const rows = [headers.join(',')];
            filteredMatrixParticipants.value.forEach(p => {
                const row = [p.nik, `"${p.name}"`, `"${p.department}"`];
                let gaps = 0;
                skills.value.forEach(s => {
                    const c = p.skills_map[s.id];
                    if (c.gap < 0) gaps++;
                    row.push(c.target_level, c.current_level, c.gap > 0 ? `+${c.gap}` : c.gap);
                });
                row.push(gaps === 0 ? '"LULUS & KOMPETEN"' : `"BELUM KOMPETEN (${gaps} SKILL GAP)"`);
                rows.push(row.join(','));
            });

            const blob = new Blob([BOM + rows.join('\r\n')], { type: 'text/csv;charset=utf-8;' });
            const url = URL.createObjectURL(blob);
            const a = document.createElement('a');
            a.href = url;
            a.download = `LND_Skill_Matrix_${new Date().toISOString().slice(0,10)}.csv`;
            a.click();
            URL.revokeObjectURL(url);
            notify('File CSV Skill Matrix (dengan UTF-8 BOM untuk Excel) berhasil di-download!');
        };

        const openPrintReport = (participantId) => {
            printParticipantId.value = participantId;
            currentView.value = 'print-report';
        };

        // ====================================================================
        // Enterprise Upgrade State (Multi-Tenant Dept/Contractor, TNA, & Trainer Hours)
        // ====================================================================
        const activeRoleSim = ref('lnd'); // 'lnd' | 'trainer' | 'dept_admin' | 'contractor_admin'
        const orgPortalTab = ref('collective'); // 'collective' | 'tna' | 'certificates'
        const bulkSelectedWorkerIds = ref([1, 2, 3]);
        const tnaRequests = ref([
            {
                id: 1,
                created_at: '25 Okt 2026 09:30',
                organization_name: 'PT Maju Jaya Kontraktor (VND-PTMJU)',
                request_type: 'renewal_refreshment',
                course_title: 'Sertifikasi Keselamatan Kerja Tambang & HIRA (POP)',
                requester_name: 'Antonius Wijaya (Admin Kontraktor)',
                target_participants_count: 3,
                reason_notes: 'Perpanjangan lisensi K3 POP 3 pekerja kontraktor yang akan expired dalam < 45 hari.',
                status: 'pending_lnd',
            },
            {
                id: 2,
                created_at: '24 Okt 2026 14:15',
                organization_name: 'Dept. Mining Operations (DEPT-OPS)',
                request_type: 'new_tna',
                course_title: 'Optimalisasi Fleet Operations & Preventive Maintenance',
                requester_name: 'Rudi Hartono (Admin Dept)',
                target_participants_count: 5,
                reason_notes: 'TNA Q4 peningkatan kompetensi operator unit baru.',
                status: 'approved',
            },
        ]);

        const scopedOrgWorkers = computed(() => {
            if (activeRoleSim.value === 'contractor_admin') {
                return participants.value.filter(p => p.org_type === 'contractor');
            }
            if (activeRoleSim.value === 'dept_admin') {
                return participants.value.filter(p => p.department === 'Mining');
            }
            return participants.value;
        });

        const submitSimBulkEnroll = () => {
            notify(`Berhasil mendaftarkan ${bulkSelectedWorkerIds.value.length} pekerja secara kolektif (Data Scoped: ${activeRoleSim.value.toUpperCase()})!`);
        };

        // Radar Masa Berlaku Sertifikat (ExpiringCertificatesAlert.vue State)
        const renewalFilter = ref('all');
        const selectedRenewalItems = ref([]);
        const expiringCertificatesList = ref([
            {
                enrollment_id: 501,
                user_id: 18,
                user_name: 'Rendy Septian',
                user_nik: 'PANI-0118',
                organization_name: 'PT Maju Jaya Kontraktor',
                organization_type: 'contractor',
                course_id: 1,
                course_code: 'CRS-2025-001',
                course_title: 'Sertifikasi Keselamatan Kerja Tambang & HIRA (POP)',
                certificate_number: 'CERT/PANI-LND/2024/0501',
                expires_at: '10 Okt 2026',
                days_left: -15,
                severity: 'expired',
                is_requested: false,
            },
            {
                enrollment_id: 502,
                user_id: 19,
                user_name: 'Surya Dinata',
                user_nik: 'PANI-0119',
                organization_name: 'PT Maju Jaya Kontraktor',
                organization_type: 'contractor',
                course_id: 1,
                course_code: 'CRS-2025-001',
                course_title: 'Sertifikasi Keselamatan Kerja Tambang & HIRA (POP)',
                certificate_number: 'CERT/PANI-LND/2024/0502',
                expires_at: '12 Nov 2026',
                days_left: 18,
                severity: 'critical',
                is_requested: false,
            },
            {
                enrollment_id: 503,
                user_id: 1,
                user_name: 'Adi Pratama',
                user_nik: 'PANI-0101',
                organization_name: 'Dept. Mining Operations',
                organization_type: 'internal_dept',
                course_id: 2,
                course_code: 'CRS-2025-002',
                course_title: 'Optimalisasi Fleet Operations & Preventive Maintenance',
                certificate_number: 'CERT/PANI-LND/2024/0503',
                expires_at: '15 Des 2026',
                days_left: 51,
                severity: 'warning',
                is_requested: true,
            },
        ]);

        const renewalSummary = computed(() => ({
            expired_count: expiringCertificatesList.value.filter(i => i.severity === 'expired').length,
            critical_count: expiringCertificatesList.value.filter(i => i.severity === 'critical').length,
            warning_count: expiringCertificatesList.value.filter(i => i.severity === 'warning').length,
        }));

        const filteredRenewalList = computed(() => {
            if (renewalFilter.value === 'all') return expiringCertificatesList.value;
            return expiringCertificatesList.value.filter(i => i.severity === renewalFilter.value);
        });

        const selectedRenewalGroups = computed(() => {
            const groups = {};
            selectedRenewalItems.value.forEach(item => {
                if (!groups[item.course_id]) {
                    groups[item.course_id] = { course_id: item.course_id, course_title: item.course_title, count: 0 };
                }
                groups[item.course_id].count++;
            });
            return Object.values(groups);
        });

        const submitSingleSimRenewal = (item) => {
            item.is_requested = true;
            selectedRenewalItems.value = selectedRenewalItems.value.filter(i => i.enrollment_id !== item.enrollment_id);
            tnaRequests.value.unshift({
                id: Date.now(),
                created_at: 'Baru saja',
                organization_name: item.organization_name,
                request_type: 'renewal_refreshment',
                course_title: item.course_title,
                requester_name: activeRoleSim.value.toUpperCase(),
                target_participants_count: 1,
                reason_notes: `Pembaruan sertifikat ${item.certificate_number} (${item.user_name})`,
                status: 'pending_lnd',
            });
            notify(`1 pekerja (${item.user_name}) berhasil diajukan ke Tim LnD untuk Training Pembaruan.`);
        };

        const submitBatchSimRenewal = (courseId) => {
            const itemsForCourse = selectedRenewalItems.value.filter(i => i.course_id === courseId);
            if (!itemsForCourse.length) return;
            itemsForCourse.forEach(i => { i.is_requested = true; });
            selectedRenewalItems.value = selectedRenewalItems.value.filter(i => i.course_id !== courseId);
            tnaRequests.value.unshift({
                id: Date.now(),
                created_at: 'Baru saja',
                organization_name: itemsForCourse[0].organization_name,
                request_type: 'renewal_refreshment',
                course_title: itemsForCourse[0].course_title,
                requester_name: activeRoleSim.value.toUpperCase(),
                target_participants_count: itemsForCourse.length,
                reason_notes: `Pengajuan kolektif pembaruan sertifikat untuk ${itemsForCourse.length} personel.`,
                status: 'pending_lnd',
            });
            notify(`${itemsForCourse.length} pekerja berhasil diajukan ke Tim LnD untuk Training Pembaruan.`);
        };

        const submitSimTnaRefreshment = () => {
            tnaRequests.value.unshift({
                id: Date.now(),
                created_at: 'Baru saja',
                organization_name: activeRoleSim.value === 'contractor_admin' ? 'PT Maju Jaya Kontraktor (VND-PTMJU)' : 'Dept. Mining Operations (DEPT-OPS)',
                request_type: 'renewal_refreshment',
                course_title: 'Sertifikasi Keselamatan Kerja Tambang & HIRA (POP)',
                requester_name: activeRoleSim.value === 'contractor_admin' ? 'Antonius Wijaya' : 'Rudi Hartono',
                target_participants_count: 3,
                reason_notes: 'Pengajuan Refreshment kolektif otomatis untuk pekerja yang sertifikatnya akan expired (< 60 hari).',
                status: 'pending_lnd',
            });
            orgPortalTab.value = 'tna';
            notify('Pengajuan TNA / Refreshment Sertifikat berhasil dikirim ke Tim LnD!');
        };

        // ====================================================================
        // BAGIAN 2 State: Manpower CRUD, Batch Enroll, Historical Migration (Mode A/B), & Self-Report
        // ====================================================================
        const manpowerTab = ref('manpower'); // 'manpower' | 'batch_enroll' | 'historical' | 'self_reports'
        const manpowerGroupFilter = ref(''); // '' | 'internal_dept' | 'contractor'
        const manpowerFormSim = reactive({
            nik: '',
            name: '',
            email: '',
            organization_type: 'internal_dept',
            department: 'Mining Operations',
        });
        const migrationModeSim = ref('single_course_multi_worker'); // 'single_worker_multi_cert' | 'single_course_multi_worker'
        const modeAWorkerIdSim = ref(1);
        const modeACertsSim = ref([
            { course_id: 1, certificate_number: 'HIST/PANI-LND/2024/001', issued_at: '2024-06-15', expires_at: '2026-06-15' },
        ]);
        const modeBCourseIdSim = ref(1);
        const modeBIssuedAtSim = ref('2024-05-10');
        const modeBExpiresAtSim = ref('2026-05-10');
        const modeBSelectedWorkerIdsSim = ref([1, 2, 3]);

        const selfReportsList = ref([
            {
                id: 901,
                user_name: 'Adi Pratama',
                user_nik: 'PANI-0101',
                organization_name: 'Dept. Mining Operations',
                course_name: 'Sertifikasi Ahli K3 Umum BNSP',
                organizer: 'Kemnaker RI / BNSP',
                certificate_number: 'SER-BNSP-2026-8821',
                issued_at: '10 Jan 2026',
                expires_at: '10 Jan 2029',
                status: 'pending',
                review_notes: '',
            },
            {
                id: 902,
                user_name: 'Rendy Septian',
                user_nik: 'PANI-0118',
                organization_name: 'PT Maju Jaya Kontraktor',
                course_name: 'Basic First Aid & Fire Rescue',
                organizer: 'PMI & Basarnas',
                certificate_number: 'FA-RES-2025-1104',
                issued_at: '14 Agu 2025',
                expires_at: '14 Agu 2027',
                status: 'approved',
                review_notes: 'Sertifikat asli terverifikasi & masuk portofolio resmi.',
            },
        ]);

        const mobileSelfReportForm = reactive({
            course_name: '',
            organizer: '',
            certificate_number: '',
            issued_at: '2026-02-01',
            expires_at: '2028-02-01',
        });

        const addSimManpower = () => {
            if (!manpowerFormSim.nik || !manpowerFormSim.name) return;
            const newId = participants.value.length + 1;
            const defaultSkills = {};
            skills.value.forEach(s => { defaultSkills[s.id] = { current_level: 2, target_level: 3, gap: -1 }; });
            participants.value.unshift({
                id: newId,
                nik: manpowerFormSim.nik.toUpperCase(),
                name: manpowerFormSim.name,
                department: manpowerFormSim.department,
                organization_type: manpowerFormSim.organization_type,
                skills_map: defaultSkills,
            });
            notify(`Manpower baru ${manpowerFormSim.name} (${manpowerFormSim.nik.toUpperCase()}) berhasil disimpan!`);
            manpowerFormSim.nik = '';
            manpowerFormSim.name = '';
            manpowerFormSim.email = '';
        };

        const simulateCsvImport = () => {
            notify('Batch Import CSV selesai:Data pekerja Internal & Kontraktor berhasil divalidasi (NIK unik) dan di-import!');
        };

        const submitModeASim = () => {
            const w = participants.value.find(p => p.id === modeAWorkerIdSim.value);
            notify(`Berhasil memigrasikan ${modeACertsSim.value.length} sertifikat masa lalu untuk ${w ? w.name : 'Pekerja'} (Mode A)!`);
        };

        const submitModeBSim = () => {
            notify(`Berhasil memigrasikan massal ${modeBSelectedWorkerIdsSim.value.length} pekerja ke riwayat pelatihan resmi (Mode B)!`);
        };

        const reviewSimSelfReport = (rep, newStatus) => {
            rep.status = newStatus;
            rep.review_notes = newStatus === 'approved'
                ? 'Diverifikasi oleh Tim LnD & disinkronkan ke riwayat resmi.'
                : 'Dokumen kurang jelas, mohon unggah ulang.';
            notify(`Self-Report Sertifikat [${rep.certificate_number}] telah di-${newStatus.toUpperCase()}!`);
        };

        const submitMobileSelfReportSim = () => {
            if (!mobileSelfReportForm.course_name || !mobileSelfReportForm.certificate_number) return;
            selfReportsList.value.unshift({
                id: Date.now(),
                user_name: activeParticipant.value.name,
                user_nik: activeParticipant.value.nik,
                organization_name: activeParticipant.value.department,
                course_name: mobileSelfReportForm.course_name,
                organizer: mobileSelfReportForm.organizer || 'Lembaga Eksternal',
                certificate_number: mobileSelfReportForm.certificate_number.toUpperCase(),
                issued_at: mobileSelfReportForm.issued_at,
                expires_at: mobileSelfReportForm.expires_at || 'Seumur Hidup',
                status: 'pending',
                review_notes: '',
            });
            mobileSelfReportForm.course_name = '';
            mobileSelfReportForm.organizer = '';
            mobileSelfReportForm.certificate_number = '';
            notify('Sertifikat mandiri berhasil diunggah (Status: PENDING verifikasi Tim LnD)!');
        };

        // ====================================================================
        // TUGAS 1, 2 & 3 State: 5-Group Accordion Sidebar, Level x Position & Training Today
        // ====================================================================
        const openSidebarGroups = reactive({
            dashboard: true,
            training: true,
            competency: true,
            master_data: true,
            training_today: true,
        });

        const jobPositionsList = ref([
            {
                id: 1,
                code: 'OPR-MIN',
                level_name: 'Operator',
                position_title: 'Heavy Equipment & Hauling Production',
                organization_type: 'both',
                workers_count: 9,
                standards: { 1: 4, 2: 3, 3: 4, 4: 3, 5: 2, 6: 2 },
            },
            {
                id: 2,
                code: 'TCH-MNT',
                level_name: 'Technician',
                position_title: 'Hydraulic & Heavy Plant Maintenance',
                organization_type: 'both',
                workers_count: 8,
                standards: { 1: 4, 2: 3, 3: 2, 4: 2, 5: 5, 6: 3 },
            },
            {
                id: 3,
                code: 'SUP-HSE',
                level_name: 'Supervisor',
                position_title: 'HSE & Mine Safety Compliance (POP)',
                organization_type: 'both',
                workers_count: 8,
                standards: { 1: 5, 2: 5, 3: 3, 4: 3, 5: 3, 6: 4 },
            },
        ]);

        const selectedJobPosId = ref(1);
        const posSettingTab = ref('standards'); // 'standards' | 'positions'
        const trainingTodayTab = ref('today'); // 'today' | 'barcode_sheet' | 'pre_post_test' | 'calendar'
        const trainingSummaryTab = ref('training_type');
        const trainingTypeSource = ref('all');
        const trainingSummarySearch = ref('');
        const individualTrainingFilter = ref('');
        const filteredIndividualTrainingRows = computed(() => {
            const query = individualTrainingFilter.value.trim().toLowerCase();
            if (!query) return individualTrainingRows.value;
            return individualTrainingRows.value.filter((training) =>
                [training.code, training.title, training.category, training.requirement, training.completion]
                    .some((value) => String(value || '').toLowerCase().includes(query))
            );
        });
        const filteredTrainingTypeSummaryRows = computed(() => {
            const query = trainingSummarySearch.value.trim().toLowerCase();
            const source = trainingTypeSource.value === 'internal'
                ? 'internal'
                : trainingTypeSource.value === 'external'
                    ? 'external'
                    : null;
            return trainingTypeSummaryRows.value.filter((training) => {
                if (source && training.executor !== source) return false;
                if (!query) return true;
                return [training.code, training.title, training.category]
                    .some((value) => String(value || '').toLowerCase().includes(query));
            });
        });
        const previewQuizQuestions = [
            { id: 1, question: 'Apa langkah pertama sebelum memulai pekerjaan berisiko tinggi?', options: { A: 'Memulai pekerjaan secepatnya', B: 'Melakukan identifikasi bahaya dan penilaian risiko', C: 'Menunggu instruksi setelah bekerja', D: 'Mengandalkan pengalaman saja' }, answer: 'B' },
            { id: 2, question: 'Apa fungsi utama JSEA/HIRA dalam pekerjaan?', options: { A: 'Mencatat kehadiran', B: 'Menentukan target produksi', C: 'Mengidentifikasi bahaya dan pengendaliannya', D: 'Menggantikan izin kerja' }, answer: 'C' },
            { id: 3, question: 'Kapan pekerja harus menghentikan pekerjaan?', options: { A: 'Saat kondisi tidak aman atau pengendalian tidak tersedia', B: 'Hanya saat jam istirahat', C: 'Setelah pekerjaan selesai', D: 'Jika target sudah tercapai' }, answer: 'A' },
            { id: 4, question: 'Apa tindakan yang tepat saat terjadi keadaan darurat?', options: { A: 'Mendekati sumber bahaya tanpa koordinasi', B: 'Mengikuti prosedur tanggap darurat dan melapor', C: 'Meninggalkan area tanpa memberi tahu siapa pun', D: 'Menunggu orang lain bertindak' }, answer: 'B' },
            { id: 5, question: 'Mengapa inspeksi APD perlu dilakukan sebelum digunakan?', options: { A: 'Agar APD terlihat baru', B: 'Untuk memastikan APD layak dan berfungsi', C: 'Untuk menghindari briefing', D: 'Agar pekerjaan lebih cepat' }, answer: 'B' },
        ];
        const previewQuizStarted = ref(false);
        const previewQuizAnswers = reactive({});
        const previewQuizSeconds = ref(600);
        const previewQuizResult = ref(null);
        const previewQuizPreScore = 40;
        const previewQuizFormattedTime = computed(() => {
            const minutes = Math.floor(previewQuizSeconds.value / 60);
            const seconds = previewQuizSeconds.value % 60;
            return `${String(minutes).padStart(2, '0')}:${String(seconds).padStart(2, '0')}`;
        });
        let previewQuizTimer = null;
        const submitPreviewQuiz = () => {
            if (!previewQuizStarted.value || previewQuizResult.value) return;
            if (previewQuizTimer) {
                clearInterval(previewQuizTimer);
                previewQuizTimer = null;
            }
            const correctCount = previewQuizQuestions.filter((question) => previewQuizAnswers[question.id] === question.answer).length;
            const score = Math.round((correctCount / previewQuizQuestions.length) * 100);
            const normalizedGain = previewQuizPreScore >= 100
                ? 0
                : (score - previewQuizPreScore) / (100 - previewQuizPreScore);
            previewQuizResult.value = {
                correctCount,
                score,
                normalizedGain,
                preScore: previewQuizPreScore,
            };
            previewQuizStarted.value = false;
        };
        const startPreviewQuiz = () => {
            if (previewQuizTimer) clearInterval(previewQuizTimer);
            Object.keys(previewQuizAnswers).forEach((key) => delete previewQuizAnswers[key]);
            previewQuizResult.value = null;
            previewQuizSeconds.value = 600;
            previewQuizStarted.value = true;
            previewQuizTimer = setInterval(() => {
                if (previewQuizSeconds.value > 0) {
                    previewQuizSeconds.value--;
                } else {
                    submitPreviewQuiz();
                }
            }, 1000);
        };
        onUnmounted(() => {
            if (previewQuizTimer) clearInterval(previewQuizTimer);
        });

        // ====================================================================
        // Interactive Training Calendar (ATMP / Bulanan / Mingguan) + Live Center
        // Sinkron dengan Pages/Training/TrainingCalendar.vue
        // ====================================================================
        const calMonths = ['Januari', 'Februari', 'Maret', 'April', 'Mei', 'Juni', 'Juli', 'Agustus', 'September', 'Oktober', 'November', 'Desember'];
        const calWeekdaysShort = ['Sen', 'Sel', 'Rab', 'Kam', 'Jum', 'Sab', 'Min'];
        const calWeekdaysLong = ['Senin', 'Selasa', 'Rabu', 'Kamis', 'Jumat', 'Sabtu', 'Minggu'];
        const calPad = (n) => String(n).padStart(2, '0');
        const calToIso = (d) => d.getFullYear() + '-' + calPad(d.getMonth() + 1) + '-' + calPad(d.getDate());
        const calParse = (s) => { const p = s.split('-').map(Number); return new Date(p[0], p[1] - 1, p[2]); };
        const calAddDays = (d, n) => new Date(d.getFullYear(), d.getMonth(), d.getDate() + n);
        const calTodayIso = calToIso(new Date());

        const calView = ref('monthly'); // 'atmp' | 'monthly' | 'weekly'
        const calAnchor = ref(calTodayIso);
        const calFilter = reactive({ training_category: '', mandatory_type: '', training_source: '', plan_status: '' });
        const calSelectedId = ref(null);
        const calAddOpen = ref(false);
        const calForm = reactive({ course_id: '', title: '', date: '', start_time: '', end_time: '', location: '', quota: '', plan_status: 'approved' });
        let calPlanSeq = 100;

        // Rencana jadwal (ATMP) di luar sesi presensi: Approved & Pending
        const calPlanned = ref([
            { id: 'p1', course_id: 1, title: 'Batch 3 - Refreshment SMKP', date: '2026-01-19', start_time: '08:00', end_time: '15:00', location: 'Ruang Training Utama', quota: 30, plan_status: 'approved' },
            { id: 'p2', course_id: 2, title: 'Batch Q1 - Fleet Ops', date: '2026-03-10', start_time: '08:00', end_time: '16:00', location: 'Workshop Hauling', quota: 24, plan_status: 'approved' },
            { id: 'p3', course_id: 3, title: 'Batch Q2 - POP Minerba', date: '2026-05-12', start_time: '08:00', end_time: '17:00', location: 'LSP Minerba (External)', quota: 20, plan_status: 'approved' },
            { id: 'p4', course_id: 1, title: 'Batch 4 - K3 Operator Baru', date: '2026-10-28', start_time: '08:00', end_time: '15:00', location: 'Ruang Training Utama', quota: 30, plan_status: 'approved' },
            { id: 'p5', course_id: 2, title: 'Batch 3 - Defensive Driving', date: '2026-10-29', start_time: '09:00', end_time: '14:00', location: 'Workshop Hauling', quota: null, plan_status: 'pending' },
            { id: 'p6', course_id: 4, title: 'Batch Q4 - Hidrolik Lanjutan', date: '2026-11-17', start_time: '08:00', end_time: '16:00', location: 'Maintenance Bay', quota: 16, plan_status: 'pending' },
            { id: 'p7', course_id: 3, title: 'Batch Q4 - Recert POP', date: '2026-12-08', start_time: '08:00', end_time: '17:00', location: 'LSP Minerba (External)', quota: 20, plan_status: 'pending' },
        ]);

        const calEvents = computed(() => {
            const build = (base) => {
                const c = courses.value.find(x => x.id === base.course_id) || {};
                const status = base.is_active ? 'live' : (base.date < calTodayIso ? 'done' : (base.date === calTodayIso ? 'today' : 'scheduled'));
                return {
                    ...base,
                    course_code: c.code,
                    course_title: c.title,
                    training_category: c.training_category,
                    is_mandatory: !!c.is_mandatory,
                    training_source: c.training_source,
                    trainer_name: c.trainer_name,
                    enrolled_count: enrollments.value.filter(e => e.course_id === base.course_id && e.status === 'approved').length,
                    status,
                };
            };
            const fromSessions = sessions.value.map(s => build({
                id: 's' + s.id, session_id: s.id, course_id: s.course_id, title: s.title, date: s.session_date,
                start_time: '08:00', end_time: '12:00', location: 'Ruang Training Utama', quota: null,
                plan_status: 'approved', is_active: s.is_active, present_count: s.present_count,
            }));
            const fromPlans = calPlanned.value.map(p => build({ ...p, session_id: null, is_active: false, present_count: 0 }));
            return [...fromSessions, ...fromPlans]
                .filter(e => !calFilter.training_category || e.training_category === calFilter.training_category)
                .filter(e => !calFilter.mandatory_type || (calFilter.mandatory_type === 'mandatory' ? e.is_mandatory : !e.is_mandatory))
                .filter(e => !calFilter.training_source || e.training_source === calFilter.training_source)
                .filter(e => !calFilter.plan_status || e.plan_status === calFilter.plan_status)
                .sort((a, b) => a.date.localeCompare(b.date) || (a.start_time || '').localeCompare(b.start_time || ''));
        });

        const calLiveSessions = computed(() => calEvents.value.filter(e => e.status === 'live'));
        const calCanManage = computed(() => activeRoleSim.value === 'lnd');
        const calCanProjector = computed(() => ['lnd', 'trainer'].includes(activeRoleSim.value));

        const calRange = computed(() => {
            const a = calParse(calAnchor.value);
            if (calView.value === 'atmp') return [new Date(a.getFullYear(), 0, 1), new Date(a.getFullYear(), 11, 31)];
            if (calView.value === 'weekly') {
                const s = calAddDays(a, -((a.getDay() + 6) % 7));
                return [s, calAddDays(s, 6)];
            }
            const f = new Date(a.getFullYear(), a.getMonth(), 1);
            const l = new Date(a.getFullYear(), a.getMonth() + 1, 0);
            return [calAddDays(f, -((f.getDay() + 6) % 7)), calAddDays(l, 6 - ((l.getDay() + 6) % 7))];
        });

        const calPeriodLabel = computed(() => {
            const a = calParse(calAnchor.value);
            if (calView.value === 'atmp') return 'Tahun ' + a.getFullYear();
            if (calView.value === 'weekly') {
                const r = calRange.value;
                return r[0].getDate() + ' ' + calMonths[r[0].getMonth()].slice(0, 3) + ' - ' + r[1].getDate() + ' ' + calMonths[r[1].getMonth()].slice(0, 3) + ' ' + r[1].getFullYear();
            }
            return calMonths[a.getMonth()] + ' ' + a.getFullYear();
        });

        const calEventsByDate = computed(() => {
            const map = {};
            calEvents.value.forEach(e => { (map[e.date] = map[e.date] || []).push(e); });
            return map;
        });

        const calMonthCells = computed(() => {
            const a = calParse(calAnchor.value);
            const cells = [];
            for (let d = calRange.value[0]; d <= calRange.value[1]; d = calAddDays(d, 1)) {
                const iso = calToIso(d);
                cells.push({ iso, day: d.getDate(), inMonth: d.getMonth() === a.getMonth(), isToday: iso === calTodayIso, events: calEventsByDate.value[iso] || [] });
            }
            return cells;
        });

        const calWeekDays = computed(() => Array.from({ length: 7 }, (_, i) => {
            const d = calAddDays(calRange.value[0], i);
            const iso = calToIso(d);
            return { iso, label: calWeekdaysLong[i] + ', ' + d.getDate() + ' ' + calMonths[d.getMonth()].slice(0, 3), isToday: iso === calTodayIso, events: calEventsByDate.value[iso] || [] };
        }));

        const calAtmpMonths = computed(() => {
            const year = calParse(calAnchor.value).getFullYear();
            return calMonths.map((label, i) => {
                const prefix = year + '-' + calPad(i + 1);
                const list = calEvents.value.filter(e => e.date.startsWith(prefix));
                return { idx: i, label, firstDay: prefix + '-01', events: list, pending: list.filter(e => e.plan_status === 'pending').length };
            });
        });

        const calSummary = computed(() => {
            const a = calToIso(calRange.value[0]);
            const b = calToIso(calRange.value[1]);
            const list = calEvents.value.filter(e => e.date >= a && e.date <= b);
            return { total: list.length, approved: list.filter(e => e.plan_status === 'approved').length, pending: list.filter(e => e.plan_status === 'pending').length };
        });

        const calSelected = computed(() => calEvents.value.find(e => e.id === calSelectedId.value) || null);

        const calNavigate = (view, iso) => { calView.value = view; calAnchor.value = iso; };
        const calShift = (dir) => {
            const a = calParse(calAnchor.value);
            if (calView.value === 'atmp') calAnchor.value = calToIso(new Date(a.getFullYear() + dir, 0, 1));
            else if (calView.value === 'weekly') calAnchor.value = calToIso(calAddDays(a, 7 * dir));
            else calAnchor.value = calToIso(new Date(a.getFullYear(), a.getMonth() + dir, 1));
        };
        const calResetFilters = () => { Object.keys(calFilter).forEach(k => { calFilter[k] = ''; }); };

        const calChipClass = (e) => {
            if (e.status === 'live') return 'bg-emerald-600 text-white border-emerald-700';
            if (e.status === 'done') return 'bg-slate-100 text-slate-500 border-slate-200';
            if (e.plan_status === 'pending') return 'bg-amber-50 text-amber-900 border-amber-300 border-dashed';
            return 'bg-slate-800 text-white border-slate-900';
        };
        const calStatusBadge = (e) => {
            if (e.status === 'live') return { label: 'LIVE', cls: 'bg-emerald-50 text-emerald-800 border-emerald-200' };
            if (e.status === 'today') return { label: 'HARI INI', cls: 'bg-sky-50 text-sky-800 border-sky-200' };
            if (e.status === 'done') return { label: 'SELESAI', cls: 'bg-slate-100 text-slate-600 border-slate-200' };
            return { label: 'TERJADWAL', cls: 'bg-slate-50 text-slate-700 border-slate-200' };
        };
        const calPlanBadge = (e) => e.plan_status === 'pending'
            ? { label: 'PENDING', cls: 'bg-amber-50 text-amber-800 border-amber-300' }
            : { label: 'APPROVED', cls: 'bg-emerald-50 text-emerald-800 border-emerald-200' };
        const calTimeRange = (e) => (e.start_time && e.end_time ? e.start_time + ' - ' + e.end_time : 'Jam belum ditentukan');
        const calQuotaText = (e) => (e.quota ? e.enrolled_count + ' / ' + e.quota + ' peserta' : e.enrolled_count + ' peserta terdaftar (tanpa batas kuota)');
        const calQuotaPct = (e) => (e.quota ? Math.min(100, Math.round((e.enrolled_count / e.quota) * 100)) : 0);
        const calFmtLong = (iso) => { const d = calParse(iso); return calWeekdaysLong[(d.getDay() + 6) % 7] + ', ' + d.getDate() + ' ' + calMonths[d.getMonth()] + ' ' + d.getFullYear(); };

        const calOpenAdd = (iso) => {
            if (!calCanManage.value) return;
            Object.assign(calForm, { course_id: '', title: '', date: iso, start_time: '', end_time: '', location: '', quota: '', plan_status: 'approved' });
            calAddOpen.value = true;
        };
        const calSubmitAdd = () => {
            if (!calForm.course_id || !calForm.title || !calForm.date) { notify('Course, judul sesi, dan tanggal wajib diisi.', 'error'); return; }
            if (calForm.start_time && calForm.end_time && calForm.end_time <= calForm.start_time) { notify('Jam selesai harus lebih besar dari jam mulai.', 'error'); return; }
            calPlanSeq++;
            calPlanned.value.push({
                id: 'p' + calPlanSeq, course_id: Number(calForm.course_id), title: calForm.title, date: calForm.date,
                start_time: calForm.start_time || null, end_time: calForm.end_time || null, location: calForm.location || null,
                quota: calForm.quota ? Number(calForm.quota) : null, plan_status: calForm.plan_status,
            });
            calAddOpen.value = false;
            notify('Jadwal "' + calForm.title + '" berhasil ditambahkan ke kalender.');
        };
        const calApprove = (e) => {
            const target = calPlanned.value.find(p => p.id === e.id);
            if (target) { target.plan_status = 'approved'; notify('Jadwal disetujui (Approved).'); }
        };
        const calOpenProjector = (e) => {
            if (!e.session_id) return;
            activeSessionId.value = e.session_id;
            calSelectedId.value = null;
            currentView.value = 'admin-projector';
        };
        const newPosFormSim = reactive({
            code: '',
            level_name: 'Supervisor',
            position_title: '',
            organization_type: 'both',
        });

        const activeJobPositionSim = computed(() => {
            return jobPositionsList.value.find(p => p.id === Number(selectedJobPosId.value)) || jobPositionsList.value[0];
        });

        const syncStandardsToPositionWorkersSim = () => {
            const pos = activeJobPositionSim.value;
            if (!pos) return;
            participants.value.forEach((worker, idx) => {
                const posGroup = idx < 9 ? 1 : (idx < 17 ? 2 : 3);
                if (posGroup === pos.id || pos.id > 3) {
                    Object.keys(pos.standards).forEach(skId => {
                        const targetLvl = pos.standards[skId];
                        if (worker.skills_map[skId]) {
                            worker.skills_map[skId].target_level = targetLvl;
                            worker.skills_map[skId].gap = worker.skills_map[skId].current_level - targetLvl;
                        }
                    });
                }
            });
            notify(`Sinkronisasi selesai: Target Level kompetensi pada ${pos.workers_count} pekerja di posisi [${pos.code}] ${pos.level_name} - ${pos.position_title} berhasil diperbarui!`);
        };

        const addNewJobPositionSim = () => {
            if (!newPosFormSim.code || !newPosFormSim.position_title) return;
            const newId = jobPositionsList.value.length + 1;
            jobPositionsList.value.push({
                id: newId,
                code: newPosFormSim.code.toUpperCase(),
                level_name: newPosFormSim.level_name,
                position_title: newPosFormSim.position_title,
                organization_type: newPosFormSim.organization_type,
                workers_count: 4,
                standards: { 1: 4, 2: 4, 3: 3, 4: 3, 5: 3, 6: 4 },
            });
            selectedJobPosId.value = newId;
            posSettingTab.value = 'standards';
            notify(`Master Level x Position [${newPosFormSim.code.toUpperCase()}] berhasil ditambahkan!`);
            newPosFormSim.code = '';
            newPosFormSim.position_title = '';
        };

        // ====================================================================
        // Master Data Kompetensi (Competency List Simulation)
        // ====================================================================
        const competencyFilter = reactive({
            search: '',
            competency_type: '',
            category: '',
        });

        const competencyKpis = computed(() => {
            return {
                total: skills.value.length,
                external_mandatory: skills.value.filter(s => s.competency_type === 'EXTERNAL_MANDATORY').length,
                internal_mandatory: skills.value.filter(s => s.competency_type === 'INTERNAL_MANDATORY').length,
                non_mandatory: skills.value.filter(s => s.competency_type === 'NON_MANDATORY').length,
            };
        });

        const enrichedCompetencies = computed(() => {
            return skills.value.map(s => {
                const positionsCount = jobPositionsList.value.filter(pos => pos.standards && pos.standards[s.id] !== undefined).length;
                const linkedCourses = courses.value.filter(c => c.training_category === s.category || c.title.toLowerCase().includes(s.name.toLowerCase()));
                
                let competentCount = 0;
                let gapCount = 0;
                participants.value.forEach(p => {
                    const cell = p.skills_map && p.skills_map[s.id];
                    if (cell) {
                        if (cell.current_level >= cell.target_level && cell.status !== 'expired') {
                            competentCount++;
                        } else {
                            gapCount++;
                        }
                    }
                });

                return {
                    ...s,
                    positions_count: positionsCount || 1,
                    courses_count: linkedCourses.length || 1,
                    linked_courses: linkedCourses,
                    total_workers_count: participants.value.length,
                    competent_workers_count: competentCount,
                    gap_workers_count: gapCount,
                };
            }).filter(s => {
                if (competencyFilter.search) {
                    const q = competencyFilter.search.toLowerCase();
                    const match = s.code.toLowerCase().includes(q) || s.name.toLowerCase().includes(q) || (s.description || '').toLowerCase().includes(q);
                    if (!match) return false;
                }
                if (competencyFilter.competency_type && s.competency_type !== competencyFilter.competency_type) return false;
                if (competencyFilter.category && s.category !== competencyFilter.category) return false;
                return true;
            });
        });

        const competencyModalSim = reactive({
            open: false,
            isEdit: false,
            id: null,
            code: '',
            name: '',
            category: 'Safety',
            competency_type: 'INTERNAL_MANDATORY',
            description: '',
        });

        const openCreateCompetencyModal = () => {
            competencyModalSim.isEdit = false;
            competencyModalSim.id = null;
            competencyModalSim.code = '';
            competencyModalSim.name = '';
            competencyModalSim.category = 'Safety';
            competencyModalSim.competency_type = 'INTERNAL_MANDATORY';
            competencyModalSim.description = '';
            competencyModalSim.open = true;
        };

        const openEditCompetencyModal = (c) => {
            competencyModalSim.isEdit = true;
            competencyModalSim.id = c.id;
            competencyModalSim.code = c.code;
            competencyModalSim.name = c.name;
            competencyModalSim.category = c.category;
            competencyModalSim.competency_type = c.competency_type || 'INTERNAL_MANDATORY';
