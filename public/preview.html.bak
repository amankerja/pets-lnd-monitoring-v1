                    <div class="rounded-xl border border-slate-200/80 bg-slate-50/70 overflow-hidden shadow-sm">
                        <button @click="openSidebarGroups.dashboard = !openSidebarGroups.dashboard" class="w-full px-3 py-2.5 flex items-center justify-between text-left hover:bg-slate-100/90 transition-colors group">
