                        <div v-show="openSidebarGroups.dashboard || isSidebarCollapsed" class="px-2 pb-2 pt-0.5 space-y-1">
                            <button v-if="['lnd','dept_admin','contractor_admin'].includes(activeRoleSim)" @click="currentView = 'admin-dashboard'" :class="['w-full flex items-center justify-between px-2.5 py-2 rounded-lg text-left transition-all', currentView === 'admin-dashboard' ? 'bg-blue-600 text-white font-bold shadow-sm shadow-blue-500/30' : 'text-slate-600 hover:bg-blue-50/80 hover:text-blue-700 font-semibold']">
                                <span>Overview &amp; Analitik MDKA</span>
                            </button>
                            <button v-if="activeRoleSim === 'trainer'" @click="currentView = 'trainer-command-center'" :class="['w-full flex items-center justify-between px-2.5 py-2 rounded-lg text-left transition-all', currentView === 'trainer-command-center' ? 'bg-blue-600 text-white font-bold shadow-sm shadow-blue-500/30' : 'text-slate-600 hover:bg-blue-50/80 hover:text-blue-700 font-semibold']">
                                <div class="flex items-center gap-2">
                                    <svg class="w-4 h-4 text-emerald-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"></path></svg>
                                    <span>Portal Instruktur (Command Center)</span>
                                </div>
                                <span class="px-1.5 py-0.5 rounded bg-emerald-50 text-emerald-700 border border-emerald-200 text-[9px] font-bold">LIVE</span>
                            </button>
                            <button @click="currentView = 'admin-training-today'; trainingTodayTab = 'calendar'" :class="['w-full flex items-center justify-between px-2.5 py-2 rounded-lg text-left transition-all', currentView === 'admin-training-today' && trainingTodayTab === 'calendar' ? 'bg-blue-600 text-white font-bold shadow-sm shadow-blue-500/30' : 'text-slate-600 hover:bg-blue-50/80 hover:text-blue-700 font-semibold']">
                                <span>Kalender &amp; Master Plan (ATMP)</span>
                                <span class="px-1.5 py-0.5 rounded bg-blue-100 text-blue-800 text-[9px] font-bold">ATMP</span>
                            </button>
                        </div>
                    </div>

                    <!-- 2. TRAINING -->
                    <div class="rounded-xl border border-slate-200/80 bg-slate-50/70 overflow-hidden shadow-sm">
                        <button @click="openSidebarGroups.training = !openSidebarGroups.training" class="w-full px-3 py-2.5 flex items-center justify-between text-left hover:bg-slate-100/90 transition-colors group">
                            <span class="text-[11px] font-black uppercase tracking-wider text-slate-600 group-hover:text-blue-700">2. TRAINING</span>
                            <span v-if="!isSidebarCollapsed" class="text-[10px] text-slate-400 group-hover:text-slate-600">{{ openSidebarGroups.training ? '▲' : '▼' }}</span>
