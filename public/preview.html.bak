                            <button @click="currentView = 'competency-individual-view'" :class="['w-full flex items-center justify-between px-2.5 py-2 rounded-lg text-left transition-all', currentView === 'competency-individual-view' ? 'bg-blue-600 text-white font-bold shadow-sm shadow-blue-500/30' : 'text-slate-600 hover:bg-blue-50/80 hover:text-blue-700 font-semibold']">
                                <span>Individual Training View</span>
