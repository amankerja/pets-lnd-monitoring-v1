                    { id: newId * 100 + 4, course_id: newId, order_index: 4, title: 'Modul 4: Uji Kompetensi & Evaluasi' },
                ],
            });
            courseModalSim.open = false;
            notify(`Program Training [${cleanCode}] berhasil dibuat & terhubung ke kompetensi [${skillItem?.code}] Level ${courseModalSim.granted_skill_level}!`);
