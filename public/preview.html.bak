            period: 'monthly',
            due_date: '2026-11-30',
            target_hours: 20,
            target_participants: 50,
            target_rating: 4.5,
        });

        const submitKpiSim = () => {
            if (!selectedTrainerDetail.value || !kpiFormSim.title) return;
            selectedTrainerDetail.value.kpis.push({
                id: Date.now(),
                title: kpiFormSim.title,
                period: kpiFormSim.period,
                period_label: kpiFormSim.period === 'daily' ? 'Harian' : kpiFormSim.period === 'weekly' ? 'Mingguan' : kpiFormSim.period === 'monthly' ? 'Bulanan' : 'Tahunan',
