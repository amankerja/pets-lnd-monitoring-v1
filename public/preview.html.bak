            courseModalSim.granted_skill_level = 3;
            courseModalSim.training_category = 'Safety';
            courseModalSim.training_source = 'internal';
            courseModalSim.is_mandatory = true;
            courseModalSim.validity_months = 24;
            courseModalSim.description = '';
            courseModalSim.open = true;
