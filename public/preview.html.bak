                            <button @click="currentView = 'competency-training-summary'; trainingSummaryTab = 'training_type'" :class="['w-full flex items-center justify-between px-2.5 py-2 rounded-lg text-left transition-all', currentView === 'competency-training-summary' ? 'bg-blue-600 text-white font-bold shadow-sm shadow-blue-500/30' : 'text-slate-600 hover:bg-blue-50/80 hover:text-blue-700 font-semibold']">
                                <span>Rangkuman Per Training &amp; Divisi</span>
                                <span class="px-1.5 py-0.5 rounded bg-blue-50 text-blue-700 border border-blue-200 text-[9px] font-bold">Rekap</span>
                            </button>
                            <button v-if="['lnd','dept_admin','contractor_admin'].includes(activeRoleSim)" @click="currentView = 'admin-position-skill'; posSettingTab = 'standards'" :class="['w-full flex items-center justify-between px-2.5 py-2 rounded-lg text-left transition-all', currentView === 'admin-position-skill' ? 'bg-blue-600 text-white font-bold shadow-sm shadow-blue-500/30' : 'text-slate-600 hover:bg-blue-50/80 hover:text-blue-700 font-semibold']">
                                <span>Setting Standar Level x Pos</span>
                                <span class="px-1.5 py-0.5 rounded bg-slate-200 text-slate-700 text-[9px] font-bold">{{ activeRoleSim === 'lnd' ? 'CRUD' : 'RO' }}</span>
                            </button>
                            <button @click="currentView = 'admin-competencies'" :class="['w-full flex items-center justify-between px-2.5 py-2 rounded-lg text-left transition-all', currentView === 'admin-competencies' ? 'bg-blue-600 text-white font-bold shadow-sm shadow-blue-500/30' : 'text-slate-600 hover:bg-blue-50/80 hover:text-blue-700 font-semibold']">
                                <span>Master Competency List</span>
                                <span class="px-1.5 py-0.5 rounded bg-blue-100 text-blue-800 text-[9px] font-bold">{{ activeRoleSim === 'lnd' ? 'Master' : 'RO' }}</span>
                            </button>
                        </div>
                    </div>

                    <!-- 4. MASTER DATA & ORGANISASI -->
                    <div v-if="['lnd','dept_admin','contractor_admin'].includes(activeRoleSim)" class="rounded-xl border border-slate-200/80 bg-slate-50/70 overflow-hidden shadow-sm">
                        <button @click="openSidebarGroups.master_data = !openSidebarGroups.master_data" class="w-full px-3 py-2.5 flex items-center justify-between text-left hover:bg-slate-100/90 transition-colors group">
                            <span class="text-[11px] font-black uppercase tracking-wider text-slate-600 group-hover:text-blue-700">4. MASTER DATA &amp; ORGANISASI</span>
                            <span v-if="!isSidebarCollapsed" class="text-[10px] text-slate-400 group-hover:text-slate-600">{{ openSidebarGroups.master_data ? '▲' : '▼' }}</span>
                        </button>
                        <div v-show="openSidebarGroups.master_data || isSidebarCollapsed" class="px-2 pb-2 pt-0.5 space-y-1">
                            <button @click="currentView = 'admin-manpower'; manpowerTab = 'manpower'" :class="['w-full flex items-center justify-between px-2.5 py-2 rounded-lg text-left transition-all', currentView === 'admin-manpower' && manpowerTab === 'manpower' ? 'bg-blue-600 text-white font-bold shadow-sm shadow-blue-500/30' : 'text-slate-600 hover:bg-blue-50/80 hover:text-blue-700 font-semibold']">
                                <span>Data Manpower &amp; Import CSV</span>
                            </button>
                            <button @click="currentView = 'admin-manpower'; manpowerTab = 'historical'" :class="['w-full flex items-center justify-between px-2.5 py-2 rounded-lg text-left transition-all', currentView === 'admin-manpower' && manpowerTab === 'historical' ? 'bg-blue-600 text-white font-bold shadow-sm shadow-blue-500/30' : 'text-slate-600 hover:bg-blue-50/80 hover:text-blue-700 font-semibold']">
                                <span>Migrasi Riwayat Masa Lalu</span>
                            </button>
                            <button @click="currentView = 'admin-manpower'; manpowerTab = 'self_reports'" :class="['w-full flex items-center justify-between px-2.5 py-2 rounded-lg text-left transition-all', currentView === 'admin-manpower' && manpowerTab === 'self_reports' ? 'bg-blue-600 text-white font-bold shadow-sm shadow-blue-500/30' : 'text-slate-600 hover:bg-blue-50/80 hover:text-blue-700 font-semibold']">
                                <span>Verifikasi Self-Report</span>
                                <span class="px-1.5 py-0.5 rounded bg-amber-100 text-amber-800 border border-amber-300 text-[9px] font-bold">1 Pending</span>
                            </button>
                            <button @click="currentView = 'admin-org-portal'; orgPortalTab = 'expiring'" :class="['w-full flex items-center justify-between px-2.5 py-2 rounded-lg text-left transition-all', currentView === 'admin-org-portal' ? 'bg-blue-600 text-white font-bold shadow-sm shadow-blue-500/30' : 'text-slate-600 hover:bg-blue-50/80 hover:text-blue-700 font-semibold']">
                                <span>Portal Organisasi &amp; Radar H-60</span>
                                <span class="px-1.5 py-0.5 rounded bg-rose-50 text-rose-700 border border-rose-200 text-[9px] font-bold">H-60</span>
                            </button>
                        </div>
                    </div>

                    <!-- 5. TRAINING TODAY -->
                    <div class="rounded-xl border border-slate-200/80 bg-slate-50/70 overflow-hidden shadow-sm">
                        <button @click="openSidebarGroups.training_today = !openSidebarGroups.training_today" class="w-full px-3 py-2.5 flex items-center justify-between text-left hover:bg-slate-100/90 transition-colors group">
                            <span class="text-[11px] font-black uppercase tracking-wider text-slate-600 group-hover:text-blue-700">5. TRAINING TODAY</span>
                            <span v-if="!isSidebarCollapsed" class="text-[10px] text-slate-400 group-hover:text-slate-600">{{ openSidebarGroups.training_today ? '▲' : '▼' }}</span>
                        </button>
                        <div v-show="openSidebarGroups.training_today || isSidebarCollapsed" class="px-2 pb-2 pt-0.5 space-y-1">
                            <button @click="currentView = 'admin-training-today'; trainingTodayTab = 'today'" :class="['w-full flex items-center justify-between px-2.5 py-2 rounded-lg text-left transition-all', currentView === 'admin-training-today' && trainingTodayTab === 'today' ? 'bg-blue-600 text-white font-bold shadow-sm shadow-blue-500/30' : 'text-slate-600 hover:bg-blue-50/80 hover:text-blue-700 font-semibold']">
                                <span>Operasional, Barcode &amp; Ujian</span>
                                <span class="px-1.5 py-0.5 rounded bg-emerald-50 text-emerald-700 border border-emerald-200 text-[9px] font-bold">LIVE</span>
                            </button>
                            <button v-if="['lnd','trainer'].includes(activeRoleSim)" @click="currentView = 'admin-projector'" :class="['w-full flex items-center justify-between px-2.5 py-2 rounded-lg text-left transition-all', currentView === 'admin-projector' ? 'bg-blue-600 text-white font-bold shadow-sm shadow-blue-500/30' : 'text-slate-600 hover:bg-blue-50/80 hover:text-blue-700 font-semibold']">
                                <span>Layar Proyektor QR 15d</span>
                            </button>
                        </div>
                    </div>
                </nav>

                <div class="p-3.5 border-t border-slate-200 bg-slate-50/90 text-xs shrink-0">
                    <div v-if="!isSidebarCollapsed">
                        <div class="text-[10px] font-black uppercase text-slate-500 mb-1">Simulasi Role Aktor:</div>
                        <select v-model="activeRoleSim" @change="activeRoleSim === 'trainer' ? (currentView = 'trainer-command-center') : ['dept_admin','contractor_admin'].includes(activeRoleSim) ? (currentView = 'admin-org-portal') : (currentView = 'admin-dashboard')" class="w-full rounded-lg bg-white border border-slate-300 text-slate-800 text-xs py-1.5 px-2.5 font-semibold shadow-sm focus:ring-blue-500 focus:border-blue-500">
                            <option value="lnd">Super Admin LnD (Global)</option>
                            <option value="trainer">Trainer / Instruktur</option>
                            <option value="dept_admin">Admin Dept. Internal</option>
                            <option value="contractor_admin">Admin PT Kontraktor</option>
                        </select>
                    </div>
                </div>
            </aside>

            <!-- Main Content -->
            <div :class="['flex-1 flex flex-col min-w-0', isProjectorFullscreen ? 'bg-slate-950 text-white' : '']">
                <header v-if="!isProjectorFullscreen" class="h-16 bg-white border-b border-slate-200 px-6 flex items-center justify-between shrink-0">
                    <div>
                        <h1 class="text-lg font-bold text-slate-900">
                            {{ currentView === 'admin-dashboard' ? 'Dashboard Analitik Pelatihan & Kompetensi' : currentView === 'trainer-command-center' ? 'Portal Instruktur — Command Center Pribadi Trainer' : currentView === 'admin-trainer-management' ? 'Pusat Manajemen Trainer, Roster, Jam Mengajar & KPI' : currentView === 'admin-matrix' ? 'Heatmap Skill Matrix & Gap Analysis' : currentView === 'competency-individual-view' ? 'Individual Training View per Karyawan' : currentView === 'competency-training-summary' ? 'Rangkuman Per Training & Divisi' : currentView === 'admin-projector' ? 'Proyektor Stateless Rotating QR (HMAC-SHA256)' : currentView === 'admin-training-today' ? (trainingTodayTab === 'calendar' ? 'Kalender Pelatihan & Master Plan (ATMP)' : 'Training Today — Operasional Sesi Hari Ini') : currentView === 'admin-position-skill' ? 'Pengaturan Standar Level x Posisi' : currentView === 'admin-competencies' ? 'Master Data Kompetensi' : currentView === 'admin-manpower' ? (manpowerTab === 'historical' ? 'Migrasi Riwayat Pelatihan Masa Lalu (Mode A & B)' : manpowerTab === 'self_reports' ? 'Verifikasi Self-Report Sertifikat Mandiri Peserta' : 'Manpower, NIK & Batch Import CSV') : currentView === 'admin-org-portal' ? 'Portal Organisasi & Radar H-60' : 'Manajemen Pendaftaran & Checklist Progress Modul' }}
                        </h1>
                        <p class="text-xs text-slate-500">Dual-Experience Desktop Mode — Flat Design & Native SVG</p>
                    </div>
                    <div class="flex items-center gap-3">
                        <div class="text-right hidden sm:block">
                            <div class="text-xs font-semibold text-slate-800">Budi Santoso (L&D Admin)</div>
                            <div class="text-[11px] text-slate-500">Human Capital & LND</div>
                        </div>
                        <span class="px-2.5 py-1 rounded text-xs font-semibold uppercase bg-blue-50 text-blue-700 border border-blue-200">ADMIN</span>
                    </div>
                </header>

                <!-- Flash Toast -->
                <div v-if="flashMessage" class="px-6 pt-4">
                    <div :class="['px-4 py-2.5 rounded border text-xs font-semibold flex justify-between items-center', flashType === 'error' ? 'bg-rose-50 border-rose-200 text-rose-800' : 'bg-emerald-50 border-emerald-200 text-emerald-800']">
                        <span>{{ flashMessage }}</span>
                        <button @click="flashMessage = ''" class="font-bold">✕</button>
                    </div>
                </div>

                <main class="flex-1 p-6 overflow-x-hidden">
                    <!-- VIEW 1A: ADMIN DASHBOARD -->
                    <div v-if="currentView === 'admin-dashboard'" class="space-y-6">
                        <!-- HEADER DASHBOARD & KPI BANNER RINGKAS -->
                        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
                            <div class="bg-white border border-slate-200 rounded-xl p-4 shadow-sm">
                                <div class="text-[10px] font-bold uppercase tracking-wider text-slate-400">Total Peserta Aktif</div>
                                <div class="mt-2 flex items-baseline justify-between">
                                    <div class="text-2xl font-black text-slate-900">{{ kpis.total_participants }}</div>
                                    <span class="text-[10px] font-bold text-blue-700 bg-blue-50 px-2 py-0.5 rounded border border-blue-200">{{ kpis.total_departments }} Departemen</span>
                                </div>
                                <div class="mt-2 text-xs text-slate-500">{{ kpis.active_enrollments }} Disetujui â€¢ {{ kpis.pending_enrollments }} Pending</div>
                            </div>
                            <div class="bg-white border border-slate-200 rounded-xl p-4 shadow-sm">
                                <div class="text-[10px] font-bold uppercase tracking-wider text-slate-400">Tingkat Kehadiran QR</div>
                                <div class="mt-2 flex items-baseline justify-between">
                                    <div class="text-2xl font-black text-emerald-600">{{ kpis.attendance_rate }}%</div>
                                    <span class="text-[10px] font-bold text-emerald-700 bg-emerald-50 px-2 py-0.5 rounded border border-emerald-200">Stateless HMAC</span>
                                </div>
                                <div class="mt-2 text-xs text-slate-500">{{ kpis.present_count }} Hadir dari {{ kpis.total_attendance_records }} log sesi</div>
                            </div>
                            <div class="bg-white border border-slate-200 rounded-xl p-4 shadow-sm">
                                <div class="text-[10px] font-bold uppercase tracking-wider text-slate-400">Penyelesaian Modul</div>
                                <div class="mt-2 flex items-baseline justify-between">
                                    <div class="text-2xl font-black text-blue-600">{{ kpis.avg_module_progress }}%</div>
                                    <span class="text-[10px] font-medium text-slate-600 bg-slate-100 px-2 py-0.5 rounded">Rata-rata Kelas</span>
                                </div>
                                <div class="mt-2.5 w-full bg-slate-100 h-2 rounded overflow-hidden">
                                    <div class="bg-blue-600 h-full transition-all" :style="{ width: kpis.avg_module_progress + '%' }"></div>
                                </div>
                            </div>
                            <div class="bg-white border border-slate-200 rounded-xl p-4 shadow-sm flex flex-col justify-between">
                                <div>
                                    <div class="text-[10px] font-bold uppercase tracking-wider text-slate-400">Matriks Kompetensi</div>
                                    <div class="mt-1 text-sm font-bold text-slate-900">Gap &amp; Target Standard</div>
                                    <p class="mt-1 text-xs text-slate-500">Evaluasi standar posisi vs level aktual.</p>
                                </div>
                                <button @click="currentView = 'admin-matrix'" class="mt-2 text-left text-xs font-bold text-blue-600 hover:underline">
                                    Buka Heatmap Matrix â†’
                                </button>
                            </div>
                        </div>

                        <!-- 0. 3 DONUT CHARTS OVERALL TRAINING COMPLETION (REMOTION ELEMENTS STYLE) -->
                        <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
                            <div
                                v-for="(donut, dKey) in overallDonuts"
                                :key="dKey"
                                class="bg-white border border-slate-200/90 rounded-2xl p-5 shadow-xs hover:shadow-md transition-all duration-300 flex flex-col justify-between"
                            >
                                <div>
                                    <div class="flex items-center justify-between border-b border-slate-100 pb-2.5 mb-4">
                                        <h3 class="text-xs font-bold uppercase tracking-wider text-slate-800">{{ donut.title }}</h3>
                                        <span class="text-[10px] font-extrabold px-2 py-0.5 rounded-full bg-blue-50 text-blue-700 border border-blue-200">
                                            {{ donut.rate }}% Kepatuhan
                                        </span>
                                    </div>

                                    <!-- Animated Donut Ring SVG -->
                                    <div class="flex justify-center py-2">
                                        <div class="relative w-40 h-40 group cursor-pointer">
                                            <svg viewBox="0 0 180 180" class="w-full h-full -rotate-90 overflow-visible transition-transform duration-500 ease-out group-hover:scale-105">
                                                <!-- Background Ring -->
                                                <circle cx="90" cy="90" r="70" fill="transparent" stroke="#f1f5f9" stroke-width="20" />
                                                <!-- Segments with Remotion Fluid Dynamics -->
                                                <circle
                                                    v-for="seg in donut.segments"
                                                    :key="seg.label"
                                                    cx="90" cy="90" r="70"
                                                    fill="transparent"
                                                    :stroke="seg.color"
                                                    :stroke-width="activeDonutSeg[dKey] === seg.idx ? 26 : 20"
                                                    :stroke-dasharray="seg.strokeDasharray"
                                                    :stroke-dashoffset="seg.strokeDashoffset"
                                                    stroke-linecap="butt"
                                                    class="transition-all duration-700 ease-[cubic-bezier(0.32,0.72,0,1)] origin-center cursor-pointer"
                                                    :class="[activeDonutSeg[dKey] !== null && activeDonutSeg[dKey] !== seg.idx ? 'opacity-35' : 'opacity-100']"
                                                    @mouseenter="activeDonutSeg[dKey] = seg.idx"
                                                    @mouseleave="activeDonutSeg[dKey] = null"
                                                />
                                            </svg>

                                            <!-- Dynamic Center Readout (Morphing on hover) -->
                                            <div class="absolute inset-0 flex flex-col items-center justify-center text-center pointer-events-none select-none px-2">
                                                <template v-if="activeDonutSeg[dKey] !== null && donut.segments[activeDonutSeg[dKey]]">
                                                    <span class="text-[9px] font-bold uppercase tracking-wider truncate max-w-[90px]" :style="{ color: donut.segments[activeDonutSeg[dKey]].color }">
                                                        {{ donut.segments[activeDonutSeg[dKey]].label }}
                                                    </span>
                                                    <span class="text-xl font-black text-slate-900 tracking-tight">
                                                        {{ donut.segments[activeDonutSeg[dKey]].percentage }}%
                                                    </span>
                                                    <span class="text-[10px] font-semibold text-slate-500">
                                                        {{ donut.segments[activeDonutSeg[dKey]].value }} Peserta
                                                    </span>
                                                </template>
                                                <template v-else>
                                                    <span class="text-[9px] font-semibold text-slate-400 uppercase tracking-wider">{{ donut.center }}</span>
                                                    <span class="text-2xl font-black text-slate-900 tracking-tight">{{ donut.rate }}%</span>
                                                </template>
                                            </div>
                                        </div>
                                    </div>

                                    <!-- Interactive Legend with Micro Progress Track -->
                                    <div class="mt-4 space-y-1.5">
                                        <div
                                            v-for="seg in donut.segments"
                                            :key="seg.label"
                                            class="p-1 rounded-lg transition-all duration-200 cursor-pointer"
                                            :class="[activeDonutSeg[dKey] === seg.idx ? 'bg-slate-100 shadow-xs' : activeDonutSeg[dKey] !== null ? 'opacity-40' : 'hover:bg-slate-50']"
                                            @mouseenter="activeDonutSeg[dKey] = seg.idx"
                                            @mouseleave="activeDonutSeg[dKey] = null"
                                        >
                                            <div class="flex items-center justify-between text-xs">
                                                <div class="flex items-center gap-1.5 min-w-0">
                                                    <span class="w-2.5 h-2.5 rounded-full shrink-0 transition-transform" :class="activeDonutSeg[dKey] === seg.idx ? 'scale-125' : ''" :style="{ backgroundColor: seg.color }"></span>
                                                    <span class="text-slate-700 font-medium truncate text-[11px]">{{ seg.label }}</span>
                                                </div>
                                                <div class="font-bold text-slate-900 text-[11px] shrink-0 pl-2">
                                                    {{ seg.value }} <span class="text-slate-400 font-normal text-[10px]">({{ seg.percentage }}%)</span>
                                                </div>
                                            </div>
                                            <div class="mt-1 w-full bg-slate-100 h-1 rounded-full overflow-hidden">
                                                <div class="h-full rounded-full transition-all duration-500 ease-out" :style="{ width: seg.percentage + '%', backgroundColor: seg.color }"></div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <p class="border-t border-slate-100 pt-2.5 mt-3 text-center text-[10px] text-slate-500 font-medium">
                                    {{ donut.note }}
                                </p>
                            </div>
                        </div>

                        <!-- 1. TREN PARTISIPASI PENDAFTARAN, TEACHING HOURS, & SELF-REPORT APPROVED -->
                        <div class="bg-white border border-slate-200 rounded-xl p-4 sm:p-5 shadow-sm">
                            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 border-b border-slate-100 pb-3 mb-4">
                                <div>
                                    <h2 class="text-xs font-bold uppercase tracking-wider text-slate-900">
                                        1. Tren Partisipasi Pendaftaran, Jam Mengajar Trainer, &amp; Self-Report Approved (Jan-Des {{ currentYear }})
                                    </h2>
                                    <p class="text-xs text-slate-500 mt-0.5">Analitik bulanan agregasi aktivitas pelatihan dan jam mengajar trainer sah.</p>
                                </div>
                                <div class="flex items-center gap-3 text-xs">
                                    <span class="inline-flex items-center gap-1.5"><span class="w-3 h-3 rounded bg-blue-600"></span> Partisipasi (Org)</span>
                                    <span class="inline-flex items-center gap-1.5"><span class="w-3 h-3 rounded bg-emerald-600"></span> Trainer (Jam)</span>
                                    <span class="inline-flex items-center gap-1.5"><span class="w-3 h-3 rounded bg-amber-500"></span> Self-Report</span>
                                </div>
                            </div>
                            <div class="w-full overflow-x-auto">
                                <svg viewBox="0 0 900 240" class="w-full min-w-[700px] h-auto select-none overflow-visible">
                                    <g v-for="g in [0, 20, 40, 60, 80]" :key="'g'+g">
                                        <line x1="40" :y1="200 - (g/80)*160" x2="880" :y2="200 - (g/80)*160" stroke="#f1f5f9" stroke-dasharray="3 3" />
                                        <text x="32" :y="200 - (g/80)*160 + 4" text-anchor="end" class="fill-slate-400 text-[10px] font-mono">{{ g }}</text>
                                    </g>
                                    <line x1="40" y1="200" x2="880" y2="200" stroke="#cbd5e1" stroke-width="1.5" />
                                    <g
                                        v-for="(m, idx) in monthsLabels"
                                        :key="m"
                                        class="group cursor-pointer"
                                        @mouseenter="activeBarMonthIndex = idx"
                                        @mouseleave="activeBarMonthIndex = null"
                                    >
                                        <!-- Column Hover Light Wash -->
                                        <rect
                                            :x="54 + idx * 68"
                                            y="40"
                                            width="68"
                                            height="160"
                                            fill="#f8fafc"
                                            rx="4"
                                            class="transition-opacity duration-200"
                                            :class="activeBarMonthIndex === idx ? 'opacity-100' : 'opacity-0'"
                                        />

                                        <!-- Bars with Remotion Motion Curves -->
                                        <rect
                                            :x="60 + idx * 68"
                                            :y="200 - ((dashboardMetrics?.participationTrend?.[idx] || 0) / maxParticipation) * 160"
                                            width="16"
                                            :height="((dashboardMetrics?.participationTrend?.[idx] || 0) / maxParticipation) * 160"
                                            fill="#2563eb"
                                            rx="3"
                                            class="transition-all duration-500 ease-[cubic-bezier(0.32,0.72,0,1)] origin-bottom group-hover:scale-y-105"
                                        >
                                            <title>{{ m }} - Pendaftaran: {{ dashboardMetrics?.participationTrend?.[idx] || 0 }} Orang</title>
                                        </rect>
                                        <rect
                                            :x="78 + idx * 68"
                                            :y="200 - ((dashboardMetrics?.trainerHoursTrend?.[idx] || 0) / maxParticipation) * 160"
                                            width="16"
                                            :height="((dashboardMetrics?.trainerHoursTrend?.[idx] || 0) / maxParticipation) * 160"
                                            fill="#059669"
                                            rx="3"
                                            class="transition-all duration-500 ease-[cubic-bezier(0.32,0.72,0,1)] origin-bottom group-hover:scale-y-105"
                                        >
                                            <title>{{ m }} - Trainer: {{ dashboardMetrics?.trainerHoursTrend?.[idx] || 0 }} Jam</title>
                                        </rect>
                                        <rect
                                            :x="96 + idx * 68"
                                            :y="200 - ((dashboardMetrics?.selfReportTrend?.[idx] || 0) / maxParticipation) * 160"
                                            width="16"
                                            :height="((dashboardMetrics?.selfReportTrend?.[idx] || 0) / maxParticipation) * 160"
                                            fill="#f59e0b"
                                            rx="3"
                                            class="transition-all duration-500 ease-[cubic-bezier(0.32,0.72,0,1)] origin-bottom group-hover:scale-y-105"
                                        >
                                            <title>{{ m }} - Self-Report: {{ dashboardMetrics?.selfReportTrend?.[idx] || 0 }} Sertifikat</title>
                                        </rect>

                                        <text
                                            :x="86 + idx * 68"
                                            y="218"
                                            text-anchor="middle"
                                            class="text-[11px] font-bold transition-colors duration-200"
                                            :class="activeBarMonthIndex === idx ? 'fill-blue-700 font-extrabold' : 'fill-slate-700'"
                                        >
                                            {{ m }}
                                        </text>
                                    </g>
                                </svg>
                            </div>
                        </div>

                        <!-- GRID BARIS 2: METRIK 2 & 3 -->
                        <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">
                            <!-- 2. TOP 12 SKILL GAP TERBESAR -->
                            <div class="lg:col-span-7 bg-white border border-slate-200 rounded-xl p-4 sm:p-5 shadow-sm">
                                <div class="border-b border-slate-100 pb-3 mb-4">
                                    <h2 class="text-xs font-bold uppercase tracking-wider text-slate-900">
                                        2. Top 12 Defisit / Gap Kompetensi Terbesar (Current &lt; Target)
                                    </h2>
                                    <p class="text-xs text-slate-500 mt-0.5">Kompetensi yang paling mendesak membutuhkan program pelatihan tindak lanjut.</p>
                                </div>
                                <div class="space-y-2.5 max-h-[380px] overflow-y-auto pr-1">
                                    <div v-for="(sg, idx) in (dashboardMetrics?.topSkillGaps || [])" :key="sg.id" class="border border-slate-100 bg-slate-50/50 p-2.5 rounded-lg flex items-center justify-between gap-3 hover:bg-slate-50">
                                        <div class="min-w-0 flex-1">
                                            <div class="flex items-center gap-2">
                                                <span class="text-[9px] font-bold font-mono px-1.5 py-0.5 rounded bg-slate-200 text-slate-700">#{{ idx + 1 }}</span>
                                                <span class="text-xs font-bold text-slate-800 truncate">{{ sg.name }}</span>
                                            </div>
                                            <div class="mt-1 flex items-center gap-2">
                                                <div class="flex-1 bg-slate-200 h-2 rounded overflow-hidden">
                                                    <div class="bg-rose-500 h-full rounded" :style="{ width: Math.min(100, (sg.total_deficits / 25) * 100) + '%' }"></div>
                                                </div>
                                                <span class="font-mono text-[10px] text-slate-400 shrink-0">{{ sg.code }}</span>
                                            </div>
                                        </div>
                                        <div class="text-right shrink-0">
                                            <span class="text-xs font-extrabold text-rose-700 font-mono">{{ sg.total_deficits }}</span>
                                            <span class="text-[10px] text-slate-500 block">Karyawan Defisit</span>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- 3. TREN PELATIHAN TIME-SERIES BULANAN -->
                            <div class="lg:col-span-5 bg-white border border-slate-200 rounded-xl p-4 sm:p-5 shadow-sm flex flex-col justify-between">
                                <div>
                                    <div class="border-b border-slate-100 pb-3 mb-4">
                                        <h2 class="text-xs font-bold uppercase tracking-wider text-slate-900">
                                            3. Tren Volume Kelas &amp; Partisipasi Bulanan
                                        </h2>
                                        <p class="text-xs text-slate-500 mt-0.5">Jumlah sesi pelatihan dan total peserta per bulan.</p>
                                    </div>
                                    <div class="w-full">
                                        <svg viewBox="0 0 450 200" class="w-full h-auto select-none">
                                            <line x1="30" y1="160" x2="430" y2="160" stroke="#cbd5e1" stroke-width="1.5" />
                                            <g v-for="(v, i) in (dashboardMetrics?.monthlyTrainingVolume || [])" :key="v.month">
                                                <rect :x="42 + i * 32" :y="160 - (v.participants / maxVolume) * 120" width="14" :height="(v.participants / maxVolume) * 120" fill="#3b82f6" rx="2" />
                                                <circle :cx="49 + i * 32" :cy="160 - (v.courses_count / 12) * 120" r="3" fill="#10b981" />
                                                <text :x="49 + i * 32" y="178" text-anchor="middle" class="fill-slate-600 text-[9px] font-bold">{{ v.month }}</text>
                                            </g>
                                        </svg>
                                        <div class="flex items-center justify-center gap-4 text-xs text-slate-600 mt-2">
                                            <span class="inline-flex items-center gap-1.5"><span class="w-3 h-3 rounded bg-blue-500"></span> Peserta</span>
                                            <span class="inline-flex items-center gap-1.5"><span class="w-3 h-3 rounded-full bg-emerald-500"></span> Volume Kelas</span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- GRID BARIS 3: METRIK 4 & 5 -->
                        <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">
                            <!-- 4. MANPOWER TERKOMPETENSI PER PERUSAHAAN / ORGANISASI -->
                            <div class="lg:col-span-6 bg-white border border-slate-200 rounded-xl p-4 sm:p-5 shadow-sm">
                                <div class="border-b border-slate-100 pb-3 mb-4">
                                    <h2 class="text-xs font-bold uppercase tracking-wider text-slate-900">
                                        4. Manpower Terkompetensi per Perusahaan / Organisasi
                                    </h2>
                                    <p class="text-xs text-slate-500 mt-0.5">Persentase personel yang seluruh skill-nya mencapai target standar.</p>
                                </div>
                                <div class="overflow-x-auto">
                                    <table class="w-full text-xs text-left border-collapse">
                                        <thead>
                                            <tr class="bg-slate-50 text-slate-600 border-b border-slate-200 uppercase text-[10px] font-bold">
                                                <th class="p-2.5">Organisasi / Kontraktor</th>
                                                <th class="p-2.5 text-center">Total</th>
                                                <th class="p-2.5 text-center">Kompeten</th>
                                                <th class="p-2.5 text-right">% Kepatuhan</th>
                                            </tr>
                                        </thead>
                                        <tbody class="divide-y divide-slate-100 font-mono">
                                            <tr v-for="org in (dashboardMetrics?.manpowerCompetencyPerOrg || [])" :key="org.org_name" class="hover:bg-slate-50">
                                                <td class="p-2.5 font-sans font-bold text-slate-900">
                                                    {{ org.org_name }}
                                                    <span class="block text-[10px] font-normal text-slate-400 uppercase font-mono">{{ org.org_type }}</span>
                                                </td>
                                                <td class="p-2.5 text-center">{{ org.total_manpower }}</td>
                                                <td class="p-2.5 text-center text-emerald-700 font-bold">{{ org.fully_competent_count }}</td>
                                                <td class="p-2.5 text-right font-bold text-slate-900">
                                                    <span class="px-2 py-0.5 rounded bg-slate-100 border border-slate-200 text-xs">
                                                        {{ org.competency_percentage }}%
                                                    </span>
                                                </td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </div>
                            </div>

                            <!-- 5. JADWAL PELATIHAN TERDEKAT -->
                            <div class="lg:col-span-6 bg-white border border-slate-200 rounded-xl p-4 sm:p-5 shadow-sm">
                                <div class="border-b border-slate-100 pb-3 mb-4">
                                    <h2 class="text-xs font-bold uppercase tracking-wider text-slate-900">
                                        5. Jadwal Pelatihan Terdekat (Upcoming Schedules)
                                    </h2>
                                    <p class="text-xs text-slate-500 mt-0.5">Agenda kelas pelatihan yang akan segera dimulai dalam waktu dekat.</p>
                                </div>
                                <div class="space-y-2.5 max-h-[380px] overflow-y-auto pr-1">
                                    <div v-for="sch in (dashboardMetrics?.upcomingSchedules || [])" :key="sch.id" class="border border-slate-200 bg-slate-50/50 rounded-lg p-3 hover:bg-slate-100/70 transition flex flex-col justify-between">
                                        <div class="flex items-start justify-between gap-2">
                                            <div>
                                                <div class="flex items-center gap-2 mb-1">
                                                    <span class="font-mono text-[10px] font-bold bg-slate-900 text-white px-1.5 py-0.5 rounded">{{ sch.code }}</span>
                                                    <span :class="sch.is_mandatory ? 'bg-rose-50 text-rose-800 border-rose-200' : 'bg-slate-100 text-slate-700 border-slate-200'" class="text-[9px] font-bold px-1.5 py-0.5 border rounded uppercase">
                                                        {{ sch.is_mandatory ? 'MANDATORY' : 'NON-MANDATORY' }}
                                                    </span>
                                                </div>
                                                <h4 class="font-bold text-slate-900 text-xs">{{ sch.title }}</h4>
                                                <p class="text-[11px] text-slate-500 mt-0.5">Kompetensi: <span class="font-semibold text-slate-700">{{ sch.competency_name }}</span></p>
                                            </div>
                                            <div class="text-right shrink-0">
                                                <span class="font-mono text-xs font-bold text-emerald-700 block">&#128197; {{ sch.start_date }}</span>
                                                <span class="text-[10px] text-slate-500">Trainer: {{ sch.trainer_name }}</span>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- VIEW 1A-2: MASTER DATA KOMPETENSI (Competency List) -->
                    <div v-else-if="currentView === 'admin-competencies'">
                        <!-- Header & Tombol Tambah Kompetensi Baru -->
                        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 bg-white border border-slate-200 rounded-xl p-4 mb-4 shadow-sm">
                            <div>
                                <h1 class="text-base font-bold text-slate-800">
                                    Master Data Daftar Kompetensi (Competency List)
                                </h1>
                                <p class="text-xs text-slate-500 mt-0.5">
                                    Acuan dasar pusat kompetensi yang direlasikan ke Training Matrix, Level x Position, dan Program Pelatihan
                                </p>
                            </div>
                            <div class="flex items-center gap-2">
                                <button @click="currentView = 'admin-matrix'" class="px-3 py-2 rounded-lg border border-slate-300 bg-white hover:bg-slate-50 text-slate-700 text-xs font-semibold">
                                    Lihat Training Matrix →
                                </button>
                                <button v-if="activeRoleSim === 'lnd'" @click="openCreateCompetencyModal" class="px-3.5 py-2 rounded-lg bg-blue-600 hover:bg-blue-700 text-white text-xs font-bold shadow-sm">
                                    + Tambah Kompetensi Baru
                                </button>
                            </div>
                        </div>

                        <!-- 4 Kartu KPI Ringkasan Master Kompetensi -->
                        <div class="grid grid-cols-2 lg:grid-cols-4 gap-3 mb-4">
                            <div class="bg-white border border-slate-200 rounded-xl p-3.5 shadow-sm">
                                <p class="text-[11px] font-semibold uppercase tracking-wider text-slate-400">Total Master Kompetensi</p>
                                <p class="text-xl font-bold text-slate-800 mt-1">{{ competencyKpis.total }}</p>
                            </div>
                            <div class="bg-indigo-50/70 border border-indigo-200 rounded-xl p-3.5 shadow-sm">
                                <p class="text-[11px] font-semibold uppercase tracking-wider text-indigo-800">External - Mandatory</p>
                                <p class="text-xl font-bold text-indigo-950 mt-1">{{ competencyKpis.external_mandatory }}</p>
                            </div>
                            <div class="bg-slate-100/90 border border-slate-300 rounded-xl p-3.5 shadow-sm">
                                <p class="text-[11px] font-semibold uppercase tracking-wider text-slate-700">Internal - Mandatory</p>
                                <p class="text-xl font-bold text-slate-900 mt-1">{{ competencyKpis.internal_mandatory }}</p>
                            </div>
                            <div class="bg-slate-50 border border-slate-200 rounded-xl p-3.5 shadow-sm">
                                <p class="text-[11px] font-semibold uppercase tracking-wider text-slate-500">Non-Mandatory (Opsional)</p>
                                <p class="text-xl font-bold text-slate-700 mt-1">{{ competencyKpis.non_mandatory }}</p>
                            </div>
                        </div>

                        <!-- Filter Bar di Atas Tabel -->
                        <div class="bg-white border border-slate-200 rounded-xl p-4 mb-4 shadow-sm">
                            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-12 gap-3 items-end">
                                <div class="sm:col-span-2 lg:col-span-5">
                                    <label class="block text-[10px] font-bold uppercase tracking-wider text-slate-500 mb-1">Cari Kode atau Nama Kompetensi</label>
                                    <input v-model="competencyFilter.search" type="search" placeholder="Ketik kode (misal: SKL-HSE-01) atau nama..." class="w-full rounded-lg border-slate-300 text-xs py-1.5 px-3" />
                                </div>
                                <div class="lg:col-span-3">
                                    <label class="block text-[10px] font-bold uppercase tracking-wider text-slate-500 mb-1">Jenis Kompetensi</label>
                                    <select v-model="competencyFilter.competency_type" class="w-full rounded-lg border-slate-300 text-xs py-1.5 px-2.5 font-medium">
                                        <option value="">Semua Jenis Kompetensi</option>
                                        <option value="EXTERNAL_MANDATORY">External - Mandatory</option>
                                        <option value="INTERNAL_MANDATORY">Internal - Mandatory</option>
                                        <option value="NON_MANDATORY">Non-Mandatory</option>
                                    </select>
                                </div>
                                <div class="lg:col-span-3">
                                    <label class="block text-[10px] font-bold uppercase tracking-wider text-slate-500 mb-1">Bidang / Kategori</label>
                                    <select v-model="competencyFilter.category" class="w-full rounded-lg border-slate-300 text-xs py-1.5 px-2.5 font-medium">
                                        <option value="">Semua Bidang / Kategori</option>
                                        <option v-for="cat in ['Safety', 'Operation', 'Plant', 'Pengawas', 'Engineering', 'Leadership', 'General']" :key="cat" :value="cat">{{ cat }}</option>
                                    </select>
                                </div>
                                <div class="lg:col-span-1 flex justify-end">
                                    <button v-if="competencyFilter.search || competencyFilter.competency_type || competencyFilter.category" @click="competencyFilter.search = ''; competencyFilter.competency_type = ''; competencyFilter.category = ''" class="w-full px-2.5 py-1.5 rounded-lg bg-rose-50 hover:bg-rose-100 text-rose-700 border border-rose-200 text-xs font-bold">Reset</button>
                                </div>
                            </div>
                        </div>

                        <!-- Struktur Kolom Tabel Master Kompetensi -->
                        <div class="bg-white border border-slate-200 rounded-xl shadow-sm overflow-hidden mb-6">
                            <div class="overflow-x-auto">
                                <table class="w-full text-left border-collapse">
                                    <thead>
                                        <tr class="bg-slate-50 border-b border-slate-200 text-[11px] font-semibold uppercase tracking-wider text-slate-500">
                                            <th class="p-3.5 w-36">Kode Kompetensi</th>
                                            <th class="p-3.5">Nama Kompetensi &amp; Deskripsi</th>
                                            <th class="p-3.5 w-36">Bidang / Kategori</th>
                                            <th class="p-3.5 w-52">Jenis Kompetensi</th>
                                            <th class="p-3.5 w-64">Statistik Penggunaan &amp; Kepatuhan</th>
                                            <th class="p-3.5 w-32 text-right">Aksi</th>
                                        </tr>
                                    </thead>
                                    <tbody class="divide-y divide-slate-100 text-xs text-slate-700">
                                        <tr v-for="item in enrichedCompetencies" :key="item.id" class="hover:bg-slate-50/80 transition-colors">
                                            <td class="p-3.5 align-top">
                                                <span class="inline-block font-mono text-xs font-extrabold text-blue-800 bg-blue-50 border border-blue-200 px-2.5 py-1 rounded-md">
                                                    {{ item.code }}
                                                </span>
                                            </td>
                                            <td class="p-3.5 align-top">
                                                <div class="font-bold text-slate-900 text-xs sm:text-sm">{{ item.name }}</div>
                                                <p class="text-[11px] text-slate-500 mt-0.5 leading-relaxed">{{ item.description }}</p>
                                                <div v-if="item.linked_courses?.length" class="flex flex-wrap items-center gap-1.5 mt-2">
                                                    <span class="text-[10px] font-semibold text-slate-400">Training Terkait:</span>
                                                    <span v-for="crs in item.linked_courses" :key="crs.id" class="px-1.5 py-0.5 rounded bg-slate-100 text-slate-700 border border-slate-200 font-mono text-[10px] font-semibold">
                                                        {{ crs.code }}
                                                    </span>
                                                </div>
                                            </td>
                                            <td class="p-3.5 align-top">
                                                <span class="inline-flex items-center px-2.5 py-0.5 rounded-md text-[11px] font-semibold border"
                                                    :class="{
                                                        'bg-blue-50 text-blue-700 border-blue-200': item.category === 'Safety',
                                                        'bg-sky-50 text-sky-700 border-sky-200': item.category === 'Operation',
                                                        'bg-amber-50 text-amber-800 border-amber-200': item.category === 'Plant',
                                                        'bg-purple-50 text-purple-700 border-purple-200': item.category === 'Pengawas',
                                                        'bg-emerald-50 text-emerald-700 border-emerald-200': item.category === 'Engineering',
                                                        'bg-slate-100 text-slate-700 border-slate-200': !['Safety','Operation','Plant','Pengawas','Engineering'].includes(item.category)
                                                    }"
                                                >
                                                    {{ item.category }}
                                                </span>
                                            </td>
                                            <td class="p-3.5 align-top">
                                                <span v-if="item.competency_type === 'EXTERNAL_MANDATORY'" class="inline-flex items-center px-2.5 py-1 rounded-md text-[10px] font-extrabold tracking-wide bg-indigo-900 text-white border border-indigo-950 shadow-sm">
                                                    EXTERNAL - MANDATORY
                                                </span>
                                                <span v-else-if="item.competency_type === 'INTERNAL_MANDATORY'" class="inline-flex items-center px-2.5 py-1 rounded-md text-[10px] font-extrabold tracking-wide bg-slate-900 text-white border border-slate-950 shadow-sm">
                                                    INTERNAL - MANDATORY
                                                </span>
                                                <span v-else class="inline-flex items-center px-2.5 py-1 rounded-md text-[10px] font-bold tracking-wide bg-slate-100 text-slate-600 border border-slate-300">
                                                    NON-MANDATORY
                                                </span>
                                            </td>
                                            <td class="p-3.5 align-top space-y-1.5">
                                                <div class="flex items-center justify-between text-[11px]">
                                                    <span class="text-slate-500">Standar Posisi (Level x Pos):</span>
                                                    <span class="font-bold text-slate-800 bg-slate-100 px-2 py-0.5 rounded">{{ item.positions_count }} Posisi</span>
                                                </div>
                                                <div class="flex items-center justify-between text-[11px]">
                                                    <span class="text-slate-500">Total Karyawan:</span>
                                                    <span class="font-bold text-slate-800">{{ item.total_workers_count }} Orang</span>
                                                </div>
                                                <div class="flex items-center gap-1.5 pt-0.5">
                                                    <span class="px-2 py-0.5 rounded bg-emerald-50 text-emerald-700 border border-emerald-200 text-[10px] font-bold">&#10003; {{ item.competent_workers_count }} Kompeten</span>
                                                    <span class="px-2 py-0.5 rounded bg-rose-50 text-rose-700 border border-rose-200 text-[10px] font-bold">! {{ item.gap_workers_count }} Defisit Gap</span>
                                                </div>
                                            </td>
                                            <td class="p-3.5 align-top text-right whitespace-nowrap">
                                                <div v-if="activeRoleSim === 'lnd'" class="inline-flex items-center gap-1.5">
                                                    <button @click="openEditCompetencyModal(item)" class="px-2.5 py-1 rounded-md bg-blue-50 hover:bg-blue-100 text-blue-700 border border-blue-200 text-xs font-semibold">Edit</button>
                                                    <button @click="deleteCompetencySim(item)" class="px-2.5 py-1 rounded-md bg-rose-50 hover:bg-rose-100 text-rose-700 border border-rose-200 text-xs font-semibold">Hapus</button>
                                                </div>
                                                <span v-else class="px-2 py-0.5 rounded bg-slate-100 text-slate-500 text-[10px] font-semibold">Read-Only</span>
                                            </td>
                                        </tr>
                                        <tr v-if="!enrichedCompetencies.length">
                                            <td colspan="6" class="py-8 text-center text-slate-400">Tidak ada kompetensi yang sesuai dengan filter.</td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>

                        <!-- Modal Form Tambah / Edit Kompetensi Sim -->
                        <div v-if="competencyModalSim.open" class="fixed inset-0 z-50 bg-slate-900/50 flex items-center justify-center p-4" @click.self="competencyModalSim.open = false">
                            <div class="bg-white border border-slate-200 rounded-xl w-full max-w-lg shadow-xl overflow-hidden">
                                <div class="px-5 py-3.5 bg-blue-50 border-b border-blue-100 flex items-center justify-between">
                                    <div>
                                        <div class="text-[10px] font-bold uppercase tracking-wider text-blue-600">{{ competencyModalSim.isEdit ? 'Edit Master Kompetensi' : 'Tambah Master Kompetensi Baru' }}</div>
                                        <h3 class="text-sm font-bold text-slate-900">{{ competencyModalSim.isEdit ? 'Perbarui Kompetensi [' + competencyModalSim.code + ']' : 'Form Standar Kompetensi Perusahaan' }}</h3>
                                    </div>
                                    <button @click="competencyModalSim.open = false" class="text-slate-400 hover:text-slate-700 font-bold px-2">✕</button>
                                </div>
                                <div class="p-5 space-y-4 text-xs">
                                    <div class="grid grid-cols-2 gap-3">
                                        <div>
                                            <label class="block font-bold text-slate-700 mb-1">Kode Kompetensi <span class="text-rose-600">*</span></label>
                                            <input v-model="competencyModalSim.code" @input="competencyModalSim.code = ($event.target.value || '').toUpperCase()" type="text" placeholder="Contoh: SFT-K3-01" class="w-full rounded-lg border-slate-300 font-mono uppercase text-xs py-2 px-3" />
                                        </div>
                                        <div>
                                            <label class="block font-bold text-slate-700 mb-1">Bidang / Kategori <span class="text-rose-600">*</span></label>
                                            <select v-model="competencyModalSim.category" class="w-full rounded-lg border-slate-300 text-xs py-2 px-3">
                                                <option v-for="cat in ['Safety', 'Operation', 'Plant', 'Pengawas', 'Engineering', 'Leadership', 'General']" :key="cat" :value="cat">{{ cat }}</option>
                                            </select>
                                        </div>
                                    </div>
                                    <div>
                                        <label class="block font-bold text-slate-700 mb-1">Nama Kompetensi <span class="text-rose-600">*</span></label>
                                        <input v-model="competencyModalSim.name" type="text" placeholder="Contoh: Keselamatan & Kesehatan Kerja Umum (K3)" class="w-full rounded-lg border-slate-300 text-xs py-2 px-3" />
                                    </div>
                                    <div>
                                        <label class="block font-bold text-slate-700 mb-1">Jenis Kompetensi (Sifat &amp; Sumber) <span class="text-rose-600">*</span></label>
                                        <select v-model="competencyModalSim.competency_type" class="w-full rounded-lg border-slate-300 text-xs py-2 px-3 font-semibold">
                                            <option value="EXTERNAL_MANDATORY">EXTERNAL - MANDATORY (Sertifikasi Lembaga Luar & Wajib)</option>
                                            <option value="INTERNAL_MANDATORY">INTERNAL - MANDATORY (Pelatihan Internal Perusahaan & Wajib)</option>
                                            <option value="NON_MANDATORY">NON-MANDATORY (Pelatihan Opsional / Pilihan)</option>
                                        </select>
                                    </div>
                                    <div>
                                        <label class="block font-bold text-slate-700 mb-1">Deskripsi / Acuan Standar Kompetensi</label>
                                        <textarea v-model="competencyModalSim.description" rows="3" placeholder="Jelaskan ruang lingkup keahlian, regulasi acuan (BNSP/Kemnaker/SOP Internal)..." class="w-full rounded-lg border-slate-300 text-xs py-2 px-3"></textarea>
                                    </div>
                                    <div class="flex items-center justify-end gap-2 pt-3 border-t border-slate-200">
                                        <button @click="competencyModalSim.open = false" class="px-3.5 py-2 rounded-lg border border-slate-300 font-semibold text-slate-700 hover:bg-slate-50">Batal</button>
                                        <button @click="saveCompetencySim" class="px-4 py-2 rounded-lg bg-blue-600 hover:bg-blue-700 text-white font-bold shadow-sm">{{ competencyModalSim.isEdit ? 'Simpan Perubahan' : 'Simpan Kompetensi' }}</button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- VIEW 1B: HEATMAP SKILL MATRIX (Sticky Column + Interactive Cell Modal + Global Filter Bar) -->
                    <div v-else-if="currentView === 'admin-matrix'">
                        <!-- GLOBAL SEARCH & MULTI-ATTRIBUTE FILTER BAR (2 BARIS RAPI SESUAI STANDAR) -->
                        <div class="bg-white border border-slate-200 rounded-xl p-3 sm:p-4 mb-4 shadow-sm space-y-3">
                            <!-- BARIS 1: Pencarian Cepat Global, Reset & Export CSV -->
                            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2.5">
                                <div class="relative flex-1 max-w-xl">
                                    <input
                                        v-model="matrixFilter.search"
                                        type="search"
                                        placeholder="Cari Nama, NIK, Kode/Judul Training, No. Sertifikat..."
                                        class="w-full rounded-lg border-slate-300 text-xs py-1.5 pl-8 pr-3 text-slate-800 placeholder-slate-400 focus:border-slate-500 focus:ring-1 focus:ring-slate-400 transition"
                                    />
                                    <svg class="w-3.5 h-3.5 text-slate-400 absolute left-2.5 top-1/2 -translate-y-1/2 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-4.35-4.35m1.85-5.15a7 7 0 11-14 0 7 7 0 0114 0z"/>
                                    </svg>
                                </div>
                                <div class="flex items-center gap-2 shrink-0">
                                    <button
                                        type="button"
                                        @click="resetMatrixFilters"
                                        class="inline-flex items-center gap-1.5 px-2.5 py-1.5 rounded-lg bg-slate-100 hover:bg-rose-50 text-slate-600 hover:text-rose-700 border border-slate-200 text-xs font-semibold transition"
                                    >
                                        <span class="text-rose-500 font-bold">✕</span>
                                        <span>Reset Filter</span>
                                    </button>
                                    <button
                                        @click="downloadSkillMatrixCsv"
                                        class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-medium shadow-sm transition"
                                    >
                                        <span>⬇ Export CSV</span>
                                    </button>
                                </div>
                            </div>

                            <!-- BARIS 2: 6 ATRIBUT FILTER UTAMA (DEPARTEMENT, PERUSAHAAN, BULAN, JENIS TRAINING, INTERNAL/EXTERNAL, KODE TRAINING) -->
                            <div class="pt-2.5 border-t border-slate-100 grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 xl:grid-cols-6 gap-2.5">
                                <!-- 1. DEPARTEMENT -->
                                <div>
                                    <label class="block text-[10px] font-bold uppercase tracking-wider text-slate-500 mb-1 truncate">DEPARTEMENT</label>
                                    <select v-model="matrixFilter.department" class="w-full rounded-lg border-slate-300 text-xs py-1.5 px-2 text-slate-800 bg-white focus:border-slate-500 focus:ring-1 focus:ring-slate-400 transition">
                                        <option value="">Semua Departemen</option>
                                        <option v-for="d in departments" :key="d" :value="d">{{ d }}</option>
                                    </select>
                                </div>

                                <!-- 2. PERUSAHAAN -->
                                <div>
                                    <label class="block text-[10px] font-bold uppercase tracking-wider text-slate-500 mb-1 truncate">PERUSAHAAN</label>
                                    <select v-model="matrixFilter.company" class="w-full rounded-lg border-slate-300 text-xs py-1.5 px-2 text-slate-800 bg-white focus:border-slate-500 focus:ring-1 focus:ring-slate-400 transition">
                                        <option value="">Semua Perusahaan</option>
                                        <option v-for="comp in companies" :key="comp" :value="comp">{{ comp }}</option>
                                    </select>
                                </div>

                                <!-- 3. BULAN (dengan Switcher Bulan / Hari / Rentang) -->
                                <div>
                                    <div class="flex items-center justify-between mb-1">
                                        <label class="block text-[10px] font-bold uppercase tracking-wider text-slate-500 truncate">BULAN</label>
                                        <div class="inline-flex rounded bg-slate-100 p-0.5 border border-slate-200 text-[9px] font-semibold">
                                            <button type="button" @click="matrixFilter.date_mode = 'month'" :class="['px-1 py-0.2 rounded transition', matrixFilter.date_mode === 'month' ? 'bg-slate-700 text-white shadow-xs' : 'text-slate-600 hover:text-slate-900']">Bulan</button>
                                            <button type="button" @click="matrixFilter.date_mode = 'single'" :class="['px-1 py-0.2 rounded transition', matrixFilter.date_mode === 'single' ? 'bg-slate-700 text-white shadow-xs' : 'text-slate-600 hover:text-slate-900']">Hari</button>
                                            <button type="button" @click="matrixFilter.date_mode = 'range'" :class="['px-1 py-0.2 rounded transition', matrixFilter.date_mode === 'range' ? 'bg-slate-700 text-white shadow-xs' : 'text-slate-600 hover:text-slate-900']">Rentang</button>
                                        </div>
                                    </div>
                                    <div v-if="matrixFilter.date_mode === 'month'">
                                        <input v-model="matrixFilter.month" type="month" class="w-full rounded-lg border-slate-300 text-xs py-1.5 px-2 text-slate-800 bg-white focus:border-slate-500 focus:ring-1 focus:ring-slate-400 transition" />
                                    </div>
                                    <div v-else-if="matrixFilter.date_mode === 'single'">
                                        <input v-model="matrixFilter.date_from" type="date" class="w-full rounded-lg border-slate-300 text-xs py-1.5 px-2 text-slate-800 bg-white focus:border-slate-500 focus:ring-1 focus:ring-slate-400 transition" />
                                    </div>
                                    <div v-else class="grid grid-cols-2 gap-1">
                                        <input v-model="matrixFilter.date_from" type="date" title="Dari Tanggal" class="w-full rounded-lg border-slate-300 text-xs py-1.5 px-1 text-slate-800 bg-white focus:border-slate-500 focus:ring-1 focus:ring-slate-400" />
                                        <input v-model="matrixFilter.date_to" type="date" title="Sampai Tanggal" class="w-full rounded-lg border-slate-300 text-xs py-1.5 px-1 text-slate-800 bg-white focus:border-slate-500 focus:ring-1 focus:ring-slate-400" />
                                    </div>
                                </div>

                                <!-- 4. JENIS TRAINING (MANDATORY & NON-MANDATORY) -->
                                <div>
                                    <label class="block text-[10px] font-bold uppercase tracking-wider text-slate-500 mb-1 truncate">JENIS TRAINING (MANDATORY / NON)</label>
                                    <select v-model="matrixFilter.mandatory_type" class="w-full rounded-lg border-slate-300 text-xs py-1.5 px-2 text-slate-800 bg-white focus:border-slate-500 focus:ring-1 focus:ring-slate-400 transition">
                                        <option value="">Semua (Mandatory &amp; Non)</option>
                                        <option value="mandatory">Mandatory (Wajib)</option>
                                        <option value="non_mandatory">Non-Mandatory (Pilihan)</option>
                                    </select>
                                </div>

                                <!-- 5. TRAINING INTERNAL & EXTERNAL -->
                                <div>
                                    <label class="block text-[10px] font-bold uppercase tracking-wider text-slate-500 mb-1 truncate">TRAINING INTERNAL &amp; EXTERNAL</label>
                                    <select v-model="matrixFilter.training_source" class="w-full rounded-lg border-slate-300 text-xs py-1.5 px-2 text-slate-800 bg-white focus:border-slate-500 focus:ring-1 focus:ring-slate-400 transition">
                                        <option value="">Semua (Internal &amp; External)</option>
                                        <option value="internal">Training Internal</option>
                                        <option value="external">Training External</option>
                                    </select>
                                </div>

                                <!-- 6. KODE TRAINING -->
                                <div>
                                    <label class="block text-[10px] font-bold uppercase tracking-wider text-slate-500 mb-1 truncate">KODE TRAINING</label>
                                    <select v-model="matrixFilter.course_code" class="w-full rounded-lg border-slate-300 text-xs py-1.5 px-2 text-slate-800 bg-white focus:border-slate-500 focus:ring-1 focus:ring-slate-400 font-medium transition">
                                        <option value="">Semua Kode Training</option>
                                        <option v-for="c in courses" :key="c.id" :value="c.code">[{{ c.code }}] {{ c.title }}</option>
                                    </select>
                                </div>
                            </div>

                            <!-- BARIS 3: ATRIBUT EKSTENSI MDKA GROUP (SITE TAMBANG & JOB GRADE) -->
                            <div class="pt-2 border-t border-slate-100 grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-2.5 items-end">
                                <div>
                                    <label class="block text-[10px] font-bold uppercase tracking-wider text-slate-500 mb-1 truncate">SITE / LOKASI TAMBANG</label>
                                    <select v-model="matrixFilter.site" class="w-full rounded-lg border-slate-300 text-xs py-1.5 px-2 text-slate-800 bg-white focus:border-slate-500 focus:ring-1 focus:ring-slate-400 transition">
                                        <option value="">Semua Site / Entitas</option>
                                        <option v-for="s in sites" :key="s" :value="s">{{ s }}</option>
                                    </select>
                                </div>
                                <div>
                                    <label class="block text-[10px] font-bold uppercase tracking-wider text-slate-500 mb-1 truncate">LEVEL JABATAN (GRADE)</label>
                                    <select v-model="matrixFilter.job_level" class="w-full rounded-lg border-slate-300 text-xs py-1.5 px-2 text-slate-800 bg-white focus:border-slate-500 focus:ring-1 focus:ring-slate-400 transition">
                                        <option value="">Semua Level Jabatan</option>
                                        <option v-for="lvl in jobLevels" :key="lvl" :value="lvl">{{ lvl }}</option>
                                    </select>
                                </div>
                            </div>
                        </div>

                        <!-- Legenda 4 Warna Status Kompetensi & Masa Berlaku -->
                        <div class="bg-white border border-slate-200 rounded-xl px-4 py-3 mb-4 flex flex-wrap items-center justify-between gap-3 text-xs shadow-sm">
                            <div>
                                <span class="font-bold text-slate-800">Indikator Kepatuhan Skill Matrix &amp; Masa Berlaku Sertifikat (valid_until):</span>
                            </div>
                            <div class="flex flex-wrap items-center gap-2 text-[11px] font-semibold">
                                <span class="px-2.5 py-1 rounded-md bg-emerald-100 text-emerald-800 border border-emerald-200">
                                    Hijau: Kompeten &amp; Aktif
                                </span>
                                <span class="px-2.5 py-1 rounded-md bg-amber-100 text-amber-800 border border-amber-300">
                                    Kuning: Warning H-60 (Wajib Refreshment)
                                </span>
                                <span class="px-2.5 py-1 rounded-md bg-rose-100 text-rose-900 border border-rose-300">
                                    Merah Tua: Sertifikat EXPIRED (Gugur)
                                </span>
                                <span class="px-2.5 py-1 rounded-md bg-slate-100 text-slate-600 border border-slate-200">
                                    Abu/Merah Muda: Skill Gap (Current &lt; Target)
                                </span>
                            </div>
                        </div>

                        <div class="bg-white border border-slate-200 rounded-xl overflow-hidden shadow-sm">
                            <div class="overflow-x-auto relative">
                                <table class="w-full border-collapse text-xs sm:text-sm">
                                    <thead>
                                        <tr class="bg-slate-100 text-slate-700 border-b border-slate-200">
                                            <th class="sticky left-0 z-20 bg-slate-100 py-3.5 px-4 text-left font-bold min-w-[250px] max-w-[250px] border-r border-slate-200 shadow-[2px_0_5px_-2px_rgba(15,23,42,0.08)]">
                                                Peserta & Departemen (Sticky)
                                            </th>
                                            <th v-for="s in skills" :key="s.id" class="py-3.5 px-3 text-center font-semibold min-w-[145px] border-r border-slate-200/80">
                                                <div class="text-[10px] font-bold text-blue-600 uppercase">{{ s.code }}</div>
                                                <div class="text-xs text-slate-800 font-semibold line-clamp-2 mt-0.5">{{ s.name }}</div>
                                                <div class="text-[10px] text-slate-500 font-normal mt-0.5">{{ s.category }}</div>
                                            </th>
                                        </tr>
                                    </thead>
                                    <tbody class="divide-y divide-slate-200">
                                        <tr v-for="p in filteredMatrixParticipants" :key="p.id" class="group hover:bg-slate-50">
                                            <td class="sticky left-0 z-10 bg-white group-hover:bg-slate-50 py-2.5 px-4 border-r border-slate-200 shadow-[2px_0_5px_-2px_rgba(0,0,0,0.06)]">
                                                <div class="font-bold text-slate-900 truncate" :title="p.name">{{ p.name }}</div>
                                                <div class="text-[11px] text-slate-500 mt-0.5">
                                                    <span class="font-mono text-slate-600">{{ p.nik }}</span> • {{ p.department }}
                                                </div>
                                            </td>
                                            <td v-for="s in skills" :key="s.id" class="p-1.5 border-r border-slate-100 text-center">
                                                <button
                                                    @click="openCellEditor(p, s)"
                                                    :title="p.skills_map[s.id].cert_no ? 'No Sertifikat: ' + p.skills_map[s.id].cert_no : 'Klik untuk ubah nilai kompetensi'"
                                                    :class="[
                                                        'w-full py-2 px-2 rounded-lg border text-center transition-all cursor-pointer flex flex-col items-center justify-center',
                                                        p.skills_map[s.id].status === 'valid'
                                                            ? 'bg-emerald-50 hover:bg-emerald-100 text-emerald-900 border-emerald-200'
                                                            : p.skills_map[s.id].status === 'warning_h60'
                                                                ? 'bg-amber-50 hover:bg-amber-100 text-amber-900 border-amber-300 animate-pulse'
                                                                : p.skills_map[s.id].status === 'expired'
                                                                    ? 'bg-rose-100 hover:bg-rose-200 text-rose-900 border-rose-400'
                                                                    : 'bg-rose-50/40 hover:bg-slate-100 text-slate-500 border-slate-200'
                                                    ]"
                                                >
                                                    <div class="text-xs font-extrabold" :class="p.skills_map[s.id].status === 'expired' ? 'line-through text-rose-700' : ''">
                                                        {{ p.skills_map[s.id].current_level }} <span class="opacity-50 font-normal">/</span> {{ p.skills_map[s.id].target_level }}
                                                    </div>
                                                    <div v-if="p.skills_map[s.id].status === 'expired'" class="text-[9px] font-extrabold text-rose-800 uppercase mt-0.5">
                                                        EXPIRED ({{ p.skills_map[s.id].valid_until }})
                                                    </div>
                                                    <div v-else-if="p.skills_map[s.id].status === 'warning_h60'" class="text-[9px] font-bold text-amber-800 mt-0.5">
                                                        H-{{ p.skills_map[s.id].days_left }} ({{ p.skills_map[s.id].valid_until }})
                                                    </div>
                                                    <div v-else-if="p.skills_map[s.id].status === 'valid' && p.skills_map[s.id].valid_until" class="text-[9px] text-emerald-700 mt-0.5">
                                                        s/d {{ p.skills_map[s.id].valid_until }}
                                                    </div>
                                                    <div v-else class="text-[9px] font-semibold text-rose-600 mt-0.5">
                                                        Gap: {{ p.skills_map[s.id].current_level - p.skills_map[s.id].target_level }}
                                                    </div>
                                                </button>
                                            </td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>

                        <!-- Modal Update Nilai Kompetensi (Calm Light Header) -->
                        <div v-if="cellModal.open" class="fixed inset-0 z-50 bg-slate-800/40 backdrop-blur-[2px] flex items-center justify-center p-4" @click.self="cellModal.open = false">
                            <div class="bg-white border border-slate-200 rounded-xl w-full max-w-md shadow-xl overflow-hidden">
                                <div class="px-5 py-3.5 bg-blue-50/80 border-b border-blue-100 text-slate-800 flex items-center justify-between">
                                    <div>
                                        <div class="text-[10px] uppercase tracking-wider text-blue-600 font-bold">Update Penilaian Kompetensi</div>
                                        <h3 class="text-sm font-bold text-slate-900">{{ cellModal.participant?.name }}</h3>
                                    </div>
                                    <button @click="cellModal.open = false" class="text-slate-400 hover:text-slate-700 font-bold">✕</button>
                                </div>
                                <div class="p-5 space-y-4 text-xs">
                                    <div class="p-3 rounded bg-slate-50 border border-slate-200">
                                        <div class="font-bold text-slate-900">{{ cellModal.skill?.code }} — {{ cellModal.skill?.name }}</div>
                                        <div class="text-slate-500 mt-0.5">Departemen: {{ cellModal.participant?.department }}</div>
                                    </div>
                                    <div>
                                        <label class="block font-bold text-slate-700 mb-2">Current Level (Aktual: {{ cellModal.current_level }})</label>
                                        <div class="grid grid-cols-5 gap-2">
                                            <button v-for="lvl in [1,2,3,4,5]" :key="'c'+lvl" type="button" @click="cellModal.current_level = lvl" :class="['py-2.5 rounded border font-extrabold', cellModal.current_level === lvl ? 'bg-blue-600 text-white border-blue-600' : 'bg-white text-slate-700 border-slate-300']">
                                                Lv. {{ lvl }}
                                            </button>
                                        </div>
                                    </div>
                                    <div>
                                        <label class="block font-bold text-slate-700 mb-2">Target Level Standar (Target: {{ cellModal.target_level }})</label>
                                        <div class="grid grid-cols-5 gap-2">
                                            <button v-for="lvl in [1,2,3,4,5]" :key="'t'+lvl" type="button" @click="cellModal.target_level = lvl" :class="['py-2 rounded border font-semibold', cellModal.target_level === lvl ? 'bg-slate-800 text-white border-slate-800' : 'bg-white text-slate-600 border-slate-300']">
                                                Target {{ lvl }}
                                            </button>
                                        </div>
                                    </div>
                                    <div class="flex justify-end gap-2 pt-2 border-t border-slate-200">
                                        <button @click="cellModal.open = false" class="px-3.5 py-2 rounded border border-slate-300 font-semibold">Batal</button>
                                        <button @click="saveCellEditor" class="px-4 py-2 rounded bg-blue-600 text-white font-semibold hover:bg-blue-700">Simpan Perubahan</button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- VIEW 1C: STATELESS ROTATING QR PROJECTOR (15-Second HMAC-SHA256) -->
                    <div v-else-if="currentView === 'admin-projector'">
                        <div :class="['rounded-md p-4 mb-6 flex flex-wrap items-center justify-between gap-4 border', isProjectorFullscreen ? 'bg-slate-900 border-slate-800' : 'bg-white border-slate-200']">
                            <div class="flex flex-wrap items-center gap-3">
                                <label class="text-xs font-bold uppercase text-slate-400">Pilih Sesi:</label>
                                <select v-model="activeSessionId" class="rounded text-xs py-2 px-3 font-semibold border border-slate-300 text-slate-800">
                                    <option v-for="s in sessions" :key="s.id" :value="s.id">
                                        [{{ s.course_code }}] {{ s.title }} ({{ s.short_date }}) {{ s.is_active ? '• AKTIF' : '• TUTUP' }}
                                    </option>
                                </select>
                                <button @click="rotateNow" class="px-3 py-2 rounded bg-blue-600 hover:bg-blue-700 text-white text-xs font-semibold">
                                    ↻ Rotasi QR Sekarang
                                </button>
                            </div>
                            <div class="flex items-center gap-2.5">
                                <span class="inline-flex items-center gap-2 px-3 py-1.5 rounded text-xs font-semibold bg-emerald-500/10 text-emerald-600 border border-emerald-500/30">
                                    <span class="w-2 h-2 rounded-full bg-emerald-500 animate-ping"></span>
                                    Live Sync (3s / 15s)
                                </span>
                                <button @click="isProjectorFullscreen = !isProjectorFullscreen" class="px-3.5 py-1.5 rounded bg-slate-800 hover:bg-slate-700 text-white text-xs font-semibold">
                                    {{ isProjectorFullscreen ? 'Keluar Mode Proyektor' : '⛶ Mode Layar Proyektor Penuh' }}
                                </button>
                            </div>
                        </div>

                        <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">
                            <div :class="['lg:col-span-5 rounded-md p-6 border flex flex-col items-center text-center', isProjectorFullscreen ? 'bg-slate-900 border-slate-800' : 'bg-white border-slate-200']">
                                <div class="flex items-center gap-2">
                                    <span class="px-2.5 py-0.5 rounded text-xs font-bold bg-blue-600 text-white">{{ activeSession.course_code }}</span>
                                    <span class="px-2 py-0.5 rounded text-[10px] font-mono font-semibold bg-slate-100 text-slate-700 border">Window #{{ dynamicQrPayload.time_window }}</span>
                                </div>
                                <h2 class="mt-2 text-lg font-extrabold">{{ activeSession.title }}</h2>
                                <p class="text-xs text-slate-400">{{ activeSession.course_title }}</p>

                                <!-- Native SVG Rotating QR Code -->
                                <div class="my-4 p-4 bg-white rounded-lg border-4 border-slate-900 shadow-sm inline-block">
                                    <svg viewBox="0 0 29 29" class="w-56 h-56 sm:w-64 sm:h-64" shape-rendering="crispEdges">
                                        <rect x="0" y="0" width="29" height="29" fill="#ffffff" />
                                        <template v-for="(row, rIdx) in projectorQrMatrix" :key="'r'+rIdx">
                                            <template v-for="(cell, cIdx) in row" :key="'c'+rIdx+'-'+cIdx">
                                                <rect v-if="cell === 1" :x="cIdx + 2" :y="rIdx + 2" width="1" height="1" fill="#0f172a" />
                                            </template>
                                        </template>
                                    </svg>
                                </div>

                                <!-- Native SVG 15-Second Countdown Bar -->
                                <div class="w-full max-w-xs mb-4">
                                    <div class="flex items-center justify-between text-xs mb-1.5">
                                        <span class="font-semibold text-slate-400">Rotasi QR Berikutnya (Stateless):</span>
                                        <span :class="['font-mono font-extrabold', rotationCountdown <= 4 ? 'text-amber-500' : 'text-blue-500']">{{ rotationCountdown }} detik</span>
                                    </div>
                                    <svg viewBox="0 0 300 10" class="w-full h-2.5 rounded overflow-hidden">
                                        <rect x="0" y="0" width="300" height="10" fill="#e2e8f0" rx="5" />
                                        <rect x="0" y="0" :width="(rotationCountdown / 15) * 300" height="10" :fill="rotationCountdown <= 4 ? '#f59e0b' : '#2563eb'" rx="5" class="transition-all duration-700 ease-linear" />
                                    </svg>
                                </div>

                                <!-- 6-Digit Dynamic PIN -->
                                <div class="w-full max-w-xs p-3.5 rounded bg-slate-100 border border-slate-200 text-slate-900">
                                    <div class="text-[10px] font-bold uppercase tracking-wider text-slate-500">Kode PIN Manual 6-Digit (Berubah Tiap 15d)</div>
                                    <div class="text-2xl font-mono font-extrabold tracking-[0.25em] text-blue-700 mt-1 select-all">{{ dynamicQrPayload.manual_code }}</div>
                                    <div class="mt-1 text-[10px] font-mono text-slate-400 truncate">Payload: {{ dynamicQrPayload.payload }}</div>
                                </div>

                                <button
                                    @click="fillCurrentPin(); currentView = 'mobile-scan'"
                                    class="mt-4 w-full max-w-xs py-2 px-3 rounded bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-bold"
                                >
                                    📱 Simulasikan Scan QR Ini dari HP Peserta →
                                </button>
                            </div>

                            <div :class="['lg:col-span-7 rounded-md p-6 border flex flex-col', isProjectorFullscreen ? 'bg-slate-900 border-slate-800' : 'bg-white border-slate-200']">
                                <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 mb-5 text-slate-800">
                                    <div class="p-3 rounded border bg-slate-50">
                                        <div class="text-[10px] font-bold uppercase text-slate-400">Terdaftar</div>
                                        <div class="text-xl font-extrabold mt-0.5">18</div>
                                    </div>
                                    <div class="p-3 rounded border border-emerald-200 bg-emerald-50">
                                        <div class="text-[10px] font-bold uppercase text-emerald-700">Sudah Hadir</div>
                                        <div class="text-xl font-extrabold text-emerald-700 mt-0.5">{{ attendanceLogs.length }}</div>
                                    </div>
                                    <div class="p-3 rounded border border-amber-200 bg-amber-50">
                                        <div class="text-[10px] font-bold uppercase text-amber-700">Belum Scan</div>
                                        <div class="text-xl font-extrabold text-amber-700 mt-0.5">{{ Math.max(0, 18 - attendanceLogs.length) }}</div>
                                    </div>
                                    <div class="p-3 rounded border border-blue-200 bg-blue-50">
                                        <div class="text-[10px] font-bold uppercase text-blue-700">Persentase</div>
                                        <div class="text-xl font-extrabold text-blue-700 mt-0.5">{{ Math.round((attendanceLogs.length / 18) * 100) }}%</div>
                                    </div>
                                </div>

                                <div class="flex items-center justify-between mb-3">
                                    <h3 class="text-sm font-bold">Log Kehadiran Masuk ({{ attendanceLogs.length }} Peserta)</h3>
                                    <span class="text-[11px] text-slate-400">Partial Reload tiap 3d • QR Rotasi tiap 15d</span>
                                </div>

                                <div class="flex-1 overflow-y-auto max-h-[380px] border border-slate-200 rounded text-slate-800 bg-white">
                                    <table class="w-full text-left border-collapse text-xs">
                                        <thead class="bg-slate-100 text-slate-600 sticky top-0">
                                            <tr>
                                                <th class="py-2.5 px-3">Waktu Scan</th>
                                                <th class="py-2.5 px-3">Nama & NIK Peserta</th>
                                                <th class="py-2.5 px-3">Departemen</th>
                                                <th class="py-2.5 px-3 text-right">Status</th>
                                            </tr>
                                        </thead>
                                        <tbody class="divide-y divide-slate-200">
                                            <tr v-for="att in attendanceLogs" :key="att.id" class="hover:bg-slate-50">
                                                <td class="py-2.5 px-3 font-mono font-semibold text-blue-600">{{ att.scanned_at }}</td>
                                                <td class="py-2.5 px-3">
                                                    <div class="font-bold text-slate-900">{{ att.name }}</div>
                                                    <div class="text-[11px] text-slate-400 font-mono">{{ att.nik }}</div>
                                                </td>
                                                <td class="py-2.5 px-3 text-slate-500">{{ att.department }}</td>
                                                <td class="py-2.5 px-3 text-right">
                                                    <span class="px-2 py-0.5 rounded text-[10px] font-bold uppercase bg-emerald-100 text-emerald-800">{{ att.status }}</span>
                                                </td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- VIEW 1D: ENROLLMENTS & CHECKLIST PROGRESS MODUL (dengan Global Multi-Attribute Filter Bar) -->
                    <div v-else-if="currentView === 'admin-enrollments'">
                        <!-- Header & Tombol Tambah Training Baru -->
                        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 bg-white border border-slate-200 rounded-xl p-4 mb-4 shadow-sm">
                            <div>
                                <h1 class="text-base font-bold text-slate-800">
                                    Pusat Administrasi Pelatihan &amp; Buku Induk Sertifikat
                                </h1>
                                <p class="text-xs text-slate-500 mt-0.5">
                                    Kelola pendaftaran, progress modul, kelulusan massal, dan pembuatan program pelatihan berelasi kompetensi
                                </p>
                            </div>
                            <div class="flex items-center gap-2">
                                <button v-if="activeRoleSim === 'lnd'" @click="openCreateCourseModal" class="px-3.5 py-2 rounded-lg bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-bold shadow-sm">
                                    + Tambah Program Training
                                </button>
                            </div>
                        </div>

                        <div class="bg-white border border-slate-200 rounded-xl p-3 sm:p-4 mb-4 shadow-sm space-y-3">
                            <!-- BARIS 1: Pencarian Cepat Global, Reset & Export CSV -->
                            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2.5">
                                <div class="relative flex-1 max-w-xl">
                                    <input
                                        v-model="enrollmentFilter.search"
                                        type="search"
                                        placeholder="Cari Nama, NIK, Kode/Judul Training, No. Sertifikat..."
                                        class="w-full rounded-lg border-slate-300 text-xs py-1.5 pl-8 pr-3 text-slate-800 placeholder-slate-400 focus:border-slate-500 focus:ring-1 focus:ring-slate-400 transition"
                                    />
                                    <svg class="w-3.5 h-3.5 text-slate-400 absolute left-2.5 top-1/2 -translate-y-1/2 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-4.35-4.35m1.85-5.15a7 7 0 11-14 0 7 7 0 0114 0z"/>
                                    </svg>
                                </div>
                                <div class="flex items-center gap-2 shrink-0">
                                    <button
                                        type="button"
                                        @click="resetEnrollmentFilters"
                                        class="inline-flex items-center gap-1.5 px-2.5 py-1.5 rounded-lg bg-slate-100 hover:bg-rose-50 text-slate-600 hover:text-rose-700 border border-slate-200 text-xs font-semibold transition"
                                    >
                                        <span class="text-rose-500 font-bold">✕</span>
                                        <span>Reset Filter</span>
                                    </button>
                                </div>
                            </div>

                            <!-- BARIS 2: 6 ATRIBUT FILTER UTAMA (DEPARTEMENT, PERUSAHAAN, BULAN, JENIS TRAINING, INTERNAL/EXTERNAL, KODE TRAINING) -->
                            <div class="pt-2.5 border-t border-slate-100 grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 xl:grid-cols-6 gap-2.5">
                                <!-- 1. DEPARTEMENT -->
                                <div>
                                    <label class="block text-[10px] font-bold uppercase tracking-wider text-slate-500 mb-1 truncate">DEPARTEMENT</label>
                                    <select v-model="enrollmentFilter.department" class="w-full rounded-lg border-slate-300 text-xs py-1.5 px-2 text-slate-800 bg-white focus:border-slate-500 focus:ring-1 focus:ring-slate-400 transition">
                                        <option value="">Semua Departemen</option>
                                        <option v-for="d in departments" :key="d" :value="d">{{ d }}</option>
                                    </select>
                                </div>

                                <!-- 2. PERUSAHAAN -->
                                <div>
                                    <label class="block text-[10px] font-bold uppercase tracking-wider text-slate-500 mb-1 truncate">PERUSAHAAN</label>
                                    <select v-model="enrollmentFilter.company" class="w-full rounded-lg border-slate-300 text-xs py-1.5 px-2 text-slate-800 bg-white focus:border-slate-500 focus:ring-1 focus:ring-slate-400 transition">
                                        <option value="">Semua Perusahaan</option>
                                        <option v-for="comp in companies" :key="comp" :value="comp">{{ comp }}</option>
                                    </select>
                                </div>

                                <!-- 3. BULAN (dengan Switcher Bulan / Hari / Rentang) -->
                                <div>
                                    <div class="flex items-center justify-between mb-1">
                                        <label class="block text-[10px] font-bold uppercase tracking-wider text-slate-500 truncate">BULAN</label>
                                        <div class="inline-flex rounded bg-slate-100 p-0.5 border border-slate-200 text-[9px] font-semibold">
                                            <button type="button" @click="enrollmentFilter.date_mode = 'month'" :class="['px-1 py-0.2 rounded transition', enrollmentFilter.date_mode === 'month' ? 'bg-slate-700 text-white shadow-xs' : 'text-slate-600 hover:text-slate-900']">Bulan</button>
                                            <button type="button" @click="enrollmentFilter.date_mode = 'single'" :class="['px-1 py-0.2 rounded transition', enrollmentFilter.date_mode === 'single' ? 'bg-slate-700 text-white shadow-xs' : 'text-slate-600 hover:text-slate-900']">Hari</button>
                                            <button type="button" @click="enrollmentFilter.date_mode = 'range'" :class="['px-1 py-0.2 rounded transition', enrollmentFilter.date_mode === 'range' ? 'bg-slate-700 text-white shadow-xs' : 'text-slate-600 hover:text-slate-900']">Rentang</button>
                                        </div>
                                    </div>
                                    <div v-if="enrollmentFilter.date_mode === 'month'">
                                        <input v-model="enrollmentFilter.month" type="month" class="w-full rounded-lg border-slate-300 text-xs py-1.5 px-2 text-slate-800 bg-white focus:border-slate-500 focus:ring-1 focus:ring-slate-400 transition" />
                                    </div>
                                    <div v-else-if="enrollmentFilter.date_mode === 'single'">
                                        <input v-model="enrollmentFilter.date_from" type="date" class="w-full rounded-lg border-slate-300 text-xs py-1.5 px-2 text-slate-800 bg-white focus:border-slate-500 focus:ring-1 focus:ring-slate-400 transition" />
                                    </div>
                                    <div v-else class="grid grid-cols-2 gap-1">
                                        <input v-model="enrollmentFilter.date_from" type="date" title="Dari Tanggal" class="w-full rounded-lg border-slate-300 text-xs py-1.5 px-1 text-slate-800 bg-white focus:border-slate-500 focus:ring-1 focus:ring-slate-400" />
                                        <input v-model="enrollmentFilter.date_to" type="date" title="Sampai Tanggal" class="w-full rounded-lg border-slate-300 text-xs py-1.5 px-1 text-slate-800 bg-white focus:border-slate-500 focus:ring-1 focus:ring-slate-400" />
                                    </div>
                                </div>

                                <!-- 4. JENIS TRAINING (MANDATORY & NON-MANDATORY) -->
                                <div>
                                    <label class="block text-[10px] font-bold uppercase tracking-wider text-slate-500 mb-1 truncate">JENIS TRAINING (MANDATORY / NON)</label>
                                    <select v-model="enrollmentFilter.mandatory_type" class="w-full rounded-lg border-slate-300 text-xs py-1.5 px-2 text-slate-800 bg-white focus:border-slate-500 focus:ring-1 focus:ring-slate-400 transition">
                                        <option value="">Semua (Mandatory &amp; Non)</option>
                                        <option value="mandatory">Mandatory (Wajib)</option>
                                        <option value="non_mandatory">Non-Mandatory (Pilihan)</option>
                                    </select>
                                </div>

                                <!-- 5. TRAINING INTERNAL & EXTERNAL -->
                                <div>
                                    <label class="block text-[10px] font-bold uppercase tracking-wider text-slate-500 mb-1 truncate">TRAINING INTERNAL &amp; EXTERNAL</label>
                                    <select v-model="enrollmentFilter.training_source" class="w-full rounded-lg border-slate-300 text-xs py-1.5 px-2 text-slate-800 bg-white focus:border-slate-500 focus:ring-1 focus:ring-slate-400 transition">
                                        <option value="">Semua (Internal &amp; External)</option>
                                        <option value="internal">Training Internal</option>
                                        <option value="external">Training External</option>
                                    </select>
                                </div>

                                <!-- 6. KODE TRAINING -->
                                <div>
                                    <label class="block text-[10px] font-bold uppercase tracking-wider text-slate-500 mb-1 truncate">KODE TRAINING</label>
                                    <select v-model="enrollmentFilter.course_code" class="w-full rounded-lg border-slate-300 text-xs py-1.5 px-2 text-slate-800 bg-white focus:border-slate-500 focus:ring-1 focus:ring-slate-400 font-medium transition">
                                        <option value="">Semua Kode Training</option>
                                        <option v-for="c in courses" :key="c.id" :value="c.code">[{{ c.code }}] {{ c.title }}</option>
                                    </select>
                                </div>
                            </div>

                            <!-- BARIS 3: ATRIBUT EKSTENSI MDKA GROUP (SITE, GRADE, STATUS, BIDANG) -->
                            <div class="pt-2 border-t border-slate-100 grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-2.5 items-end">
                                <div>
                                    <label class="block text-[10px] font-bold uppercase tracking-wider text-slate-500 mb-1 truncate">SITE / LOKASI TAMBANG</label>
                                    <select v-model="enrollmentFilter.site" class="w-full rounded-lg border-slate-300 text-xs py-1.5 px-2 text-slate-800 bg-white focus:border-slate-500 focus:ring-1 focus:ring-slate-400 transition">
                                        <option value="">Semua Site / Entitas</option>
                                        <option v-for="s in sites" :key="s" :value="s">{{ s }}</option>
                                    </select>
                                </div>
                                <div>
                                    <label class="block text-[10px] font-bold uppercase tracking-wider text-slate-500 mb-1 truncate">LEVEL JABATAN (GRADE)</label>
                                    <select v-model="enrollmentFilter.job_level" class="w-full rounded-lg border-slate-300 text-xs py-1.5 px-2 text-slate-800 bg-white focus:border-slate-500 focus:ring-1 focus:ring-slate-400 transition">
                                        <option value="">Semua Level Jabatan</option>
                                        <option v-for="lvl in jobLevels" :key="lvl" :value="lvl">{{ lvl }}</option>
                                    </select>
                                </div>
                                <div>
                                    <label class="block text-[10px] font-bold uppercase tracking-wider text-slate-500 mb-1 truncate">STATUS PENDAFTARAN</label>
                                    <select v-model="enrollmentFilter.status" class="w-full rounded-lg border-slate-300 text-xs py-1.5 px-2 text-slate-800 bg-white focus:border-slate-500 focus:ring-1 focus:ring-slate-400">
                                        <option value="">Semua Status</option>
                                        <option value="pending">Pending</option>
                                        <option value="approved">Approved</option>
                                        <option value="rejected">Rejected</option>
                                    </select>
                                </div>
                                <div>
                                    <label class="block text-[10px] font-bold uppercase tracking-wider text-slate-500 mb-1 truncate">BIDANG TRAINING</label>
                                    <select v-model="enrollmentFilter.training_category" class="w-full rounded-lg border-slate-300 text-xs py-1.5 px-2 text-slate-800 bg-white focus:border-slate-500 focus:ring-1 focus:ring-slate-400">
                                        <option value="">Semua Bidang</option>
                                        <option v-for="cat in trainingCategories" :key="cat" :value="cat">{{ cat }}</option>
                                    </select>
                                </div>
                            </div>
                        </div>

                        <div class="bg-white border border-slate-200 rounded-xl overflow-hidden shadow-sm">
                            <div class="overflow-x-auto">
                                <table class="w-full border-collapse text-xs sm:text-sm">
                                    <thead>
                                        <tr class="bg-slate-100 text-slate-700 border-b border-slate-200">
                                            <th class="sticky left-0 z-10 bg-slate-100 py-3.5 px-4 text-left min-w-[220px] border-r border-slate-200">Peserta & Departemen</th>
                                            <th class="py-3.5 px-3 text-center min-w-[160px] border-r border-slate-200">Status & Approval</th>
                                            <th class="py-3.5 px-3 text-center min-w-[120px] border-r border-slate-200">Progres Kelas</th>
                                            <th v-for="mod in activeEnrollmentCourse.modules" :key="mod.id" class="py-3.5 px-3 text-center min-w-[150px] border-r border-slate-200">
                                                <div class="text-[10px] text-blue-600 font-bold uppercase">Modul {{ mod.order_index }}</div>
                                                <div class="text-[11px] text-slate-800 font-semibold line-clamp-2 mt-0.5">{{ mod.title }}</div>
                                            </th>
                                        </tr>
                                    </thead>
                                    <tbody class="divide-y divide-slate-200">
                                        <tr v-for="enr in filteredEnrollments" :key="enr.id" class="group hover:bg-slate-50">
                                            <td class="sticky left-0 z-10 bg-white group-hover:bg-slate-50 py-3 px-4 border-r border-slate-200">
                                                <div class="font-bold text-slate-900">{{ enr.user.name }}</div>
                                                <div class="text-[11px] text-slate-500 font-mono">{{ enr.user.nik }} • {{ enr.user.department }}</div>
                                            </td>
                                            <td class="py-3 px-3 text-center border-r border-slate-100">
                                                <div class="flex flex-col items-center gap-1.5">
                                                    <span :class="['px-2 py-0.5 rounded text-[10px] font-bold uppercase border', enr.status === 'approved' ? 'bg-emerald-50 text-emerald-700 border-emerald-200' : enr.status === 'pending' ? 'bg-amber-50 text-amber-700 border-amber-200' : 'bg-rose-50 text-rose-700 border-rose-200']">
                                                        {{ enr.status }}
                                                    </span>
                                                    <div class="flex gap-1">
                                                        <button v-if="enr.status !== 'approved'" @click="changeEnrollmentStatus(enr, 'approved')" class="px-2 py-0.5 rounded bg-emerald-600 text-white text-[10px] font-bold">Approve</button>
                                                        <button v-if="enr.status !== 'rejected'" @click="changeEnrollmentStatus(enr, 'rejected')" class="px-2 py-0.5 rounded bg-rose-50 text-rose-700 border border-rose-200 text-[10px] font-bold">Reject</button>
                                                    </div>
                                                </div>
                                            </td>
                                            <td class="py-3 px-3 text-center border-r border-slate-100">
                                                <div class="text-sm font-extrabold" :class="enr.progress_percentage === 100 ? 'text-emerald-700' : 'text-blue-600'">{{ enr.progress_percentage }}%</div>
                                                <div class="w-full bg-slate-100 h-1.5 rounded mt-1 overflow-hidden">
                                                    <div :class="['h-full transition-all', enr.progress_percentage === 100 ? 'bg-emerald-500' : 'bg-blue-600']" :style="{ width: enr.progress_percentage + '%' }"></div>
                                                </div>
                                            </td>
                                            <td v-for="mod in activeEnrollmentCourse.modules" :key="mod.id" class="py-3 px-3 text-center border-r border-slate-100">
                                                <label :class="['inline-flex items-center gap-1.5 px-2.5 py-1.5 rounded border text-[11px] font-semibold select-none', enr.status !== 'approved' ? 'opacity-40 cursor-not-allowed' : enr.completed_modules[mod.id] ? 'cursor-pointer bg-emerald-50 border-emerald-200 text-emerald-800' : 'cursor-pointer bg-white border-slate-200 text-slate-600']">
                                                    <input type="checkbox" :disabled="enr.status !== 'approved'" :checked="enr.completed_modules[mod.id]" @change="toggleModuleCheck(enr, mod.id)" class="rounded border-slate-300 text-blue-600 w-3.5 h-3.5" />
                                                    <span>{{ enr.completed_modules[mod.id] ? 'Selesai' : 'Belum' }}</span>
                                                </label>
                                            </td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>

                        <!-- Modal Tambah Course Sim (Hubungkan ke Master Kompetensi) -->
                        <div v-if="courseModalSim.open" class="fixed inset-0 z-50 bg-slate-900/50 flex items-center justify-center p-4" @click.self="courseModalSim.open = false">
                            <div class="bg-white border border-slate-200 rounded-xl w-full max-w-2xl shadow-xl overflow-hidden">
                                <div class="px-5 py-3.5 bg-blue-50 border-b border-blue-100 flex items-center justify-between">
                                    <div>
                                        <div class="text-[10px] font-bold uppercase tracking-wider text-blue-600">Buat Program Training Baru</div>
                                        <h3 class="text-sm font-bold text-slate-900">Form Kurikulum Pelatihan &amp; Relasi Kompetensi</h3>
                                    </div>
                                    <button @click="courseModalSim.open = false" class="text-slate-400 hover:text-slate-700 font-bold px-2">✕</button>
                                </div>
                                <div class="p-5 space-y-3.5 text-xs max-h-[82vh] overflow-y-auto">
                                    <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
                                        <div>
                                            <label class="block font-bold text-slate-700 mb-1">Kode Training <span class="text-rose-600">*</span></label>
                                            <input v-model="courseModalSim.code" @input="courseModalSim.code = ($event.target.value || '').toUpperCase()" type="text" placeholder="CRS-2026-05" class="w-full rounded-lg border-slate-300 font-mono uppercase text-xs py-2 px-3" />
                                        </div>
                                        <div class="sm:col-span-2">
                                            <label class="block font-bold text-slate-700 mb-1">Judul Program Pelatihan <span class="text-rose-600">*</span></label>
                                            <input v-model="courseModalSim.title" type="text" placeholder="Contoh: Defensive Driving Tambang & Hauling Safety" class="w-full rounded-lg border-slate-300 text-xs py-2 px-3" />
                                        </div>
                                    </div>

                                    <!-- Bagian Relasi Master Kompetensi -->
                                    <div class="p-3.5 bg-blue-50/70 border border-blue-200 rounded-xl space-y-3">
                                        <div class="flex items-center gap-2">
                                            <span class="w-2 h-2 rounded-full bg-blue-600 inline-block"></span>
                                            <span class="font-bold text-blue-900 text-xs uppercase tracking-wider">Alur Relasi Kompetensi (Auto-Update Matrix)</span>
                                        </div>
                                        <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
                                            <div class="sm:col-span-2">
                                                <label class="block font-bold text-slate-700 mb-1">Hubungkan ke Master Kompetensi (Competency List) <span class="text-rose-600">*</span></label>
                                                <select v-model="courseModalSim.skill_id" class="w-full rounded-lg border-slate-300 text-xs py-2 px-3 font-semibold text-slate-800">
                                                    <option value="">-- Pilih Kompetensi Acuan Pusat --</option>
                                                    <option v-for="comp in skills" :key="comp.id" :value="comp.id">
                                                        [{{ comp.code }}] {{ comp.name }} ({{ comp.competency_type || comp.category }})
                                                    </option>
                                                </select>
                                                <p class="text-[10px] text-slate-500 mt-1">Peserta yang lulus training ini otomatis mendapat update level pada kompetensi di atas.</p>
                                            </div>
                                            <div>
                                                <label class="block font-bold text-slate-700 mb-1">Level yang Dianugerahkan <span class="text-rose-600">*</span></label>
                                                <select v-model="courseModalSim.granted_skill_level" class="w-full rounded-lg border-slate-300 text-xs py-2 px-3 font-bold text-blue-700">
                                                    <option :value="1">Level 1 (Novice)</option>
                                                    <option :value="2">Level 2 (Basic)</option>
                                                    <option :value="3">Level 3 (Competent)</option>
                                                    <option :value="4">Level 4 (Advanced)</option>
                                                    <option :value="5">Level 5 (Master)</option>
                                                </select>
                                                <p class="text-[10px] text-slate-500 mt-1">Nilai di Matrix: max(current, granted)</p>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="grid grid-cols-2 sm:grid-cols-4 gap-3">
                                        <div>
                                            <label class="block font-bold text-slate-700 mb-1">Bidang / Kategori</label>
                                            <select v-model="courseModalSim.training_category" class="w-full rounded-lg border-slate-300 text-xs py-2 px-2.5">
                                                <option v-for="cat in ['Safety', 'Operation', 'Plant', 'Pengawas', 'Engineering', 'Leadership', 'General']" :key="cat" :value="cat">{{ cat }}</option>
                                            </select>
                                        </div>
                                        <div>
                                            <label class="block font-bold text-slate-700 mb-1">Penyelenggara</label>
                                            <select v-model="courseModalSim.training_source" class="w-full rounded-lg border-slate-300 text-xs py-2 px-2.5">
                                                <option value="internal">Internal (PBJ)</option>
                                                <option value="external">External</option>
                                            </select>
                                        </div>
                                        <div>
                                            <label class="block font-bold text-slate-700 mb-1">Sifat Pelatihan</label>
                                            <select v-model="courseModalSim.is_mandatory" class="w-full rounded-lg border-slate-300 text-xs py-2 px-2.5">
                                                <option :value="true">Mandatory</option>
                                                <option :value="false">Non-Mandatory</option>
                                            </select>
                                        </div>
                                        <div>
                                            <label class="block font-bold text-slate-700 mb-1">Masa Berlaku</label>
                                            <select v-model="courseModalSim.validity_months" class="w-full rounded-lg border-slate-300 text-xs py-2 px-2.5">
                                                <option :value="12">12 Bulan</option>
                                                <option :value="24">24 Bulan</option>
                                                <option :value="36">36 Bulan</option>
                                                <option :value="null">Permanent</option>
                                            </select>
                                        </div>
                                    </div>

                                    <div>
                                        <label class="block font-bold text-slate-700 mb-1">Deskripsi / Silabus</label>
                                        <textarea v-model="courseModalSim.description" rows="2" placeholder="Rincian materi dan standar kelulusan..." class="w-full rounded-lg border-slate-300 text-xs py-2 px-3"></textarea>
                                    </div>

                                    <div class="flex items-center justify-end gap-2 pt-3 border-t border-slate-200">
                                        <button @click="courseModalSim.open = false" class="px-3.5 py-2 rounded-lg border border-slate-300 font-semibold text-slate-700 hover:bg-slate-50">Batal</button>
                                        <button @click="saveCourseSim" class="px-4 py-2 rounded-lg bg-blue-600 hover:bg-blue-700 text-white font-bold shadow-sm">Buat Program Training</button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div v-else-if="currentView === 'competency-individual-view'" class="space-y-5">
                        <div class="bg-white border border-slate-200 rounded-xl p-4 sm:p-5 shadow-sm">
                            <div class="flex flex-col xl:flex-row xl:items-end justify-between gap-4">
                                <div>
                                    <span class="text-[10px] font-black uppercase tracking-widest text-blue-700">Kompetensi / Individual View</span>
                                    <h1 class="text-lg font-black text-slate-900 mt-1">Individual Training View per Karyawan</h1>
                                    <p class="text-xs text-slate-500 mt-1">Telusuri riwayat dan kepatuhan pelatihan dari katalog MDKA Group.</p>
                                </div>
                                <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 w-full xl:max-w-2xl">
                                    <div>
                                        <label class="block text-[10px] font-bold uppercase tracking-wider text-slate-500 mb-1">Cari NIK / Nama</label>
                                        <input v-model="individualSearch" type="search" placeholder="Ketik NIK atau nama karyawan" class="w-full rounded-lg border-slate-300 text-xs py-2 px-3" />
                                    </div>
                                    <div>
                                        <label class="block text-[10px] font-bold uppercase tracking-wider text-slate-500 mb-1">Select NIK / ID Employee</label>
                                        <select v-model="selectedIndividualUserId" class="w-full rounded-lg border-slate-300 text-xs py-2 px-3">
                                            <option v-for="person in individualParticipants" :key="person.id" :value="person.id">[{{ person.nik }}] {{ person.name }}</option>
                                        </select>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div v-if="selectedIndividualUser" class="space-y-5">
                            <div class="bg-white border border-slate-200 rounded-xl p-5 shadow-sm">
                                <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-4 border-b border-slate-100 pb-4 mb-4">
                                    <div class="flex items-center gap-3">
                                        <div class="w-12 h-12 rounded-full bg-blue-700 text-white font-black text-lg flex items-center justify-center">{{ selectedIndividualUser.name.charAt(0) }}</div>
                                        <div>
                                            <h2 class="text-base font-black text-slate-900">{{ selectedIndividualUser.name }}</h2>
                                            <p class="text-xs font-mono text-slate-500 mt-0.5">NIK: <strong class="text-slate-800">{{ selectedIndividualUser.nik }}</strong></p>
                                        </div>
                                    </div>
                                    <span :class="selectedIndividualUser.job_level ? 'bg-emerald-50 text-emerald-800 border-emerald-200' : 'bg-rose-50 text-rose-800 border-rose-200'" class="px-3 py-1.5 rounded-full text-xs font-bold border">
                                        {{ selectedIndividualUser.job_level ? 'Matched Title+Level' : 'No Match' }}
                                    </span>
                                </div>
                                <div class="grid grid-cols-2 sm:grid-cols-4 xl:grid-cols-8 gap-2.5 text-xs">
                                    <div class="bg-slate-50 p-2.5 rounded-lg border border-slate-100"><span class="block text-[10px] uppercase font-bold text-slate-400">Departemen</span><strong class="block mt-1 truncate">{{ selectedIndividualUser.department }}</strong></div>
                                    <div class="bg-slate-50 p-2.5 rounded-lg border border-slate-100"><span class="block text-[10px] uppercase font-bold text-slate-400">Section</span><strong class="block mt-1 truncate">{{ selectedIndividualUser.department }} Section</strong></div>
                                    <div class="bg-slate-50 p-2.5 rounded-lg border border-slate-100"><span class="block text-[10px] uppercase font-bold text-slate-400">Posisi</span><strong class="block mt-1 truncate">{{ selectedIndividualUser.job_level }} - {{ selectedIndividualUser.department }}</strong></div>
                                    <div class="bg-slate-50 p-2.5 rounded-lg border border-slate-100"><span class="block text-[10px] uppercase font-bold text-slate-400">Level</span><strong class="block mt-1 truncate">{{ selectedIndividualUser.job_level }}</strong></div>
                                    <div class="bg-slate-50 p-2.5 rounded-lg border border-slate-100"><span class="block text-[10px] uppercase font-bold text-slate-400">Site</span><strong class="block mt-1 truncate">{{ selectedIndividualUser.site }}</strong></div>
                                    <div class="bg-slate-50 p-2.5 rounded-lg border border-slate-100"><span class="block text-[10px] uppercase font-bold text-slate-400">Entity</span><strong class="block mt-1 truncate">{{ selectedIndividualUser.org_type === 'contractor' ? 'Contractor' : 'MDKA' }}</strong></div>
                                    <div class="bg-slate-50 p-2.5 rounded-lg border border-slate-100"><span class="block text-[10px] uppercase font-bold text-slate-400">Match Status</span><strong class="block mt-1 truncate text-emerald-700">Matched Title+Level</strong></div>
                                    <div class="bg-slate-50 p-2.5 rounded-lg border border-slate-100"><span class="block text-[10px] uppercase font-bold text-slate-400">Total Training</span><strong class="block mt-1 truncate">{{ individualTrainingRows.length }}</strong></div>
                                </div>
                            </div>

                            <div class="grid grid-cols-2 xl:grid-cols-4 gap-3">
                                <div class="bg-emerald-50 border border-emerald-200 rounded-xl p-4"><div class="text-[10px] font-bold uppercase text-emerald-800">Completed</div><div class="text-3xl font-black text-emerald-700 mt-1">{{ individualTrainingSummary.completed }}</div></div>
                                <div class="bg-amber-50 border border-amber-200 rounded-xl p-4"><div class="text-[10px] font-bold uppercase text-amber-800">Not Yet</div><div class="text-3xl font-black text-amber-700 mt-1">{{ individualTrainingSummary.not_yet }}</div></div>
                                <div class="bg-rose-50 border border-rose-200 rounded-xl p-4"><div class="text-[10px] font-bold uppercase text-rose-800">Expired</div><div class="text-3xl font-black text-rose-700 mt-1">{{ individualTrainingSummary.expired }}</div></div>
                                <div class="bg-slate-100 border border-slate-200 rounded-xl p-4"><div class="text-[10px] font-bold uppercase text-slate-700">Not Required (N/A)</div><div class="text-3xl font-black text-slate-800 mt-1">{{ individualTrainingSummary.not_required }}</div></div>
                            </div>

                            <div class="bg-white border border-slate-200 rounded-xl overflow-hidden shadow-sm">
                                <div class="p-4 flex flex-col sm:flex-row sm:items-center justify-between gap-3 border-b border-slate-100">
                                    <div><h2 class="text-sm font-black text-slate-900">Riwayat 182 Kompetensi &amp; Training</h2><p class="text-[11px] text-slate-500 mt-1">Status requirement, masa berlaku sertifikat, dan pendaftaran cepat.</p></div>
                                    <input v-model="individualTrainingFilter" type="search" placeholder="Cari kode / judul / status" class="w-full sm:max-w-xs rounded-lg border-slate-300 text-xs py-2 px-3" />
                                </div>
                                <div class="overflow-auto max-h-[640px]">
                                    <table class="w-full min-w-[1100px] text-left text-xs border-collapse">
                                        <thead class="sticky top-0 z-10 bg-slate-50 text-[10px] uppercase tracking-wider text-slate-600">
                                            <tr class="border-b border-slate-200">
                                                <th class="p-2.5">Kode Training</th><th class="p-2.5">Judul / Kompetensi</th><th class="p-2.5">Kategori</th><th class="p-2.5 text-center">Mandatory</th><th class="p-2.5 text-center">Status</th><th class="p-2.5 text-center">Tanggal Kedaluwarsa</th><th class="p-2.5 text-right">Aksi</th>
                                            </tr>
                                        </thead>
                                        <tbody class="divide-y divide-slate-100">
                                            <tr v-for="training in filteredIndividualTrainingRows" :key="training.id" class="hover:bg-slate-50">
                                                <td class="p-2.5 font-mono font-bold text-blue-700">{{ training.code }}</td>
                                                <td class="p-2.5 font-semibold text-slate-900">{{ training.title }}</td>
                                                <td class="p-2.5 text-slate-600">{{ training.category }}</td>
                                                <td class="p-2.5 text-center"><span class="px-2 py-0.5 rounded font-black" :class="training.requirement === 'M' ? 'bg-emerald-100 text-emerald-800' : training.requirement === 'NM' ? 'bg-amber-100 text-amber-800' : 'bg-slate-200 text-slate-700'">{{ training.requirement }}</span></td>
                                                <td class="p-2.5 text-center">{{ training.completion }}</td>
                                                <td class="p-2.5 text-center font-mono">{{ training.expiry }}</td>
                                                <td class="p-2.5 text-right"><button v-if="training.completion === 'Not Yet Completed' || training.completion === 'Expired'" @click="registerPreviewTraining(training)" class="px-2.5 py-1.5 rounded bg-blue-600 hover:bg-blue-700 text-white text-[10px] font-bold">Schedule / Daftarkan</button></td>
                                            </tr>
                                            <tr v-if="!filteredIndividualTrainingRows.length"><td colspan="7" class="p-6 text-center text-slate-400">Tidak ada training yang cocok dengan pencarian.</td></tr>
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                        <div v-else class="bg-white border border-slate-200 rounded-xl p-8 text-center text-sm text-slate-500">Pilih karyawan untuk membuka riwayat training.</div>
                    </div>

                    <div v-else-if="currentView === 'competency-training-summary'" class="space-y-5">
                        <div class="bg-white border border-slate-200 rounded-xl p-4 sm:p-5 shadow-sm">
                            <div class="flex flex-col lg:flex-row lg:items-end justify-between gap-3">
                                <div>
                                    <span class="text-[10px] font-black uppercase tracking-widest text-blue-700">Corporate Training Compliance</span>
                                    <h1 class="text-lg font-black text-slate-900 mt-1">Rangkuman Per Training &amp; Divisi</h1>
                                    <p class="text-xs text-slate-500 mt-1">Agregasi kepatuhan dari {{ previewTrainingCatalog.length }} training dalam katalog MDKA Group.</p>
                                </div>
                                <input v-model="trainingSummarySearch" type="search" placeholder="Cari kode / judul / divisi / karyawan" class="w-full lg:max-w-sm rounded-lg border-slate-300 text-xs py-2 px-3" />
                            </div>
                        </div>
                        <div class="flex flex-wrap gap-2 border-b border-slate-200">
                            <button @click="trainingSummaryTab = 'training_type'" :class="trainingSummaryTab === 'training_type' ? 'bg-blue-700 text-white' : 'bg-white text-slate-600 border border-slate-200'" class="px-3.5 py-2 rounded-t-lg text-xs font-bold">Rangkuman Per Jenis Training</button>
                            <button @click="trainingSummaryTab = 'divisi'" :class="trainingSummaryTab === 'divisi' ? 'bg-blue-700 text-white' : 'bg-white text-slate-600 border border-slate-200'" class="px-3.5 py-2 rounded-t-lg text-xs font-bold">Summary Per Divisi</button>
                            <button @click="trainingSummaryTab = 'emp_completion'" :class="trainingSummaryTab === 'emp_completion' ? 'bg-blue-700 text-white' : 'bg-white text-slate-600 border border-slate-200'" class="px-3.5 py-2 rounded-t-lg text-xs font-bold">Employee Completion Tracker</button>
                        </div>

                        <div v-if="trainingSummaryTab === 'training_type'" class="bg-white border border-slate-200 rounded-xl overflow-hidden shadow-sm">
                            <div class="p-3 flex flex-wrap items-center gap-2 border-b border-slate-100">
                                <span class="text-[10px] font-bold uppercase tracking-wider text-slate-500 mr-1">Jenis:</span>
                                <button v-for="source in [{id:'all',label:'Semua'},{id:'internal',label:'Internal'},{id:'external',label:'External'}]" :key="source.id" @click="trainingTypeSource = source.id" :class="trainingTypeSource === source.id ? 'bg-blue-700 text-white' : 'bg-slate-100 text-slate-600 hover:bg-slate-200'" class="px-3 py-1.5 rounded-full text-[11px] font-bold">{{ source.label }}</button>
                            </div>
                            <div class="overflow-auto max-h-[660px]">
                                <table class="w-full min-w-[1000px] text-left text-xs border-collapse">
                                    <thead class="sticky top-0 z-10 bg-slate-50 text-[10px] uppercase tracking-wider text-slate-600"><tr class="border-b border-slate-200"><th class="p-2.5">Kode Training</th><th class="p-2.5">Judul</th><th class="p-2.5">Kategori</th><th class="p-2.5 text-center">Wajib Ikut (M)</th><th class="p-2.5 text-center">Done</th><th class="p-2.5 text-center">Not Yet</th><th class="p-2.5 text-right">% Selesai</th><th class="p-2.5 text-center">Expired</th></tr></thead>
                                    <tbody class="divide-y divide-slate-100">
                                        <tr v-for="training in filteredTrainingTypeSummaryRows" :key="training.id" class="hover:bg-slate-50"><td class="p-2.5 font-mono font-bold text-blue-700">{{ training.code }}</td><td class="p-2.5 font-semibold text-slate-900">{{ training.title }}</td><td class="p-2.5">{{ training.category }}</td><td class="p-2.5 text-center">{{ training.total_required }}</td><td class="p-2.5 text-center text-emerald-700 font-bold">{{ training.completed }}</td><td class="p-2.5 text-center text-amber-700 font-bold">{{ training.not_yet }}</td><td class="p-2.5 text-right font-mono font-bold">{{ training.completion_pct }}%</td><td class="p-2.5 text-center text-rose-700 font-bold">{{ training.expired }}</td></tr>
                                        <tr v-if="!filteredTrainingTypeSummaryRows.length"><td colspan="8" class="p-6 text-center text-slate-400">Tidak ada data training untuk filter ini.</td></tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>

                        <div v-else-if="trainingSummaryTab === 'divisi'" class="bg-white border border-slate-200 rounded-xl overflow-hidden shadow-sm">
                            <div class="overflow-auto">
                                <table class="w-full min-w-[900px] text-left text-xs border-collapse">
                                    <thead class="bg-slate-50 text-[10px] uppercase tracking-wider text-slate-600"><tr class="border-b border-slate-200"><th class="p-3">Divisi</th><th class="p-3 text-center">Jumlah Karyawan</th><th class="p-3 text-center">Mandatory Internal</th><th class="p-3 text-center">Mandatory External</th><th class="p-3 text-center">Total Mandatory</th><th class="p-3 text-center">Non-Mandatory</th></tr></thead>
                                    <tbody class="divide-y divide-slate-100"><tr v-for="division in divisionSummaryRows.filter((item) => !trainingSummarySearch || item.department.toLowerCase().includes(trainingSummarySearch.toLowerCase()))" :key="division.department" class="hover:bg-slate-50"><td class="p-3 font-bold text-slate-900">{{ division.department }}</td><td class="p-3 text-center">{{ division.employee_count }}</td><td class="p-3 text-center text-blue-700 font-bold">{{ division.mandatory_internal }}</td><td class="p-3 text-center text-purple-700 font-bold">{{ division.mandatory_external }}</td><td class="p-3 text-center font-black">{{ division.total_mandatory }}</td><td class="p-3 text-center text-slate-600">{{ division.non_mandatory }}</td></tr></tbody>
                                </table>
                            </div>
                        </div>

                        <div v-else class="bg-white border border-slate-200 rounded-xl overflow-hidden shadow-sm">
                            <div class="overflow-auto max-h-[660px]">
                                <table class="w-full min-w-[1050px] text-left text-xs border-collapse">
                                    <thead class="sticky top-0 z-10 bg-slate-50 text-[10px] uppercase tracking-wider text-slate-600"><tr class="border-b border-slate-200"><th class="p-2.5">NIK</th><th class="p-2.5">Nama Karyawan</th><th class="p-2.5">Departemen</th><th class="p-2.5">Site</th><th class="p-2.5 text-center">Mandatory</th><th class="p-2.5 text-center">Completed</th><th class="p-2.5 text-center">Expired</th><th class="p-2.5 text-center">100% Fully Completed</th><th class="p-2.5 text-right">Aksi</th></tr></thead>
                                    <tbody class="divide-y divide-slate-100"><tr v-for="person in employeeCompletionRows.filter((item) => !trainingSummarySearch || [item.name, item.nik, item.department].join(' ').toLowerCase().includes(trainingSummarySearch.toLowerCase()))" :key="person.id" class="hover:bg-slate-50"><td class="p-2.5 font-mono font-bold">{{ person.nik }}</td><td class="p-2.5 font-bold text-slate-900">{{ person.name }}</td><td class="p-2.5">{{ person.department }}</td><td class="p-2.5">{{ person.site }}</td><td class="p-2.5 text-center">{{ person.mandatory_count }}</td><td class="p-2.5 text-center text-emerald-700 font-bold">{{ person.completed_count }}</td><td class="p-2.5 text-center text-rose-700 font-bold">{{ person.expired_count }}</td><td class="p-2.5 text-center"><span :class="person.fully_completed === 'YES' ? 'bg-emerald-600 text-white' : 'bg-rose-100 text-rose-800'" class="px-2 py-1 rounded font-black">{{ person.fully_completed }}</span></td><td class="p-2.5 text-right"><button @click="selectedIndividualUserId = person.id; currentView = 'competency-individual-view'" class="text-blue-700 font-bold hover:underline">Detail →</button></td></tr></tbody>
                                </table>
                            </div>
                        </div>
                    </div>

                    <!-- VIEW 1E: TRAINER COMMAND CENTER (Portal Instruktur — Trainer/Dashboard.vue) -->
                    <div v-else-if="currentView === 'trainer-command-center' || currentView === 'admin-trainer-dashboard' || currentView === 'admin-trainer-hours'" class="space-y-6">
                        <!-- 1. HEADER SAPAAN & STATUS ROSTER HARI INI -->
                        <div class="bg-white border border-slate-200 rounded-xl p-5 shadow-xs">
                            <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
                                <div class="flex items-center gap-4">
                                    <div class="w-14 h-14 rounded-xl bg-blue-600 text-white flex items-center justify-center font-extrabold text-xl uppercase shadow-xs shrink-0">
                                        {{ (activeTrainerUser?.name || 'Dr. Siti Rahmawati').charAt(0) }}
                                    </div>
                                    <div>
                                        <div class="flex flex-wrap items-center gap-2">
                                            <h2 class="text-base sm:text-lg font-bold text-slate-900">
                                                Selamat Bekerja, {{ activeTrainerUser?.name || 'Dr. Siti Rahmawati' }}!
                                            </h2>
                                            <span class="px-2.5 py-0.5 rounded-full text-[10px] font-bold bg-blue-50 text-blue-700 border border-blue-200">
                                                {{ activeTrainerUser?.trainer_type || 'INTERNAL_SME' }}
                                            </span>
                                            <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-[10px] font-bold bg-emerald-50 text-emerald-700 border border-emerald-200">
                                                <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-ping"></span>
                                                Status Roster: {{ activeTrainerUser?.today_roster?.label || 'ON DUTY' }}
                                            </span>
                                        </div>
                                        <div class="text-xs text-slate-500 font-mono mt-1">
                                            NIK: {{ activeTrainerUser?.nik || 'PANI-TR-001' }} • {{ activeTrainerUser?.email || 'siti.rahmawati@pani.co.id' }} • Departemen: {{ activeTrainerUser?.department || 'HSE & Safety Team' }}
                                        </div>
                                        <div class="text-[11px] text-slate-500 mt-0.5">
                                            Pola Kerja: <span class="font-bold text-slate-700">{{ activeTrainerUser?.roster_pattern || '5-2 (Senin - Jumat)' }}</span> • Lokasi: <span class="font-bold text-slate-700">Site PBJ Ground</span>
                                        </div>
                                    </div>
                                </div>

                                <div class="flex flex-wrap items-center gap-2 shrink-0">
                                    <button
                                        type="button"
                                        @click="openTrainerLiveQr"
                                        class="px-4 py-2.5 text-xs font-bold text-white bg-blue-600 hover:bg-blue-700 rounded-lg shadow-sm transition-all flex items-center gap-2"
                                    >
                                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v1m6 11h2m-6 0h-2v4m0-11v3m0 0h.01M12 12h4.01M16 20h4M4 12h4m12 0h.01M5 8h2a1 1 0 001-1V5a1 1 0 00-1-1H5a1 1 0 00-1 1v2a1 1 0 001 1zm12 0h2a1 1 0 001-1V5a1 1 0 00-1-1h-2a1 1 0 00-1 1v2a1 1 0 001 1zM5 20h2a1 1 0 001-1v-2a1 1 0 00-1-1H5a1 1 0 00-1 1v2a1 1 0 001 1z"></path></svg>
                                        <span>Tampilkan Barcode / QR Absen</span>
                                    </button>
                                    <button
                                        type="button"
                                        @click="currentView = 'admin-training-today'; trainingTodayTab = 'calendar'"
                                        class="px-3.5 py-2.5 text-xs font-bold text-slate-700 bg-slate-100 hover:bg-slate-200 rounded-lg transition-colors flex items-center gap-1.5"
                                    >
                                        <span>Master Kalender ATMP</span>
                                    </button>
                                </div>
                            </div>
                        </div>

                        <!-- 2. BENTO METRICS PERFORMA INSTRUKTUR -->
                        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
                            <!-- Metrik 1: Jam Mengajar -->
                            <div class="bg-white border border-slate-200 rounded-xl p-4 shadow-xs">
                                <div class="text-[11px] font-bold uppercase tracking-wider text-slate-500">Jam Mengajar Bulan Ini</div>
                                <div class="mt-2 flex items-baseline gap-2">
                                    <span class="text-2xl font-extrabold text-blue-600">{{ activeTrainerUser?.month_teaching_hours || 18.5 }}</span>
                                    <span class="text-xs font-bold text-slate-600">Jam Sah</span>
                                    <span class="ml-auto inline-flex items-center text-[11px] font-bold text-emerald-600 bg-emerald-50 px-2 py-0.5 rounded">
                                        &uarr; +23.3% MoM
                                    </span>
                                </div>
                                <p class="mt-1.5 text-[11px] text-slate-500">Bulan lalu: 15.0 Jam (terverifikasi presensi)</p>
                            </div>

                            <!-- Metrik 2: Total Peserta Terlayani -->
                            <div class="bg-white border border-slate-200 rounded-xl p-4 shadow-xs">
                                <div class="text-[11px] font-bold uppercase tracking-wider text-slate-500">Peserta Terlayani (Scan QR)</div>
                                <div class="mt-2 flex items-baseline gap-2">
                                    <span class="text-2xl font-extrabold text-emerald-600">{{ activeTrainerUser?.total_scanned_participants || 42 }}</span>
                                    <span class="text-xs font-bold text-slate-600">Karyawan</span>
                                </div>
                                <p class="mt-1.5 text-[11px] text-slate-500">Terdaftar hadir lewat barcode proyektor</p>
                            </div>

                            <!-- Metrik 3: Rating Ulasan -->
                            <div class="bg-white border border-slate-200 rounded-xl p-4 shadow-xs">
                                <div class="text-[11px] font-bold uppercase tracking-wider text-slate-500">Rata-rata Rating Ulasan</div>
                                <div class="mt-2 flex items-baseline gap-2">
                                    <span class="text-2xl font-extrabold text-amber-500">★ {{ activeTrainerUser?.average_rating || 4.88 }}</span>
                                    <span class="text-xs font-bold text-slate-600">/ 5.0</span>
                                </div>
                                <p class="mt-1.5 text-[11px] text-slate-500">Dari {{ activeTrainerUser?.evaluations_count || 36 }} ulasan jujur peserta kelas</p>
                            </div>

                            <!-- Metrik 4: Otorisasi Ajar -->
                            <div class="bg-white border border-slate-200 rounded-xl p-4 shadow-xs">
                                <div class="text-[11px] font-bold uppercase tracking-wider text-slate-500">Otorisasi Mengajar Aktif</div>
                                <div class="mt-2 flex items-baseline gap-2">
                                    <span class="text-2xl font-extrabold text-indigo-600">{{ (activeTrainerUser?.authorized_skills || []).length || 3 }}</span>
                                    <span class="text-xs font-bold text-slate-600">Kompetensi</span>
                                </div>
                                <p class="mt-1.5 text-[11px] text-slate-500">Sertifikasi ToT BNSP &amp; Kemnaker valid</p>
                            </div>
                        </div>

                        <!-- 3. TAB NAVIGASI COMMAND CENTER -->
                        <div class="bg-white border border-slate-200 rounded-xl shadow-xs overflow-hidden">
                            <div class="border-b border-slate-200 px-5 flex items-center gap-6 overflow-x-auto text-xs font-bold">
                                <button
                                    type="button"
                                    @click="trainerPortalTab = 'schedule'"
                                    class="py-3.5 border-b-2 transition-colors whitespace-nowrap flex items-center gap-2"
                                    :class="trainerPortalTab === 'schedule' ? 'border-blue-600 text-blue-600' : 'border-transparent text-slate-500 hover:text-slate-800'"
                                >
                                    <span>1. Jadwal &amp; Barcode Sesi Berjalan</span>
                                    <span class="px-2 py-0.5 rounded-full text-[10px] bg-blue-100 text-blue-800">Hari Ini</span>
                                </button>
                                <button
                                    type="button"
                                    @click="trainerPortalTab = 'kpi'"
                                    class="py-3.5 border-b-2 transition-colors whitespace-nowrap flex items-center gap-2"
                                    :class="trainerPortalTab === 'kpi' ? 'border-blue-600 text-blue-600' : 'border-transparent text-slate-500 hover:text-slate-800'"
                                >
                                    <span>2. KPI &amp; Target Ajar Program</span>
                                    <span class="px-2 py-0.5 rounded-full text-[10px] bg-slate-100 text-slate-700">Target</span>
                                </button>
                                <button
                                    type="button"
                                    @click="trainerPortalTab = 'reports'"
                                    class="py-3.5 border-b-2 transition-colors whitespace-nowrap flex items-center gap-2"
                                    :class="trainerPortalTab === 'reports' ? 'border-blue-600 text-blue-600' : 'border-transparent text-slate-500 hover:text-slate-800'"
                                >
                                    <span>3. Laporan Hasil Training &amp; Ulasan Peserta</span>
                                    <span class="px-2 py-0.5 rounded-full text-[10px] bg-amber-100 text-amber-800">★ 4.88</span>
                                </button>
                            </div>

                            <div class="p-5">
                                <!-- TAB 1: JADWAL & BARCODE SESI BERJALAN -->
                                <div v-if="trainerPortalTab === 'schedule'" class="space-y-6">
                                    <!-- SESI BERJALAN HARI INI -->
                                    <div class="rounded-xl border border-blue-200 bg-blue-50/50 p-5">
                                        <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
                                            <div>
                                                <div class="flex items-center gap-2">
                                                    <span class="px-2 py-0.5 rounded text-[10px] font-extrabold uppercase bg-emerald-600 text-white">
                                                        SESI HARI INI (LIVE)
                                                    </span>
                                                    <span class="text-xs font-bold text-blue-800">SAF-001</span>
                                                    <span class="text-xs text-slate-500 font-medium">Senin, 26 Okt 2026 • 08:30 - 11:30 WITA</span>
                                                </div>
                                                <h3 class="text-base font-bold text-slate-900 mt-1.5">
                                                    Pelatihan K3 Dasar &amp; Pengenalan Tambang Emas (Reguler PBJ)
                                                </h3>
                                                <p class="text-xs text-slate-600 mt-0.5">
                                                    Sesi 1: Penilaian Risiko &amp; SOP K3 Tambang Terbuka • Ruang Diklat Gd. Utama Lt. 2
                                                </p>
                                            </div>

                                            <div class="flex items-center gap-3 shrink-0">
                                                <button
                                                    type="button"
                                                    @click="openTrainerLiveQr"
                                                    class="px-4 py-2 text-xs font-bold text-white bg-blue-600 hover:bg-blue-700 rounded-lg shadow-sm transition-all flex items-center gap-2"
                                                >
                                                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v1m6 11h2m-6 0h-2v4m0-11v3m0 0h.01M12 12h4.01M16 20h4M4 12h4m12 0h.01M5 8h2a1 1 0 001-1V5a1 1 0 00-1-1H5a1 1 0 00-1 1v2a1 1 0 001 1zm12 0h2a1 1 0 001-1V5a1 1 0 00-1-1h-2a1 1 0 00-1 1v2a1 1 0 001 1zM5 20h2a1 1 0 001-1v-2a1 1 0 00-1-1H5a1 1 0 00-1 1v2a1 1 0 001 1z"></path></svg>
                                                    <span>Tampilkan Barcode / QR Absen</span>
                                                </button>
                                            </div>
                                        </div>

                                        <!-- PROGRESS KEHADIRAN SESI HARI INI -->
                                        <div class="mt-4 pt-4 border-t border-blue-100 flex flex-col sm:flex-row sm:items-center justify-between gap-3 text-xs">
                                            <div class="flex items-center gap-3">
                                                <span class="font-bold text-slate-700">Kehadiran Peserta:</span>
                                                <span class="font-extrabold text-blue-700">18 / 20 Hadir (90%)</span>
                                                <div class="w-32 bg-slate-200 rounded-full h-2 overflow-hidden">
                                                    <div class="bg-blue-600 h-2 rounded-full" style="width: 90%"></div>
                                                </div>
                                            </div>
                                            <div class="text-[11px] text-slate-500">
                                                Durasi Diakui: <span class="font-bold text-slate-800">3.0 Jam</span> (Status Kehadiran: <span class="text-emerald-600 font-bold">SAH</span>)
                                            </div>
                                        </div>
                                    </div>

                                    <!-- SESI MENDATANG MINGGU INI -->
                                    <div>
                                        <h4 class="text-xs font-bold text-slate-900 uppercase tracking-wider mb-3">Jadwal Sesi Mendatang Anda</h4>
                                        <div class="space-y-3">
                                            <div v-for="ev in trainerUpcomingEvents" :key="ev.id" class="p-4 rounded-lg border border-slate-200 bg-white hover:border-blue-300 transition-colors flex flex-col md:flex-row md:items-center justify-between gap-3">
                                                <div>
                                                    <div class="flex items-center gap-2">
                                                        <span class="px-2 py-0.5 rounded text-[10px] font-bold bg-slate-100 text-slate-700">{{ ev.session_date_formatted }}</span>
                                                        <span class="text-xs font-bold text-blue-600">{{ ev.course_code }}</span>
                                                        <span class="text-xs text-slate-500 font-mono">{{ ev.time_formatted }}</span>
                                                    </div>
                                                    <div class="text-xs font-bold text-slate-900 mt-1">{{ ev.course_title }}</div>
                                                    <div class="text-[11px] text-slate-500">{{ ev.session_title }} • {{ ev.room }}</div>
                                                </div>
                                                <div class="flex items-center gap-2">
                                                    <span class="px-2.5 py-1 rounded-full text-[10px] font-bold bg-amber-50 text-amber-700 border border-amber-200">
                                                        Terjadwal (Upcoming)
                                                    </span>
                                                    <button @click="openTrainerScheduleDetail(ev)" class="px-2.5 py-1 text-xs font-bold text-blue-600 bg-blue-50 hover:bg-blue-100 rounded">
                                                        Detail
                                                    </button>
                                                </div>
                                            </div>

                                            <div v-if="!trainerUpcomingEvents || trainerUpcomingEvents.length === 0" class="p-6 text-center text-xs text-slate-400 italic bg-white border border-slate-200 rounded-lg">
                                                Tidak ada jadwal sesi mengajar mendatang minggu ini.
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <!-- TAB 2: KPI & TARGET AJAR PROGRAM -->
                                <div v-else-if="trainerPortalTab === 'kpi'" class="space-y-6">
                                    <!-- PROGRESS BARS KPI -->
                                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                                        <div class="p-4 rounded-xl border border-slate-200 bg-slate-50/50">
                                            <div class="flex items-center justify-between text-xs font-bold mb-1.5">
                                                <span class="text-slate-700">Target Jam Mengajar (Bulan Oktober)</span>
                                                <span class="text-blue-700 font-extrabold">18.5 / 20.0 Jam (92.5%)</span>
                                            </div>
                                            <div class="w-full bg-slate-200 rounded-full h-2.5 overflow-hidden">
                                                <div class="bg-blue-600 h-2.5 rounded-full" style="width: 92.5%"></div>
                                            </div>
                                            <p class="text-[11px] text-slate-500 mt-2">Kurang 1.5 jam lagi untuk mencapai KPI target bulanan.</p>
                                        </div>

                                        <div class="p-4 rounded-xl border border-slate-200 bg-slate-50/50">
                                            <div class="flex items-center justify-between text-xs font-bold mb-1.5">
                                                <span class="text-slate-700">Target Peserta Dilatih</span>
                                                <span class="text-emerald-700 font-extrabold">42 / 40 Peserta (105%)</span>
                                            </div>
                                            <div class="w-full bg-slate-200 rounded-full h-2.5 overflow-hidden">
                                                <div class="bg-emerald-600 h-2.5 rounded-full" style="width: 100%"></div>
                                            </div>
                                            <p class="text-[11px] text-emerald-600 font-bold mt-2">Target peserta telah terlampaui!</p>
                                        </div>
                                    </div>

                                    <!-- DAFTAR PROGRAM PENUGASAN (BERJALAN, UPCOMING, COMPLETED) -->
                                    <div>
                                        <h4 class="text-xs font-bold text-slate-900 uppercase tracking-wider mb-3">Daftar Kursus &amp; Program yang Ditugaskan</h4>
                                        <div class="grid grid-cols-1 md:grid-cols-3 gap-3">
                                            <div v-for="c in trainerAssignedCourses" :key="c.id" class="p-4 rounded-xl border bg-white shadow-2xs" :class="c.status === 'running' ? 'border-blue-300 ring-1 ring-blue-200' : 'border-slate-200'">
                                                <div class="flex items-center justify-between">
                                                    <span class="text-xs font-bold text-blue-600">{{ c.code }}</span>
                                                    <span :class="c.status === 'running' ? 'bg-blue-50 text-blue-700 border-blue-200' : c.status === 'upcoming' ? 'bg-amber-50 text-amber-700 border-amber-200' : 'bg-emerald-50 text-emerald-700 border-emerald-200'" class="px-2 py-0.5 rounded text-[10px] font-bold border uppercase">
                                                        {{ c.status === 'running' ? 'Berjalan' : c.status === 'upcoming' ? 'Akan Datang' : 'Selesai' }}
                                                    </span>
                                                </div>
                                                <h5 class="text-xs font-bold text-slate-900 mt-2 line-clamp-2">{{ c.title }}</h5>
                                                <div class="text-[11px] text-slate-500 mt-1">Periode: {{ c.date_range }}</div>
                                                <div class="mt-3 pt-3 border-t border-slate-100 flex items-center justify-between text-xs">
                                                    <span class="text-slate-600">{{ c.completed_sessions }} / {{ c.total_sessions }} Sesi</span>
                                                    <span class="font-bold text-slate-800">{{ c.total_participants }} Peserta</span>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <!-- TAB 3: LAPORAN HASIL TRAINING & ULASAN PESERTA -->
                                <div v-else-if="trainerPortalTab === 'reports'" class="space-y-6">
                                    <!-- LEDGER RIWAYAT SESI MENGAJAR SELESAI -->
                                    <div>
                                        <h4 class="text-xs font-bold text-slate-900 uppercase tracking-wider mb-2">Riwayat Jam Mengajar Terverifikasi (Teaching Ledger)</h4>
                                        <div class="overflow-x-auto border border-slate-200 rounded-lg">
                                            <table class="w-full text-left border-collapse text-xs">
                                                <thead>
                                                    <tr class="border-b border-slate-200 bg-slate-50 text-slate-600 uppercase text-[10px] font-bold">
                                                        <th class="py-2.5 px-3">Tanggal</th>
                                                        <th class="py-2.5 px-3">Kode &amp; Kursus</th>
                                                        <th class="py-2.5 px-3">Topik Sesi</th>
                                                        <th class="py-2.5 px-3 text-center">Durasi</th>
                                                        <th class="py-2.5 px-3 text-center">Peserta Hadir</th>
                                                        <th class="py-2.5 px-3 text-right">Status Jam</th>
                                                    </tr>
                                                </thead>
                                                <tbody class="divide-y divide-slate-100">
                                                    <tr v-for="log in (activeTrainerUser?.teaching_logs || [])" :key="log.id">
                                                        <td class="py-2.5 px-3 font-medium">{{ log.log_date_formatted }}</td>
                                                        <td class="py-2.5 px-3 font-bold text-blue-700">{{ log.course_code }}</td>
                                                        <td class="py-2.5 px-3">{{ log.training_title }}</td>
                                                        <td class="py-2.5 px-3 text-center font-mono">{{ log.duration_hours }} Jam</td>
                                                        <td class="py-2.5 px-3 text-center">
                                                            <span class="px-2 py-0.5 rounded bg-emerald-50 text-emerald-700 font-bold text-[10px]">
                                                                {{ log.scanned_participants_count }} Peserta Hadir
                                                            </span>
                                                        </td>
                                                        <td class="py-2.5 px-3 text-right">
                                                            <span class="px-2 py-0.5 rounded bg-emerald-100 text-emerald-800 font-bold text-[10px]">
                                                                +{{ log.duration_hours }} Jam (SAH)
                                                            </span>
                                                        </td>
                                                    </tr>
                                                </tbody>
                                            </table>
                                        </div>
                                    </div>

                                    <!-- ULASAN OTENTIK DARI PESERTA -->
                                    <div>
                                        <h4 class="text-xs font-bold text-slate-900 uppercase tracking-wider mb-2">Ulasan &amp; Evaluasi Peserta (Live Feed)</h4>
                                        <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
                                            <div v-for="ev in (activeTrainerUser?.evaluations || [])" :key="ev.id" class="p-4 rounded-xl border border-slate-200 bg-white space-y-2">
                                                <div class="flex items-center justify-between text-xs">
                                                    <div>
                                                        <span class="font-bold text-slate-900">{{ ev.participant_name }}</span>
                                                        <span class="text-slate-500 font-mono text-[11px]"> ({{ ev.participant_dept }})</span>
                                                    </div>
                                                    <span class="text-amber-500 font-bold">★ {{ ev.rating }}/5</span>
                                                </div>
                                                <p class="text-xs text-slate-700 italic bg-slate-50 p-3 rounded-lg border border-slate-100">
                                                    "{{ ev.comment }}"
                                                </p>
                                                <div class="text-[10px] text-slate-400 text-right">
                                                    {{ ev.training_date }} • Kursus: {{ ev.course_title }}
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- VIEW 1F: PORTAL ADMIN DEPARTEMEN & ADMIN KONTRAKTOR (OrganizationAdmin/Portal.vue) -->
                    <div v-else-if="currentView === 'admin-org-portal'">
                        <div :class="['rounded-md border p-4 mb-5 flex flex-wrap items-center justify-between gap-3', activeRoleSim === 'contractor_admin' ? 'bg-amber-50 border-amber-300 text-amber-950' : 'bg-blue-50 border-blue-200 text-blue-950']">
                            <div>
                                <div class="flex items-center gap-2">
                                    <span :class="['px-2 py-0.5 rounded text-[10px] font-extrabold uppercase text-white', activeRoleSim === 'contractor_admin' ? 'bg-amber-600' : 'bg-blue-600']">
                                        {{ activeRoleSim === 'contractor_admin' ? 'PERUSAHAAN KONTRAKTOR (VND-PTMJU)' : 'DEPARTEMEN INTERNAL (DEPT-OPS)' }}
                                    </span>
                                    <span class="text-xs font-bold">Multi-Tenant Scope Terkunci: {{ scopedOrgWorkers.length }} Pekerja</span>
                                </div>
                                <p class="text-xs opacity-80 mt-1">
                                    Proteksi Anti-IDOR aktif — Admin Kontraktor PT A tidak dapat melihat atau mengunduh sertifikat pekerja PT B.
                                </p>
                            </div>
                            <div class="flex items-center gap-2">
                                <button @click="activeRoleSim = 'dept_admin'" :class="['px-3 py-1.5 rounded text-xs font-bold border', activeRoleSim === 'dept_admin' ? 'bg-blue-600 text-white border-blue-600' : 'bg-white text-slate-700 border-slate-300']">
                                    Simulasi Admin Dept
                                </button>
                                <button @click="activeRoleSim = 'contractor_admin'" :class="['px-3 py-1.5 rounded text-xs font-bold border', activeRoleSim === 'contractor_admin' ? 'bg-amber-600 text-white border-amber-600' : 'bg-white text-slate-700 border-slate-300']">
                                    Simulasi Admin Kontraktor
                                </button>
                            </div>
                        </div>

                        <div class="flex flex-wrap gap-2 border-b border-slate-200 mb-5">
                            <button @click="orgPortalTab = 'collective'" :class="['px-4 py-2 text-xs font-bold border-b-2', orgPortalTab === 'collective' ? 'border-blue-600 text-blue-600 bg-white' : 'border-transparent text-slate-600']">
                                1. Pendaftaran Kolektif Pekerja ({{ scopedOrgWorkers.length }})
                            </button>
                            <button @click="orgPortalTab = 'tna'" :class="['px-4 py-2 text-xs font-bold border-b-2 flex items-center gap-1.5', orgPortalTab === 'tna' ? 'border-blue-600 text-blue-600 bg-white' : 'border-transparent text-slate-600']">
                                <span>2. Pengajuan TNA &amp; Pembaruan Sertifikat (&lt; 60 Hari)</span>
                                <span class="px-1.5 py-0.5 rounded-full bg-rose-600 text-white text-[10px]">3</span>
                            </button>
                            <button @click="orgPortalTab = 'certificates'" :class="['px-4 py-2 text-xs font-bold border-b-2', orgPortalTab === 'certificates' ? 'border-blue-600 text-blue-600 bg-white' : 'border-transparent text-slate-600']">
                                3. Unduh Sertifikat &amp; Rapor Tim
                            </button>
                        </div>

                        <div v-if="orgPortalTab === 'collective'" class="bg-white border border-slate-200 rounded-md p-5">
                            <h3 class="text-sm font-bold text-slate-900 mb-3">Pendaftaran Kolektif Pekerja ke Jadwal Pelatihan</h3>
                            <div class="border border-slate-200 rounded max-h-64 overflow-y-auto divide-y divide-slate-100 mb-4">
                                <label v-for="w in scopedOrgWorkers" :key="w.id" class="flex items-center justify-between p-3 hover:bg-slate-50 cursor-pointer text-xs">
                                    <div class="flex items-center gap-3">
                                        <input v-model="bulkSelectedWorkerIds" type="checkbox" :value="w.id" class="rounded border-slate-300 text-blue-600" />
                                        <div>
                                            <div class="font-bold text-slate-900">{{ w.name }}</div>
                                            <div class="text-[11px] text-slate-500 font-mono">{{ w.nik }} &bull; {{ w.department }}</div>
                                        </div>
                                    </div>
                                    <span class="px-2 py-0.5 rounded bg-slate-100 text-slate-700 text-[10px] font-bold">Scope Organisasi Valid</span>
                                </label>
                            </div>
                            <button @click="submitSimBulkEnroll" class="px-4 py-2 rounded bg-blue-600 hover:bg-blue-700 text-white text-xs font-bold">
                                Daftarkan {{ bulkSelectedWorkerIds.length }} Pekerja Terpilih Secara Kolektif
                            </button>
                        </div>

                        <div v-else-if="orgPortalTab === 'tna'" class="space-y-4">
                            <!-- KOMPONEN ExpiringCertificatesAlert.vue -->
                            <div class="bg-white border border-slate-200">
                                <div class="p-4 border-b border-slate-200 flex flex-wrap items-center justify-between gap-4 bg-slate-50">
                                    <div>
                                        <h2 class="text-sm font-bold uppercase tracking-wider text-slate-900">
                                            Radar Masa Berlaku Sertifikat (H-60 &amp; Expired)
                                        </h2>
                                        <p class="text-xs text-slate-500 mt-0.5">
                                            Deteksi otomatis pekerja internal &amp; kontraktor yang wajib mengikuti training pembaruan (Subquery Anti-False-Alarm whereNotExists).
                                        </p>
                                    </div>
                                    <div class="flex flex-wrap items-center gap-2 text-xs font-bold">
                                        <button @click="renewalFilter = 'all'" :class="renewalFilter === 'all' ? 'bg-blue-600 text-white border border-blue-600' : 'bg-white text-slate-700 border border-slate-300'" class="px-3 py-1.5 rounded-lg">
                                            Semua ({{ expiringCertificatesList.length }})
                                        </button>
                                        <button @click="renewalFilter = 'expired'" :class="renewalFilter === 'expired' ? 'bg-rose-700 text-white border border-rose-700' : 'bg-rose-50 text-rose-800 border border-rose-300'" class="px-3 py-1.5 rounded-lg">
                                            Expired ({{ renewalSummary.expired_count }})
                                        </button>
                                        <button @click="renewalFilter = 'critical'" :class="renewalFilter === 'critical' ? 'bg-amber-600 text-white border border-amber-600' : 'bg-amber-50 text-amber-800 border border-amber-300'" class="px-3 py-1.5 rounded-lg">
                                            Kritis &le; 30 Hari ({{ renewalSummary.critical_count }})
                                        </button>
                                        <button @click="renewalFilter = 'warning'" :class="renewalFilter === 'warning' ? 'bg-amber-500 text-white border border-amber-500' : 'bg-amber-50/70 text-amber-800 border border-amber-200'" class="px-3 py-1.5 rounded-lg">
                                            31-60 Hari ({{ renewalSummary.warning_count }})
                                        </button>
                                    </div>
                                </div>

                                <div v-if="selectedRenewalGroups.length" class="bg-blue-50 border-b border-blue-200 text-blue-900 px-4 py-2.5 flex flex-wrap items-center justify-between gap-2 text-xs">
                                    <span class="font-semibold">Pengajuan Kolektif Terpilih:</span>
                                    <div class="flex flex-wrap gap-2">
                                        <button v-for="grp in selectedRenewalGroups" :key="grp.course_id" @click="submitBatchSimRenewal(grp.course_id)" class="bg-emerald-600 hover:bg-emerald-700 text-white rounded-lg px-3 py-1.5 font-bold">
                                            Ajukan {{ grp.count }} Pekerja untuk [{{ grp.course_title }}] &rarr;
                                        </button>
                                    </div>
                                </div>

                                <div class="overflow-x-auto">
                                    <table class="w-full text-xs text-left border-collapse">
                                        <thead>
                                            <tr class="bg-slate-100 text-slate-700 border-b border-slate-200 uppercase">
                                                <th class="p-3 w-8 text-center">#</th>
                                                <th class="p-3">NIK &amp; Nama Pekerja</th>
                                                <th class="p-3">Unit / Kontraktor</th>
                                                <th class="p-3">Pelatihan &amp; No. Sertifikat</th>
                                                <th class="p-3 text-center">Tgl Kadaluarsa</th>
                                                <th class="p-3 text-center">Status Sisa Waktu</th>
                                                <th class="p-3 text-right">Tindakan</th>
                                            </tr>
                                        </thead>
                                        <tbody class="divide-y divide-slate-200">
                                            <tr v-for="item in filteredRenewalList" :key="item.enrollment_id" class="hover:bg-slate-50">
                                                <td class="p-3 text-center">
                                                    <input v-if="!item.is_requested" type="checkbox" :value="item" v-model="selectedRenewalItems" class="border-slate-300 text-slate-900 focus:ring-0" />
                                                </td>
                                                <td class="p-3">
                                                    <p class="font-bold text-slate-900">{{ item.user_name }}</p>
                                                    <p class="font-mono text-[11px] text-slate-500">{{ item.user_nik }}</p>
                                                </td>
                                                <td class="p-3">
                                                    <span :class="item.organization_type === 'contractor' ? 'bg-purple-50 text-purple-800 border-purple-200' : 'bg-slate-100 text-slate-700 border-slate-300'" class="px-2 py-0.5 border text-[10px] font-bold uppercase">
                                                        {{ item.organization_type === 'contractor' ? 'KONTRAKTOR' : 'INTERNAL' }}
                                                    </span>
                                                    <p class="font-medium text-slate-800 mt-1">{{ item.organization_name }}</p>
                                                </td>
                                                <td class="p-3">
                                                    <p class="font-bold text-slate-900">[{{ item.course_code }}] {{ item.course_title }}</p>
                                                    <p class="font-mono text-[11px] text-slate-500">No: {{ item.certificate_number }}</p>
                                                </td>
                                                <td class="p-3 text-center font-mono font-bold text-slate-800">{{ item.expires_at }}</td>
                                                <td class="p-3 text-center">
                                                    <span v-if="item.severity === 'expired'" class="bg-rose-100 text-rose-800 border border-rose-300 px-2 py-1 font-bold inline-block">
                                                        EXPIRED ({{ Math.abs(item.days_left) }} Hari Lalu)
                                                    </span>
                                                    <span v-else-if="item.severity === 'critical'" class="bg-amber-100 text-amber-900 border border-amber-300 px-2 py-1 font-bold inline-block">
                                                        H-{{ item.days_left }} Hari Lagi
                                                    </span>
                                                    <span v-else class="bg-yellow-50 text-yellow-800 border border-yellow-300 px-2 py-1 font-bold inline-block">
                                                        H-{{ item.days_left }} Hari Lagi
                                                    </span>
                                                </td>
                                                <td class="p-3 text-right">
                                                    <span v-if="item.is_requested" class="text-[11px] font-mono font-bold text-emerald-700 bg-emerald-50 border border-emerald-200 px-2.5 py-1 inline-block">
                                                        &#10003; MENUNGGU JADWAL LnD
                                                    </span>
                                                    <button v-else @click="submitSingleSimRenewal(item)" class="bg-blue-600 hover:bg-blue-700 text-white rounded-lg font-bold px-3.5 py-1.5 text-xs">
                                                        Ajukan Pembaruan
                                                    </button>
                                                </td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </div>
                            </div>

                            <div class="bg-white border border-slate-200 rounded-md p-4">
                                <h3 class="text-sm font-bold text-slate-900 mb-3">Daftar Pengajuan TNA &amp; Refreshment Organisasi</h3>
                                <table class="w-full text-left border-collapse text-xs">
                                    <thead>
                                        <tr class="border-b border-slate-200 bg-slate-50 text-[10px] font-bold uppercase text-slate-600">
                                            <th class="py-2 px-3">Waktu</th>
                                            <th class="py-2 px-3">Organisasi</th>
                                            <th class="py-2 px-3">Tipe</th>
                                            <th class="py-2 px-3">Program / Alasan</th>
                                            <th class="py-2 px-3 text-right">Status</th>
                                        </tr>
                                    </thead>
                                    <tbody class="divide-y divide-slate-100">
                                        <tr v-for="req in tnaRequests" :key="req.id">
                                            <td class="py-2.5 px-3 text-slate-500">{{ req.created_at }}</td>
                                            <td class="py-2.5 px-3 font-bold">{{ req.organization_name }}</td>
                                            <td class="py-2.5 px-3">
                                                <span :class="['px-2 py-0.5 rounded text-[10px] font-bold uppercase', req.request_type === 'renewal_refreshment' ? 'bg-amber-100 text-amber-800' : 'bg-blue-100 text-blue-800']">
                                                    {{ req.request_type }}
                                                </span>
                                            </td>
                                            <td class="py-2.5 px-3">
                                                <div class="font-bold">{{ req.course_title }} ({{ req.target_participants_count }} Orang)</div>
                                                <div class="text-[11px] text-slate-500">{{ req.reason_notes }}</div>
                                            </td>
                                            <td class="py-2.5 px-3 text-right">
                                                <span class="px-2 py-0.5 rounded bg-emerald-100 text-emerald-800 text-[10px] font-bold uppercase">{{ req.status }}</span>
                                            </td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>

                        <div v-else class="bg-white border border-slate-200 rounded-md p-5">
                            <h3 class="text-sm font-bold text-slate-900 mb-3">Unduh Sertifikat &amp; Rapor Pekerja (Dilindungi Anti-IDOR)</h3>
                            <div class="divide-y divide-slate-100">
                                <div v-for="w in scopedOrgWorkers" :key="w.id" class="py-2.5 flex items-center justify-between text-xs">
                                    <div>
                                        <span class="font-mono font-bold text-blue-700">{{ w.nik }}</span>
                                        <span class="ml-2 font-bold text-slate-900">{{ w.name }}</span>
                                        <span class="ml-2 text-slate-500">({{ w.department }})</span>
                                    </div>
                                    <button @click="openPrintReport(w.id)" class="px-3.5 py-1.5 rounded-lg bg-blue-600 hover:bg-blue-700 text-white font-bold text-xs">
                                        🖨️ Cetak Sertifikat &amp; Rapor A4
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- VIEW 1G: BAGIAN 2 - MANPOWER CRUD, BATCH ENROLL, HISTORICAL MIGRATION (MODE A/B) & SELF-REPORT (ManpowerAndMigration.vue) -->
                    <div v-else-if="currentView === 'admin-manpower'">
                        <!-- TAB 1: MANPOWER CRUD + CSV IMPORT -->
                        <div v-if="manpowerTab === 'manpower'" class="space-y-5">
                            <div class="grid grid-cols-1 lg:grid-cols-12 gap-5">
                                <div class="lg:col-span-7 bg-white border border-slate-200 rounded-md p-5">
                                    <h3 class="text-sm font-bold text-slate-900 mb-1">Tambah Manpower Baru (Internal &amp; External Contractor)</h3>
                                    <p class="text-xs text-slate-500 mb-3">Validasi NIK unik &amp; otomatis mengunci cakupan organisasi.</p>
                                    <form @submit.prevent="addSimManpower" class="grid grid-cols-1 sm:grid-cols-2 gap-3 text-xs">
                                        <div>
                                            <label class="block font-bold text-slate-700 mb-1">NIK / No. Badge Unik</label>
                                            <input v-model="manpowerFormSim.nik" type="text" required placeholder="PANI-0205 / VND-088" class="w-full rounded border-slate-300 text-xs py-2 px-3 font-mono uppercase" />
                                        </div>
                                        <div>
                                            <label class="block font-bold text-slate-700 mb-1">Nama Lengkap Pekerja</label>
                                            <input v-model="manpowerFormSim.name" type="text" required placeholder="Nama pekerja..." class="w-full rounded border-slate-300 text-xs py-2 px-3" />
                                        </div>
                                        <div>
                                            <label class="block font-bold text-slate-700 mb-1">Grup Organisasi</label>
                                            <select v-model="manpowerFormSim.organization_type" class="w-full rounded border-slate-300 text-xs py-2 px-3">
                                                <option value="internal_dept">Internal Department Group</option>
                                                <option value="contractor">External Contractor Group</option>
                                            </select>
                                        </div>
                                        <div>
                                            <label class="block font-bold text-slate-700 mb-1">Departemen / PT Kontraktor</label>
                                            <select v-model="manpowerFormSim.department" class="w-full rounded border-slate-300 text-xs py-2 px-3">
                                                <option v-for="d in departments" :key="d" :value="d">{{ d }}</option>
                                            </select>
                                        </div>
                                        <div class="sm:col-span-2 flex justify-end">
                                            <button type="submit" class="px-4 py-2 rounded bg-blue-600 hover:bg-blue-700 text-white font-bold">
                                                + Simpan Manpower Baru
                                            </button>
                                        </div>
                                    </form>
                                </div>

                                <div class="lg:col-span-5 bg-white border border-slate-200 rounded-md p-5 flex flex-col justify-between">
                                    <div>
                                        <h3 class="text-sm font-bold text-slate-900 mb-1">Upload Masal (Batch Import CSV/Excel)</h3>
                                        <p class="text-xs text-slate-500 mb-3">Format kolom: <code class="font-mono bg-slate-100 px-1">NIK, Nama, Email, Kode_Organisasi</code></p>
                                        <input type="file" accept=".csv,.txt" class="w-full text-xs text-slate-600 mb-3" />
                                    </div>
                                    <button @click="simulateCsvImport" class="w-full py-2.5 px-4 rounded bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-bold">
                                        Jalankan Batch Import Manpower (CSV)
                                    </button>
                                </div>
                            </div>

                            <div class="bg-white border border-slate-200 rounded-md p-5">
                                <div class="flex items-center justify-between mb-3">
                                    <h3 class="text-sm font-bold text-slate-900">Daftar Manpower Terdaftar ({{ scopedOrgWorkers.length }})</h3>
                                    <span class="text-xs text-slate-500">Scope: {{ activeRoleSim.toUpperCase() }}</span>
                                </div>
                                <div class="overflow-x-auto">
                                    <table class="w-full text-left border-collapse text-xs">
                                        <thead>
                                            <tr class="border-b border-slate-200 bg-slate-50 uppercase text-[10px] font-bold text-slate-600">
                                                <th class="py-2 px-3">NIK</th>
                                                <th class="py-2 px-3">Nama Pekerja</th>
                                                <th class="py-2 px-3">Grup &amp; Unit Organisasi</th>
                                                <th class="py-2 px-3 text-right">Aksi</th>
                                            </tr>
                                        </thead>
                                        <tbody class="divide-y divide-slate-100">
                                            <tr v-for="w in scopedOrgWorkers" :key="w.id" class="hover:bg-slate-50">
                                                <td class="py-2.5 px-3 font-mono font-bold text-blue-700">{{ w.nik }}</td>
                                                <td class="py-2.5 px-3 font-bold text-slate-900">{{ w.name }}</td>
                                                <td class="py-2.5 px-3">
                                                    <span :class="w.department === 'HSE & Quality Control' ? 'bg-purple-50 text-purple-800 border-purple-200' : 'bg-blue-50 text-blue-700 border-blue-200'" class="px-2 py-0.5 border text-[10px] font-bold uppercase mr-2">
                                                        {{ w.department === 'HSE & Quality Control' ? 'EXTERNAL CONTRACTOR' : 'INTERNAL DEPT' }}
                                                    </span>
                                                    <span>{{ w.department }}</span>
                                                </td>
                                                <td class="py-2.5 px-3 text-right">
                                                    <button @click="openPrintReport(w.id)" class="px-2.5 py-1 rounded bg-slate-100 hover:bg-slate-200 text-slate-800 font-bold text-[11px]">Lihat Rapor</button>
                                                </td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>

                        <!-- TAB 2: PENDAFTARAN TRAINING (INDIVIDU & BATCH CHECKBOX) -->
                        <div v-else-if="manpowerTab === 'batch_enroll'" class="bg-white border border-slate-200 rounded-md p-5">
                            <h3 class="text-sm font-bold text-slate-900 mb-1">Pendaftaran Training (Satuan &amp; Batch Multi-Select Checkbox)</h3>
                            <p class="text-xs text-slate-500 mb-4">Menyimpan ke tabel <code class="font-mono">enrollments</code> lengkap dengan <code class="font-mono">registered_by</code> &amp; timestamp time-series.</p>
                            <div class="border border-slate-200 rounded max-h-64 overflow-y-auto divide-y divide-slate-100 mb-4">
                                <label v-for="w in scopedOrgWorkers" :key="w.id" class="flex items-center justify-between p-3 hover:bg-slate-50 cursor-pointer text-xs">
                                    <div class="flex items-center gap-3">
                                        <input v-model="bulkSelectedWorkerIds" type="checkbox" :value="w.id" class="rounded border-slate-300 text-blue-600" />
                                        <div>
                                            <span class="font-mono font-bold text-blue-700">{{ w.nik }}</span>
                                            <span class="ml-2 font-bold text-slate-900">{{ w.name }}</span>
                                        </div>
                                    </div>
                                    <span class="text-[11px] text-slate-500">{{ w.department }}</span>
                                </label>
                            </div>
                            <button @click="submitSimBulkEnroll" class="px-5 py-2.5 rounded bg-blue-600 hover:bg-blue-700 text-white text-xs font-bold">
                                Simpan Pendaftaran Time-Series ({{ bulkSelectedWorkerIds.length }} Peserta)
                            </button>
                        </div>

                        <!-- TAB 3: INPUT RIWAYAT TRAINING MASA LALU (MODE A & MODE B) -->
                        <div v-else-if="manpowerTab === 'historical'" class="bg-white border border-slate-200 rounded-md p-5">
                            <div class="flex flex-wrap items-center justify-between gap-3 mb-4 pb-3 border-b border-slate-200">
                                <div>
                                    <h3 class="text-sm font-bold text-slate-900">Input Riwayat Training Masa Lalu (Historical Migration)</h3>
                                    <p class="text-xs text-slate-500">Pilih Mode A (1 Orang banyak sertifikat) atau Mode B (1 Training dicentang banyak pekerja).</p>
                                </div>
                                <div class="flex flex-wrap gap-2 text-xs font-bold">
                                    <button @click="migrationModeSim = 'single_worker_multi_cert'" :class="migrationModeSim === 'single_worker_multi_cert' ? 'bg-blue-600 text-white' : 'bg-slate-100 text-slate-700 hover:bg-slate-200'" class="px-3.5 py-1.5 rounded-lg">
                                        Mode A: 1 Orang &rarr; Banyak Sertifikat
                                    </button>
                                    <button @click="migrationModeSim = 'single_course_multi_worker'" :class="migrationModeSim === 'single_course_multi_worker' ? 'bg-blue-600 text-white' : 'bg-slate-100 text-slate-700 hover:bg-slate-200'" class="px-3.5 py-1.5 rounded-lg">
                                        Mode B: 1 Training &rarr; Banyak Pekerja
                                    </button>
                                </div>
                            </div>

                            <form v-if="migrationModeSim === 'single_worker_multi_cert'" @submit.prevent="submitModeASim" class="space-y-3 text-xs">
                                <div>
                                    <label class="block font-bold text-slate-700 mb-1">Pilih 1 Pekerja</label>
                                    <select v-model="modeAWorkerIdSim" class="w-full max-w-md rounded border-slate-300 text-xs py-2 px-3">
                                        <option v-for="w in scopedOrgWorkers" :key="w.id" :value="w.id">{{ w.nik }} - {{ w.name }}</option>
                                    </select>
                                </div>
                                <div v-for="(row, idx) in modeACertsSim" :key="idx" class="grid grid-cols-1 md:grid-cols-4 gap-3 p-3 rounded border border-slate-200 bg-slate-50">
                                    <select v-model="row.course_id" class="rounded border-slate-300 text-xs py-1.5 px-2">
                                        <option v-for="c in courses" :key="c.id" :value="c.id">[{{ c.code }}] {{ c.title }}</option>
                                    </select>
                                    <input v-model="row.certificate_number" type="text" placeholder="No. Sertifikat" class="rounded border-slate-300 text-xs py-1.5 px-2 font-mono" />
                                    <input v-model="row.issued_at" type="date" class="rounded border-slate-300 text-xs py-1.5 px-2" />
                                    <input v-model="row.expires_at" type="date" class="rounded border-slate-300 text-xs py-1.5 px-2" />
                                </div>
                                <div class="flex justify-between">
                                    <button type="button" @click="modeACertsSim.push({ course_id: 1, certificate_number: '', issued_at: '2024-06-15', expires_at: '2026-06-15' })" class="px-3 py-1.5 rounded bg-blue-50 text-blue-700 border border-blue-200 font-bold">
                                        + Tambah Baris Sertifikat
                                    </button>
                                    <button type="submit" class="px-4 py-2 rounded-lg bg-blue-600 hover:bg-blue-700 text-white font-bold">
                                        Simpan {{ modeACertsSim.length }} Sertifikat ke Riwayat Resmi
                                    </button>
                                </div>
                            </form>

                            <form v-else @submit.prevent="submitModeBSim" class="space-y-3 text-xs">
                                <div class="grid grid-cols-1 md:grid-cols-3 gap-3">
                                    <select v-model="modeBCourseIdSim" class="rounded border-slate-300 text-xs py-2 px-3">
                                        <option v-for="c in courses" :key="c.id" :value="c.id">[{{ c.code }}] {{ c.title }}</option>
                                    </select>
                                    <input v-model="modeBIssuedAtSim" type="date" class="rounded border-slate-300 text-xs py-2 px-3" />
                                    <input v-model="modeBExpiresAtSim" type="date" class="rounded border-slate-300 text-xs py-2 px-3" />
                                </div>
                                <div class="border border-slate-200 rounded max-h-56 overflow-y-auto divide-y divide-slate-100">
                                    <label v-for="w in scopedOrgWorkers" :key="w.id" class="flex items-center justify-between p-2.5 hover:bg-slate-50 cursor-pointer">
                                        <div class="flex items-center gap-2.5">
                                            <input v-model="modeBSelectedWorkerIdsSim" type="checkbox" :value="w.id" class="rounded border-slate-300 text-blue-600" />
                                            <span class="font-mono font-bold text-blue-700">{{ w.nik }}</span>
                                            <span class="font-bold text-slate-900">{{ w.name }}</span>
                                        </div>
                                        <span class="text-slate-500">{{ w.department }}</span>
                                    </label>
                                </div>
                                <div class="flex justify-end">
                                    <button type="submit" class="px-4 py-2 rounded bg-emerald-600 text-white font-bold">
                                        Migrasi Massal {{ modeBSelectedWorkerIdsSim.length }} Pekerja ke Riwayat Resmi
                                    </button>
                                </div>
                            </form>
                        </div>

                        <!-- TAB 4: VERIFIKASI SELF-REPORT SERTIFIKAT MANDIRI -->
                        <div v-else class="bg-white border border-slate-200 rounded-md p-5">
                            <h3 class="text-sm font-bold text-slate-900 mb-1">Verifikasi Self-Report Sertifikat Mandiri Peserta</h3>
                            <p class="text-xs text-slate-500 mb-3">Setujui (<code class="font-mono">approved</code>) agar sertifikat masuk ke profil riwayat resmi pekerja, atau tolak (<code class="font-mono">rejected</code>).</p>
                            <table class="w-full text-left border-collapse text-xs">
                                <thead>
                                    <tr class="border-b border-slate-200 bg-slate-50 uppercase text-[10px] font-bold text-slate-600">
                                        <th class="py-2.5 px-3">Pekerja</th>
                                        <th class="py-2.5 px-3">Pelatihan &amp; Penyelenggara</th>
                                        <th class="py-2.5 px-3">No. Sertifikat &amp; Masa Berlaku</th>
                                        <th class="py-2.5 px-3 text-right">Keputusan Verifikasi LnD</th>
                                    </tr>
                                </thead>
                                <tbody class="divide-y divide-slate-100">
                                    <tr v-for="rep in selfReportsList" :key="rep.id">
                                        <td class="py-2.5 px-3">
                                            <div class="font-bold text-slate-900">{{ rep.user_name }}</div>
                                            <div class="font-mono text-[11px] text-slate-500">{{ rep.user_nik }} &bull; {{ rep.organization_name }}</div>
                                        </td>
                                        <td class="py-2.5 px-3">
                                            <div class="font-bold text-slate-900">{{ rep.course_name }}</div>
                                            <div class="text-[11px] text-slate-500">{{ rep.organizer }}</div>
                                        </td>
                                        <td class="py-2.5 px-3">
                                            <div class="font-mono font-bold text-blue-700">{{ rep.certificate_number }}</div>
                                            <div class="text-[11px] text-slate-500">Terbit: {{ rep.issued_at }} &bull; Exp: {{ rep.expires_at }}</div>
                                        </td>
                                        <td class="py-2.5 px-3 text-right">
                                            <div v-if="rep.status === 'pending'" class="flex justify-end gap-1.5">
                                                <button @click="reviewSimSelfReport(rep, 'approved')" class="px-2.5 py-1 rounded bg-emerald-600 text-white font-bold text-[11px]">Approve</button>
                                                <button @click="reviewSimSelfReport(rep, 'rejected')" class="px-2.5 py-1 rounded bg-rose-600 text-white font-bold text-[11px]">Reject</button>
                                            </div>
                                            <span v-else :class="rep.status === 'approved' ? 'bg-emerald-100 text-emerald-800' : 'bg-rose-100 text-rose-800'" class="px-2.5 py-1 rounded text-[10px] font-bold uppercase">
                                                {{ rep.status }}
                                            </span>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>

                    <!-- VIEW 1H: SETTING COMPETENCY ON LEVEL x POSITION (PositionSkillSetting.vue) -->
                    <div v-else-if="currentView === 'admin-position-skill'" class="space-y-5">
                        <div class="rounded-md border border-blue-200 bg-blue-50 p-3.5 flex flex-wrap items-center justify-between gap-3 text-xs text-blue-950">
                            <div>
                                <span class="px-2 py-0.5 rounded bg-blue-600 text-white font-extrabold uppercase text-[10px]">
                                    {{ activeRoleSim === 'lnd' ? 'MODE FULL CRUD (SUPER ADMIN L&D)' : 'MODE READ-ONLY (ADMIN ORGANISASI)' }}
                                </span>
                                <span class="ml-2 font-medium">Standar Target Level (1-5) per Level x Position yang disinkronkan ke tabel <code class="font-mono">user_skills</code>.</span>
                            </div>
                            <div class="flex flex-wrap gap-2">
                                <button @click="posSettingTab = 'standards'" :class="['px-3.5 py-1.5 rounded-lg font-bold border', posSettingTab === 'standards' ? 'bg-blue-600 text-white border-blue-600' : 'bg-white text-slate-700 border-slate-300']">
                                    Matriks Standar Kompetensi Jabatan
                                </button>
                                <button v-if="activeRoleSim === 'lnd'" @click="posSettingTab = 'positions'" :class="['px-3.5 py-1.5 rounded-lg font-bold border', posSettingTab === 'positions' ? 'bg-blue-600 text-white border-blue-600' : 'bg-white text-slate-700 border-slate-300']">
                                    + Master Data Level x Position ({{ jobPositionsList.length }})
                                </button>
                            </div>
                        </div>

                        <div v-if="posSettingTab === 'standards'" class="grid grid-cols-1 lg:grid-cols-12 gap-5">
                            <div class="lg:col-span-4 bg-white border border-slate-200 rounded-md p-4 space-y-2.5">
                                <h3 class="text-xs font-bold uppercase tracking-wider text-slate-500">Pilih Jabatan (Level x Position)</h3>
                                <button v-for="pos in jobPositionsList" :key="pos.id" @click="selectedJobPosId = pos.id" :class="['w-full text-left p-3.5 rounded-xl border text-xs transition-all', selectedJobPosId === pos.id ? 'bg-blue-600 text-white border-blue-600 shadow-sm' : 'bg-slate-50 hover:bg-blue-50/60 text-slate-800 border-slate-200']">
                                    <div class="flex justify-between font-mono font-bold text-[11px]">
                                        <span :class="selectedJobPosId === pos.id ? 'text-blue-100' : 'text-blue-700'">{{ pos.code }}</span>
                                        <span class="uppercase">{{ pos.organization_type }}</span>
                                    </div>
                                    <div class="font-bold mt-1">{{ pos.level_name }} — {{ pos.position_title }}</div>
                                    <div class="text-[11px] opacity-80 mt-1">{{ pos.workers_count }} Pekerja di Posisi Ini</div>
                                </button>
                            </div>

                            <div class="lg:col-span-8 bg-white border border-slate-200 rounded-md p-5">
                                <div class="flex flex-wrap items-center justify-between gap-3 pb-4 mb-4 border-b border-slate-200">
                                    <div>
                                        <span class="px-2 py-0.5 rounded bg-blue-600 text-white font-mono text-xs font-bold">{{ activeJobPositionSim.code }}</span>
                                        <span class="ml-2 text-base font-extrabold text-slate-900">{{ activeJobPositionSim.level_name }} — {{ activeJobPositionSim.position_title }}</span>
                                    </div>
                                    <button v-if="activeRoleSim === 'lnd'" @click="syncStandardsToPositionWorkersSim" class="px-4 py-2 rounded bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-bold">
                                        ↻ Sync ke Semua Pekerja di Posisi Ini ({{ activeJobPositionSim.workers_count }} Orang)
                                    </button>
                                </div>

                                <table class="w-full text-left border-collapse text-xs">
                                    <thead>
                                        <tr class="bg-slate-50 border-b border-slate-200 text-[10px] font-bold uppercase text-slate-600">
                                            <th class="py-2.5 px-3">Kode &amp; Nama Kompetensi (Skill)</th>
                                            <th class="py-2.5 px-3">Kategori</th>
                                            <th class="py-2.5 px-3 text-center">Required Target Level (1-5)</th>
                                        </tr>
                                    </thead>
                                    <tbody class="divide-y divide-slate-100">
                                        <tr v-for="sk in skills" :key="sk.id">
                                            <td class="py-2.5 px-3">
                                                <div class="font-bold text-slate-900">{{ sk.name }}</div>
                                                <div class="font-mono text-[11px] text-blue-700">{{ sk.code }}</div>
                                            </td>
                                            <td class="py-2.5 px-3 text-slate-600">{{ sk.category }}</td>
                                            <td class="py-2.5 px-3 text-center">
                                                <div class="inline-flex gap-1">
                                                    <button v-for="lvl in [1,2,3,4,5]" :key="lvl" type="button" :disabled="activeRoleSim !== 'lnd'" @click="activeJobPositionSim.standards[sk.id] = lvl" :class="['w-7 h-7 rounded font-mono text-xs font-extrabold border', activeJobPositionSim.standards[sk.id] === lvl ? 'bg-blue-600 text-white border-blue-600' : 'bg-white text-slate-700 border-slate-300']">
                                                        {{ lvl }}
                                                    </button>
                                                </div>
                                            </td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>

                        <div v-else class="grid grid-cols-1 lg:grid-cols-12 gap-5">
                            <div class="lg:col-span-5 bg-white border border-slate-200 rounded-md p-5">
                                <h3 class="text-sm font-bold text-slate-900 mb-3">Tambah Master Level x Position</h3>
                                <form @submit.prevent="addNewJobPositionSim" class="space-y-3 text-xs">
                                    <input v-model="newPosFormSim.code" type="text" required placeholder="Kode (Contoh: SUP-ENG)" class="w-full rounded border-slate-300 text-xs py-2 px-3 font-mono uppercase" />
                                    <select v-model="newPosFormSim.level_name" class="w-full rounded border-slate-300 text-xs py-2 px-3">
                                        <option value="Operator">Operator</option>
                                        <option value="Technician">Technician</option>
                                        <option value="Supervisor">Supervisor</option>
                                        <option value="Manager">Manager</option>
                                    </select>
                                    <input v-model="newPosFormSim.position_title" type="text" required placeholder="Position Title (Contoh: Electrical Maintenance)" class="w-full rounded border-slate-300 text-xs py-2 px-3" />
                                    <button type="submit" class="w-full py-2.5 px-4 rounded bg-blue-600 text-white font-bold">+ Simpan Master Level x Position</button>
                                </form>
                            </div>
                            <div class="lg:col-span-7 bg-white border border-slate-200 rounded-md p-5">
                                <h3 class="text-sm font-bold text-slate-900 mb-3">Daftar Master Level x Position ({{ jobPositionsList.length }})</h3>
                                <table class="w-full text-left border-collapse text-xs">
                                    <thead>
                                        <tr class="bg-slate-50 border-b border-slate-200 text-[10px] font-bold uppercase text-slate-600">
                                            <th class="py-2 px-3">Kode</th>
                                            <th class="py-2 px-3">Level Name</th>
                                            <th class="py-2 px-3">Position Title</th>
                                            <th class="py-2 px-3 text-right">Aksi</th>
                                        </tr>
                                    </thead>
                                    <tbody class="divide-y divide-slate-100">
                                        <tr v-for="pos in jobPositionsList" :key="pos.id">
                                            <td class="py-2.5 px-3 font-mono font-bold text-blue-700">{{ pos.code }}</td>
                                            <td class="py-2.5 px-3 font-semibold">{{ pos.level_name }}</td>
                                            <td class="py-2.5 px-3 font-bold">{{ pos.position_title }}</td>
                                            <td class="py-2.5 px-3 text-right">
                                                <button @click="selectedJobPosId = pos.id; posSettingTab = 'standards'" class="px-2.5 py-1 rounded bg-slate-100 font-bold text-[11px]">Atur Skill →</button>
                                            </td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>

                    <!-- VIEW 1I: TRAINING TODAY (TrainingToday/Index.vue) -->
                    <div v-else-if="currentView === 'admin-training-today'" class="space-y-5">
                        <div class="flex flex-wrap gap-2 border-b border-slate-200 pb-2">
                            <button @click="trainingTodayTab = 'today'" :class="trainingTodayTab === 'today' ? 'bg-blue-700 text-white' : 'bg-white text-slate-600 border border-slate-200'" class="px-3.5 py-2 rounded-lg text-xs font-bold">Sesi Hari Ini</button>
                            <button @click="trainingTodayTab = 'barcode_sheet'" :class="trainingTodayTab === 'barcode_sheet' ? 'bg-blue-700 text-white' : 'bg-white text-slate-600 border border-slate-200'" class="px-3.5 py-2 rounded-lg text-xs font-bold">QR &amp; Barcode</button>
                            <button @click="trainingTodayTab = 'pre_post_test'" :class="trainingTodayTab === 'pre_post_test' ? 'bg-blue-700 text-white' : 'bg-white text-slate-600 border border-slate-200'" class="px-3.5 py-2 rounded-lg text-xs font-bold">Pre-Test &amp; Post-Test</button>
                            <button @click="trainingTodayTab = 'calendar'" :class="trainingTodayTab === 'calendar' ? 'bg-blue-700 text-white' : 'bg-white text-slate-600 border border-slate-200'" class="px-3.5 py-2 rounded-lg text-xs font-bold">Kalender &amp; ATMP</button>
                        </div>
                        <div v-if="trainingTodayTab === 'today'" class="grid grid-cols-1 md:grid-cols-2 gap-4">
                            <div v-for="s in sessions" :key="s.id" class="bg-white border border-slate-200 rounded-md p-5 flex flex-col justify-between">
                                <div>
                                    <div class="flex justify-between items-center mb-2">
                                        <span class="px-2 py-0.5 rounded bg-blue-50 text-blue-700 border border-blue-200 font-mono text-xs font-bold">{{ s.course_code }}</span>
                                        <span :class="['px-2 py-0.5 rounded text-[10px] font-bold uppercase', s.is_active ? 'bg-emerald-100 text-emerald-800' : 'bg-slate-100 text-slate-600']">{{ s.is_active ? 'SESI LIVE AKTIF' : 'SELESAI' }}</span>
                                    </div>
                                    <h3 class="text-sm font-extrabold text-slate-900">{{ s.title }}</h3>
                                    <p class="text-xs text-slate-500 mt-0.5">{{ s.course_title }} &bull; Hadir: {{ s.present_count }} Peserta</p>
                                </div>
                                <div class="mt-4 pt-3 border-t border-slate-100 flex flex-wrap justify-between items-center gap-2 text-xs">
                                    <span class="font-mono text-[11px]">PIN 15d: <strong class="text-blue-700">{{ dynamicQrPayload.manual_code }}</strong></span>
                                    <div class="flex gap-1.5">
                                        <button @click="activeSessionId = s.id; currentView = 'admin-projector'" class="px-3 py-1.5 rounded bg-blue-600 text-white font-bold">Buka Proyektor QR →</button>
                                        <button @click="trainingTodayTab = 'barcode_sheet'" class="px-3 py-1.5 rounded bg-slate-100 text-slate-800 font-bold">Cetak QR / Barcode</button>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div v-else-if="trainingTodayTab === 'barcode_sheet'" class="bg-white border border-slate-200 rounded-md p-5">
                            <div class="flex justify-between items-center mb-4 pb-3 border-b border-slate-200">
                                <div>
                                    <h3 class="text-sm font-bold text-slate-900">Lembar Cetak Daftar QR &amp; Barcode Sesi Hari Ini (Native SVG)</h3>
                                    <p class="text-xs text-slate-500">Siap dicetak untuk meja registrasi kelas pelatihan.</p>
                                </div>
                                <div class="flex items-center gap-2">
                                    <button @click="trainingTodayTab = 'today'" class="px-3.5 py-2 rounded-lg bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs font-bold transition">← Kembali ke Sesi Hari Ini</button>
                                    <button onclick="window.print()" class="px-4 py-2 rounded-lg bg-blue-600 hover:bg-blue-700 text-white text-xs font-bold shadow-sm">🖨️ Cetak Lembar QR / Barcode</button>
                                </div>
                            </div>
                            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                                <div v-for="s in sessions" :key="'bs-'+s.id" class="p-4 rounded-xl border border-slate-300 bg-slate-50/60 flex items-center justify-between gap-4">
                                    <div class="text-xs space-y-1">
                                        <span class="px-2 py-0.5 rounded bg-blue-600 text-white font-mono text-[10px] font-bold">{{ s.course_code }}</span>
                                        <div class="font-extrabold text-slate-900">{{ s.title }}</div>
                                        <div class="font-mono text-[11px] text-blue-700">PIN: {{ dynamicQrPayload.manual_code }}</div>
                                    </div>
                                    <svg viewBox="0 0 29 29" class="w-20 h-20 border border-slate-900 p-1 shrink-0" shape-rendering="crispEdges">
                                        <rect x="0" y="0" width="29" height="29" fill="#ffffff" />
                                        <template v-for="(row, rIdx) in projectorQrMatrix" :key="'pqr'+rIdx">
                                            <template v-for="(cell, cIdx) in row" :key="'pqrc'+rIdx+'-'+cIdx">
                                                <rect v-if="cell === 1" :x="cIdx + 2" :y="rIdx + 2" width="1" height="1" fill="#0f172a" />
                                            </template>
                                        </template>
                                    </svg>
                                </div>
                            </div>
                        </div>

                        <div v-else-if="trainingTodayTab === 'pre_post_test'" class="bg-white border border-slate-200 rounded-xl p-5 sm:p-6 shadow-sm space-y-5">
                            <div class="flex flex-col sm:flex-row sm:items-start justify-between gap-3 border-b border-slate-100 pb-4">
                                <div>
                                    <span class="px-2.5 py-1 rounded-full bg-emerald-100 text-emerald-800 border border-emerald-200 text-[10px] font-extrabold uppercase">Ujian Aktif</span>
                                    <h3 class="mt-2 text-base font-extrabold text-slate-900">Pre-Test &amp; Post-Test — General OHSE Induction</h3>
                                    <p class="mt-1 text-xs text-slate-500">5 soal pilihan ganda · 10 menit · Baseline pre-test {{ previewQuizPreScore }}%</p>
                                </div>
                                <div v-if="previewQuizStarted" class="px-4 py-2 rounded-lg border font-mono text-lg font-black tabular-nums" :class="previewQuizSeconds <= 60 ? 'bg-rose-50 text-rose-700 border-rose-200' : 'bg-blue-50 text-blue-800 border-blue-200'" role="timer" aria-live="polite">
                                    {{ previewQuizFormattedTime }}
                                </div>
                            </div>

                            <div v-if="previewQuizResult" class="max-w-2xl mx-auto w-full bg-slate-50 border border-slate-200 rounded-xl p-5 text-center">
                                <span class="text-[10px] font-black uppercase tracking-wider text-emerald-700">Hasil Ujian</span>
                                <div class="text-5xl font-black text-slate-900 mt-2">{{ previewQuizResult.score }}%</div>
                                <p class="text-xs text-slate-600 mt-1">{{ previewQuizResult.correctCount }} dari {{ previewQuizQuestions.length }} jawaban benar</p>
                                <div class="mt-5 p-4 rounded-lg bg-white border border-slate-200">
                                    <div class="text-[10px] font-bold uppercase tracking-wider text-slate-500">Normalized Gain — Hake's Formula</div>
                                    <div class="text-2xl font-black mt-1" :class="previewQuizResult.normalizedGain >= 0.7 ? 'text-emerald-700' : previewQuizResult.normalizedGain >= 0.3 ? 'text-blue-700' : 'text-amber-700'">g = {{ previewQuizResult.normalizedGain.toFixed(2) }}</div>
                                    <p class="text-[11px] text-slate-600 mt-1">({{ previewQuizResult.score }} − {{ previewQuizResult.preScore }}) ÷ (100 − {{ previewQuizResult.preScore }}) · {{ previewQuizResult.normalizedGain >= 0.7 ? 'Tinggi' : previewQuizResult.normalizedGain >= 0.3 ? 'Sedang' : 'Rendah' }}</p>
                                </div>
                                <button @click="startPreviewQuiz" class="mt-4 px-4 py-2 rounded-lg bg-blue-700 hover:bg-blue-800 text-white text-xs font-bold">Ulangi Ujian</button>
                            </div>

                            <div v-else-if="!previewQuizStarted" class="max-w-xl mx-auto py-6 text-center">
                                <div class="mx-auto w-14 h-14 rounded-2xl bg-blue-50 text-blue-700 border border-blue-100 flex items-center justify-center text-2xl font-black">Q</div>
                                <h4 class="mt-3 text-sm font-extrabold text-slate-900">Siap mengikuti evaluasi?</h4>
                                <p class="mt-1 text-xs text-slate-500">Timer 10 menit dimulai setelah Anda memilih tombol Kerjakan Ujian.</p>
                                <button @click="startPreviewQuiz" class="mt-4 px-5 py-2.5 rounded-lg bg-blue-700 hover:bg-blue-800 text-white text-xs font-extrabold shadow-sm">Kerjakan Ujian</button>
                            </div>

                            <form v-else @submit.prevent="submitPreviewQuiz" class="space-y-4">
                                <fieldset v-for="(question, index) in previewQuizQuestions" :key="question.id" class="rounded-xl border border-slate-200 p-4">
                                    <legend class="px-1 text-xs font-bold text-slate-900">{{ index + 1 }}. {{ question.question }}</legend>
                                    <div class="mt-2 grid grid-cols-1 md:grid-cols-2 gap-2">
                                        <label v-for="(option, key) in question.options" :key="key" class="flex items-start gap-2.5 p-3 rounded-lg border cursor-pointer transition-colors" :class="previewQuizAnswers[question.id] === key ? 'bg-blue-50 border-blue-300 text-blue-900' : 'bg-white border-slate-200 hover:bg-slate-50'">
                                            <input v-model="previewQuizAnswers[question.id]" type="radio" :name="'preview-quiz-' + question.id" :value="key" class="mt-0.5 text-blue-700 focus:ring-blue-600" />
                                            <span class="text-xs"><strong class="mr-1">{{ key }}.</strong>{{ option }}</span>
                                        </label>
                                    </div>
                                </fieldset>
                                <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 border-t border-slate-100 pt-4">
                                    <span class="text-[11px] text-slate-500">{{ Object.keys(previewQuizAnswers).length }} / {{ previewQuizQuestions.length }} soal dijawab</span>
                                    <button type="submit" class="px-5 py-2.5 rounded-lg bg-emerald-700 hover:bg-emerald-800 text-white text-xs font-extrabold">Kumpulkan Ujian</button>
                                </div>
                            </form>
                        </div>

                        <div v-else class="space-y-4">
                            <!-- LIVE TRAINING CENTER -->
                            <div v-if="calLiveSessions.length" class="bg-slate-900 text-white rounded-xl p-4 border border-slate-700">
                                <div class="flex items-center gap-3 mb-3">
                                    <span class="relative flex h-3 w-3">
                                        <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
                                        <span class="relative inline-flex rounded-full h-3 w-3 bg-emerald-500"></span>
                                    </span>
                                    <div>
                                        <p class="text-[11px] font-bold uppercase tracking-wider text-emerald-400">Live Training Center</p>
                                        <p class="text-xs text-slate-300">{{ calLiveSessions.length }} sesi kelas sedang aktif.</p>
                                    </div>
                                </div>
                                <div class="grid grid-cols-1 lg:grid-cols-2 gap-2">
                                    <div v-for="live in calLiveSessions" :key="'live-' + live.id" class="bg-slate-800 border border-slate-700 rounded-lg px-3 py-2 flex items-center justify-between gap-3 text-xs">
                                        <button type="button" class="text-left min-w-0" @click="calSelectedId = live.id">
                                            <p class="font-bold text-white truncate">[{{ live.course_code }}] {{ live.course_title }}</p>
                                            <p class="text-[10px] text-slate-400 truncate">{{ live.title }} • {{ live.trainer_name }} • {{ live.present_count }} hadir / {{ live.enrolled_count }} terdaftar</p>
                                        </button>
                                        <button v-if="calCanProjector" type="button" @click="calOpenProjector(live)" class="shrink-0 bg-emerald-600 hover:bg-emerald-500 text-white font-bold px-2.5 py-1 rounded text-[11px]">
                                            Buka Proyektor QR &rarr;
                                        </button>
                                        <button v-else type="button" @click="calSelectedId = live.id" class="shrink-0 border border-slate-600 hover:bg-slate-700 text-slate-200 font-bold px-2.5 py-1 rounded text-[11px]">Detail</button>
                                    </div>
                                </div>
                            </div>

                            <!-- KONTROL: SWITCHER, NAVIGASI, FILTER -->
                            <div class="bg-white border border-slate-200 rounded-xl p-3 sm:p-4 shadow-sm space-y-3">
                                <div class="flex flex-wrap items-center justify-between gap-3">
                                    <div class="inline-flex rounded-lg bg-slate-100 p-0.5 border border-slate-200 text-[11px] font-bold uppercase">
                                        <button type="button" @click="calNavigate('atmp', calAnchor)" :class="['px-3 py-1.5 rounded-md transition', calView === 'atmp' ? 'bg-slate-800 text-white shadow-sm' : 'text-slate-600 hover:text-slate-900']">ATMP (1 Tahun)</button>
                                        <button type="button" @click="calNavigate('monthly', calAnchor)" :class="['px-3 py-1.5 rounded-md transition', calView === 'monthly' ? 'bg-slate-800 text-white shadow-sm' : 'text-slate-600 hover:text-slate-900']">Plan Bulanan</button>
                                        <button type="button" @click="calNavigate('weekly', calAnchor)" :class="['px-3 py-1.5 rounded-md transition', calView === 'weekly' ? 'bg-slate-800 text-white shadow-sm' : 'text-slate-600 hover:text-slate-900']">Plan Mingguan</button>
                                    </div>
                                    <div class="flex items-center gap-2">
                                        <button type="button" @click="calShift(-1)" class="border border-slate-300 hover:bg-slate-100 rounded-lg px-2.5 py-1 text-xs font-bold">&larr;</button>
                                        <span class="font-mono font-bold text-sm text-slate-900 min-w-[150px] text-center">{{ calPeriodLabel }}</span>
                                        <button type="button" @click="calShift(1)" class="border border-slate-300 hover:bg-slate-100 rounded-lg px-2.5 py-1 text-xs font-bold">&rarr;</button>
                                        <button type="button" @click="calAnchor = calTodayIso" class="border border-slate-300 hover:bg-slate-100 rounded-lg px-2.5 py-1 text-xs font-bold">Hari Ini</button>
                                    </div>
                                </div>
                                <div class="pt-3 border-t border-slate-100 flex flex-wrap items-end gap-2.5">
                                    <div>
                                        <label class="block text-[10px] font-bold uppercase tracking-wider text-slate-500 mb-1">Bidang</label>
                                        <select v-model="calFilter.training_category" class="rounded-lg border-slate-300 text-xs py-1.5 px-2 bg-white">
                                            <option value="">Semua Bidang</option>
                                            <option v-for="cat in trainingCategories" :key="'calcat-' + cat" :value="cat">{{ cat }}</option>
                                        </select>
                                    </div>
                                    <div>
                                        <label class="block text-[10px] font-bold uppercase tracking-wider text-slate-500 mb-1">Jenis Training</label>
                                        <select v-model="calFilter.mandatory_type" class="rounded-lg border-slate-300 text-xs py-1.5 px-2 bg-white">
                                            <option value="">Mandatory &amp; Non</option>
                                            <option value="mandatory">Mandatory</option>
                                            <option value="non_mandatory">Non-Mandatory</option>
                                        </select>
                                    </div>
                                    <div>
                                        <label class="block text-[10px] font-bold uppercase tracking-wider text-slate-500 mb-1">Internal / External</label>
                                        <select v-model="calFilter.training_source" class="rounded-lg border-slate-300 text-xs py-1.5 px-2 bg-white">
                                            <option value="">Semua</option>
                                            <option value="internal">Internal</option>
                                            <option value="external">External</option>
                                        </select>
                                    </div>
                                    <div>
                                        <label class="block text-[10px] font-bold uppercase tracking-wider text-slate-500 mb-1">Status Rencana</label>
                                        <select v-model="calFilter.plan_status" class="rounded-lg border-slate-300 text-xs py-1.5 px-2 bg-white">
                                            <option value="">Approved &amp; Pending</option>
                                            <option value="approved">Approved</option>
                                            <option value="pending">Pending</option>
                                        </select>
                                    </div>
                                    <button type="button" @click="calResetFilters" class="text-xs font-semibold text-rose-700 hover:underline pb-2">&#10005; Reset</button>
                                    <div class="ml-auto flex flex-wrap items-center gap-1.5 text-[10px] font-bold uppercase pb-1.5">
                                        <span class="px-2 py-0.5 rounded bg-slate-100 text-slate-700 border border-slate-200">{{ calSummary.total }} Jadwal</span>
                                        <span class="px-2 py-0.5 rounded bg-emerald-50 text-emerald-800 border border-emerald-200">{{ calSummary.approved }} Approved</span>
                                        <span class="px-2 py-0.5 rounded bg-amber-50 text-amber-800 border border-amber-300">{{ calSummary.pending }} Pending</span>
                                    </div>
                                </div>
                            </div>

                            <!-- AREA TAMPILAN -->
                            <div class="bg-white border border-slate-200 rounded-xl p-3 sm:p-4 shadow-sm min-h-[420px]">
                                <!-- ATMP -->
                                <div v-if="calView === 'atmp'" class="space-y-3">
                                    <div class="flex justify-between items-center border-b border-slate-100 pb-2">
                                        <h3 class="text-xs font-bold uppercase text-slate-700">Annual Training Master Plan (ATMP) {{ calPeriodLabel }}</h3>
                                        <span class="text-[11px] text-slate-500">Garis putus-putus = usulan Pending</span>
                                    </div>
                                    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-3">
                                        <div v-for="m in calAtmpMonths" :key="'atmp-' + m.idx" class="border border-slate-200 rounded-lg bg-slate-50/60 p-3 flex flex-col min-h-[150px]">
                                            <div class="flex items-center justify-between border-b border-slate-200 pb-1 mb-2">
                                                <button type="button" class="text-xs font-bold uppercase text-slate-900 hover:underline" @click="calNavigate('monthly', m.firstDay)">{{ m.label }}</button>
                                                <span class="text-[10px] font-mono text-slate-500">{{ m.events.length }} jadwal<span v-if="m.pending"> • {{ m.pending }} pending</span></span>
                                            </div>
                                            <div class="space-y-1.5 flex-1">
                                                <button v-for="e in m.events.slice(0, 5)" :key="'atmpe-' + e.id" type="button" @click="calSelectedId = e.id" :class="['w-full text-left border rounded px-1.5 py-1 text-[11px]', calChipClass(e)]">
                                                    <span class="font-mono">{{ e.date.slice(8) }}</span> <b>[{{ e.course_code }}]</b> {{ e.course_title }}
                                                </button>
                                                <button v-if="m.events.length > 5" type="button" class="text-[10px] font-bold text-slate-600 hover:underline" @click="calNavigate('monthly', m.firstDay)">+{{ m.events.length - 5 }} jadwal lagi</button>
                                                <p v-if="!m.events.length" class="text-[11px] text-slate-400">Belum ada rencana.</p>
                                            </div>
                                            <button v-if="calCanManage" type="button" class="text-[10px] font-bold text-slate-600 hover:text-slate-900 text-right mt-2" @click="calOpenAdd(m.firstDay)">+ Tambah Jadwal &rarr;</button>
                                        </div>
                                    </div>
                                </div>

                                <!-- PLAN BULANAN -->
                                <div v-else-if="calView === 'monthly'">
                                    <div class="grid grid-cols-7 gap-px bg-slate-200 border border-slate-200 rounded-t-lg overflow-hidden text-center text-[11px] font-bold uppercase text-slate-600">
                                        <div v-for="w in calWeekdaysShort" :key="'wd-' + w" class="bg-slate-100 py-2">{{ w }}</div>
                                    </div>
                                    <div class="grid grid-cols-7 gap-px bg-slate-200 border-x border-b border-slate-200 rounded-b-lg overflow-hidden">
                                        <div v-for="cell in calMonthCells" :key="'cell-' + cell.iso" @click="calOpenAdd(cell.iso)" :class="['group p-1.5 min-h-[92px] flex flex-col gap-1', cell.inMonth ? 'bg-white' : 'bg-slate-50', calCanManage ? 'cursor-pointer hover:bg-slate-50' : '']">
                                            <div class="flex items-center justify-between">
                                                <span :class="['text-[11px] font-mono font-bold w-5 h-5 inline-flex items-center justify-center rounded-full', cell.isToday ? 'bg-slate-900 text-white' : (cell.inMonth ? 'text-slate-600' : 'text-slate-300')]">{{ cell.day }}</span>
                                                <span v-if="calCanManage" class="text-[10px] text-slate-300 group-hover:text-slate-600 font-bold">+</span>
                                            </div>
                                            <button v-for="e in cell.events.slice(0, 3)" :key="'ce-' + e.id" type="button" @click.stop="calSelectedId = e.id" :class="['w-full text-left border rounded px-1 py-0.5 text-[10px] truncate', calChipClass(e)]" :title="e.course_title + ' - ' + e.title">
                                                <span v-if="e.start_time" class="font-mono opacity-80">{{ e.start_time }}</span> <b>{{ e.course_code }}</b>
                                            </button>
                                            <button v-if="cell.events.length > 3" type="button" @click.stop="calNavigate('weekly', cell.iso)" class="text-left text-[10px] font-bold text-slate-600 hover:underline">+{{ cell.events.length - 3 }} lagi</button>
                                        </div>
                                    </div>
                                </div>

                                <!-- PLAN MINGGUAN -->
                                <div v-else class="divide-y divide-slate-100">
                                    <div v-for="d in calWeekDays" :key="'wk-' + d.iso" class="py-3 flex flex-col sm:flex-row sm:items-start gap-2">
                                        <div class="sm:w-36 shrink-0">
                                            <p :class="['text-xs font-bold', d.isToday ? 'text-sky-700' : 'text-slate-800']">{{ d.label }}</p>
                                            <p v-if="d.isToday" class="text-[10px] font-bold uppercase text-sky-600">Hari ini</p>
                                            <button v-if="calCanManage" type="button" class="mt-1 text-[10px] font-bold text-slate-500 hover:text-slate-900" @click="calOpenAdd(d.iso)">+ Tambah</button>
                                        </div>
                                        <div class="flex-1 space-y-2">
                                            <button v-for="e in d.events" :key="'we-' + e.id" type="button" @click="calSelectedId = e.id" class="w-full text-left bg-slate-50 hover:bg-slate-100 border border-slate-200 rounded-lg p-2.5 text-xs flex flex-wrap items-center justify-between gap-2">
                                                <div class="min-w-0">
                                                    <p class="font-bold text-slate-900">[{{ e.course_code }}] {{ e.course_title }}</p>
                                                    <p class="text-[11px] text-slate-500 mt-0.5"><span class="font-mono">{{ calTimeRange(e) }}</span><span v-if="e.location"> • {{ e.location }}</span> • {{ e.trainer_name }} • {{ e.title }}</p>
                                                </div>
                                                <div class="flex items-center gap-1.5 shrink-0">
                                                    <span :class="['px-1.5 py-0.5 border rounded text-[10px] font-bold', calPlanBadge(e).cls]">{{ calPlanBadge(e).label }}</span>
                                                    <span :class="['px-1.5 py-0.5 border rounded text-[10px] font-bold', calStatusBadge(e).cls]">{{ calStatusBadge(e).label }}</span>
                                                </div>
                                            </button>
                                            <p v-if="!d.events.length" class="text-[11px] text-slate-400 py-1">Tidak ada agenda.</p>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- MODAL TAMBAH JADWAL -->
                            <div v-if="calAddOpen" class="fixed inset-0 bg-slate-900/50 flex items-center justify-center z-50 p-4" @click.self="calAddOpen = false">
                                <form @submit.prevent="calSubmitAdd" class="bg-white border border-slate-300 rounded-xl w-full max-w-md p-5 space-y-3 shadow-xl max-h-[92vh] overflow-y-auto">
                                    <div class="flex justify-between items-center border-b border-slate-200 pb-3">
                                        <h3 class="text-xs font-bold uppercase text-slate-900">Tambah Jadwal Pelatihan</h3>
                                        <button type="button" @click="calAddOpen = false" class="text-slate-400 hover:text-slate-900 font-bold">&#10005;</button>
                                    </div>
                                    <div class="space-y-3 text-xs">
                                        <div>
                                            <label class="block font-bold text-slate-700 mb-1">Program Training (Course)</label>
                                            <select v-model="calForm.course_id" required class="w-full rounded-lg border-slate-300 text-xs px-3 py-2">
                                                <option value="" disabled>-- Pilih Course --</option>
                                                <option v-for="c in courses" :key="'calc-' + c.id" :value="c.id">[{{ c.code }}] {{ c.title }}</option>
                                            </select>
                                        </div>
                                        <div>
                                            <label class="block font-bold text-slate-700 mb-1">Judul Sesi / Batch</label>
                                            <input v-model="calForm.title" type="text" required placeholder="Contoh: Sesi Pagi - Batch 3" class="w-full rounded-lg border-slate-300 text-xs px-3 py-2" />
                                        </div>
                                        <div class="grid grid-cols-3 gap-2">
                                            <div><label class="block font-bold text-slate-700 mb-1">Tanggal</label><input v-model="calForm.date" type="date" required class="w-full rounded-lg border-slate-300 font-mono text-xs px-2 py-2" /></div>
                                            <div><label class="block font-bold text-slate-700 mb-1">Mulai</label><input v-model="calForm.start_time" type="time" class="w-full rounded-lg border-slate-300 font-mono text-xs px-2 py-2" /></div>
                                            <div><label class="block font-bold text-slate-700 mb-1">Selesai</label><input v-model="calForm.end_time" type="time" class="w-full rounded-lg border-slate-300 font-mono text-xs px-2 py-2" /></div>
                                        </div>
                                        <div class="grid grid-cols-3 gap-2">
                                            <div class="col-span-2"><label class="block font-bold text-slate-700 mb-1">Lokasi / Ruang</label><input v-model="calForm.location" type="text" placeholder="Ruang Training Utama" class="w-full rounded-lg border-slate-300 text-xs px-3 py-2" /></div>
                                            <div><label class="block font-bold text-slate-700 mb-1">Kuota</label><input v-model="calForm.quota" type="number" min="1" placeholder="tanpa batas" class="w-full rounded-lg border-slate-300 text-xs px-2 py-2" /></div>
                                        </div>
                                        <div>
                                            <label class="block font-bold text-slate-700 mb-1">Status Rencana</label>
                                            <select v-model="calForm.plan_status" class="w-full rounded-lg border-slate-300 text-xs px-3 py-2">
                                                <option value="approved">Approved (resmi dijadwalkan)</option>
                                                <option value="pending">Pending (usulan ATMP)</option>
                                            </select>
                                        </div>
                                    </div>
                                    <div class="flex justify-end gap-2 pt-3 border-t border-slate-200">
                                        <button type="button" @click="calAddOpen = false" class="border border-slate-300 rounded-lg px-3 py-1.5 text-xs font-bold text-slate-700">Batal</button>
                                        <button type="submit" class="bg-slate-900 hover:bg-slate-700 text-white rounded-lg px-4 py-1.5 text-xs font-bold">Simpan Jadwal</button>
                                    </div>
                                </form>
                            </div>

                            <!-- DRAWER DETAIL EVENT -->
                            <div v-if="calSelected" class="fixed inset-0 z-50 flex justify-end bg-slate-900/40" @click.self="calSelectedId = null">
                                <aside class="w-full max-w-sm bg-white h-full shadow-2xl border-l border-slate-200 p-5 overflow-y-auto space-y-4">
                                    <div class="flex items-start justify-between gap-3">
                                        <div>
                                            <span class="font-mono text-[10px] font-bold bg-slate-900 text-white px-1.5 py-0.5 rounded">{{ calSelected.course_code }}</span>
                                            <h3 class="mt-1.5 text-sm font-bold text-slate-900">{{ calSelected.course_title }}</h3>
                                            <p class="text-xs text-slate-500">{{ calSelected.title }}</p>
                                        </div>
                                        <button type="button" @click="calSelectedId = null" class="text-slate-400 hover:text-slate-900 font-bold">&#10005;</button>
                                    </div>
                                    <div class="flex flex-wrap gap-1.5">
                                        <span :class="['px-1.5 py-0.5 border rounded text-[10px] font-bold', calStatusBadge(calSelected).cls]">{{ calStatusBadge(calSelected).label }}</span>
                                        <span :class="['px-1.5 py-0.5 border rounded text-[10px] font-bold', calPlanBadge(calSelected).cls]">{{ calPlanBadge(calSelected).label }}</span>
                                        <span :class="['px-1.5 py-0.5 border rounded text-[10px] font-bold uppercase', calSelected.is_mandatory ? 'bg-rose-50 text-rose-800 border-rose-200' : 'bg-slate-100 text-slate-700 border-slate-200']">{{ calSelected.is_mandatory ? 'Mandatory' : 'Non-Mandatory' }}</span>
                                        <span class="px-1.5 py-0.5 border rounded text-[10px] font-bold uppercase bg-slate-100 text-slate-700 border-slate-200">{{ calSelected.training_source }}</span>
                                    </div>
                                    <dl class="text-xs space-y-2.5 border-t border-slate-100 pt-3">
                                        <div class="flex justify-between gap-3"><dt class="text-slate-500">Tanggal</dt><dd class="font-semibold text-slate-900 text-right">{{ calFmtLong(calSelected.date) }}</dd></div>
                                        <div class="flex justify-between gap-3"><dt class="text-slate-500">Jam</dt><dd class="font-mono font-semibold text-slate-900">{{ calTimeRange(calSelected) }}</dd></div>
                                        <div class="flex justify-between gap-3"><dt class="text-slate-500">Lokasi</dt><dd class="font-semibold text-slate-900 text-right">{{ calSelected.location || '-' }}</dd></div>
                                        <div class="flex justify-between gap-3"><dt class="text-slate-500">Trainer</dt><dd class="font-semibold text-slate-900 text-right">{{ calSelected.trainer_name }}</dd></div>
                                        <div class="flex justify-between gap-3"><dt class="text-slate-500">Hadir (sesi ini)</dt><dd class="font-semibold text-slate-900">{{ calSelected.present_count }}</dd></div>
                                    </dl>
                                    <div class="border-t border-slate-100 pt-3">
                                        <p class="text-[10px] font-bold uppercase tracking-wider text-slate-500 mb-1">Status Kuota</p>
                                        <p class="text-xs font-semibold text-slate-900">{{ calQuotaText(calSelected) }}</p>
                                        <div v-if="calSelected.quota" class="mt-1.5 w-full bg-slate-100 h-2 rounded overflow-hidden">
                                            <div :class="['h-full', calQuotaPct(calSelected) >= 100 ? 'bg-rose-500' : 'bg-emerald-500']" :style="{ width: calQuotaPct(calSelected) + '%' }"></div>
                                        </div>
                                    </div>
                                    <div class="border-t border-slate-100 pt-3 space-y-2">
                                        <button v-if="calCanProjector && calSelected.session_id && calSelected.status !== 'done'" type="button" @click="calOpenProjector(calSelected)" class="block w-full text-center bg-emerald-600 hover:bg-emerald-700 text-white rounded-lg px-3 py-2 text-xs font-bold">Buka Proyektor QR Absen &rarr;</button>
                                        <button v-if="calCanManage && calSelected.plan_status === 'pending'" type="button" @click="calApprove(calSelected)" class="w-full bg-slate-900 hover:bg-slate-700 text-white rounded-lg px-3 py-2 text-xs font-bold">Setujui Jadwal (Approved)</button>
                                        <p v-if="!calSelected.session_id" class="text-[11px] text-slate-500">Sesi presensi QR dibuat saat kelas dimulai oleh Trainer.</p>
                                    </div>
                                </aside>
                            </div>
                        </div>
                    </div>

                    <!-- VIEW 1J: MODUL MANAJEMEN TRAINER, ROSTER, TEACHING HOURS & KPI -->
                    <div v-else-if="currentView === 'admin-trainer-management'" class="space-y-6">
                        <!-- JIKA SEDANG MEMBUKA DETAIL 360° TRAINER -->
                        <div v-if="selectedTrainerDetail" class="space-y-5">
                            <!-- HEADER 360° -->
                            <div class="bg-white border border-slate-200 rounded-xl p-5 shadow-xs">
                                <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
                                    <div class="flex items-center gap-4">
                                        <div class="w-14 h-14 rounded-xl bg-blue-600 text-white flex items-center justify-center font-extrabold text-xl uppercase shadow-xs shrink-0">
                                            {{ selectedTrainerDetail.name.charAt(0) }}
                                        </div>
                                        <div>
                                            <div class="flex flex-wrap items-center gap-2">
                                                <h2 class="text-base sm:text-lg font-bold text-slate-900">{{ selectedTrainerDetail.name }}</h2>
                                                <span class="px-2.5 py-0.5 rounded-full text-[10px] font-bold bg-blue-50 text-blue-700 border border-blue-200">
                                                    {{ selectedTrainerDetail.trainer_type }}
                                                </span>
                                                <span :class="selectedTrainerDetail.today_roster.status === 'on_duty' ? 'bg-emerald-50 text-emerald-700 border-emerald-200' : 'bg-amber-50 text-amber-700 border-amber-200'" class="px-2.5 py-0.5 rounded-full text-[10px] font-bold border">
                                                    Roster: {{ selectedTrainerDetail.today_roster.label }}
                                                </span>
                                            </div>
                                            <div class="text-xs text-slate-500 font-mono mt-1">
                                                NIK: {{ selectedTrainerDetail.nik }} • {{ selectedTrainerDetail.email }} • Posisi: {{ selectedTrainerDetail.job_position }}
                                            </div>
                                            <div class="text-[11px] text-slate-500 mt-0.5">
                                                Pola Kerja Roster: <span class="font-bold text-slate-700">{{ selectedTrainerDetail.roster_pattern }}</span>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="flex items-center gap-2 shrink-0">
                                        <button
                                            type="button"
                                            @click="selectedTrainerDetail = null"
                                            class="px-3.5 py-2 text-xs font-bold text-slate-700 bg-slate-100 hover:bg-slate-200 rounded-lg transition-colors flex items-center gap-1.5"
                                        >
                                            &larr; Kembali ke Daftar Trainer
                                        </button>
                                    </div>
                                </div>

                                <!-- ALERT BENTROK JADWAL -->
                                <div v-if="selectedTrainerDetail.today_roster.status !== 'on_duty'" class="mt-4 p-3 rounded-lg bg-amber-50 border border-amber-200 text-amber-800 text-xs flex items-center gap-2">
                                    <span>⚠️</span>
                                    <span>Peringatan Sistem: Status Trainer hari ini adalah <b>{{ selectedTrainerDetail.today_roster.label }}</b> ({{ selectedTrainerDetail.today_roster.notes }}). Hindari penjadwalan kelas baru pada tanggal ini.</span>
                                </div>

                                <!-- 5 TABS NAVIGASI -->
                                <div class="flex items-center gap-1 border-b border-slate-200 mt-6 overflow-x-auto text-xs font-bold">
                                    <button
                                        type="button"
                                        @click="trainerTab = 'skills'"
                                        class="py-2.5 px-4 border-b-2 transition-colors whitespace-nowrap"
                                        :class="trainerTab === 'skills' ? 'border-blue-600 text-blue-700' : 'border-transparent text-slate-500 hover:text-slate-800'"
                                    >
                                        1. Kompetensi Ajar ({{ selectedTrainerDetail.authorized_skills.length }})
                                    </button>
                                    <button
                                        type="button"
                                        @click="trainerTab = 'roster'"
                                        class="py-2.5 px-4 border-b-2 transition-colors whitespace-nowrap"
                                        :class="trainerTab === 'roster' ? 'border-blue-600 text-blue-700' : 'border-transparent text-slate-500 hover:text-slate-800'"
                                    >
                                        2. Kalender Roster
                                    </button>
                                    <button
                                        type="button"
                                        @click="trainerTab = 'teaching_logs'"
                                        class="py-2.5 px-4 border-b-2 transition-colors whitespace-nowrap"
                                        :class="trainerTab === 'teaching_logs' ? 'border-blue-600 text-blue-700' : 'border-transparent text-slate-500 hover:text-slate-800'"
                                    >
                                        3. Riwayat Mengajar &amp; Peserta QR ({{ selectedTrainerDetail.teaching_logs.length }})
                                    </button>
                                    <button
                                        type="button"
                                        @click="trainerTab = 'kpis'"
                                        class="py-2.5 px-4 border-b-2 transition-colors whitespace-nowrap"
                                        :class="trainerTab === 'kpis' ? 'border-blue-600 text-blue-700' : 'border-transparent text-slate-500 hover:text-slate-800'"
                                    >
                                        4. Penugasan &amp; KPI ({{ selectedTrainerDetail.kpis.length }})
                                    </button>
                                    <button
                                        type="button"
                                        @click="trainerTab = 'evaluations'"
                                        class="py-2.5 px-4 border-b-2 transition-colors whitespace-nowrap"
                                        :class="trainerTab === 'evaluations' ? 'border-blue-600 text-blue-700' : 'border-transparent text-slate-500 hover:text-slate-800'"
                                    >
                                        5. Penilaian Peserta (★ {{ selectedTrainerDetail.average_rating }})
                                    </button>
                                </div>
                            </div>

                            <!-- TAB 1: KOMPETENSI AJAR -->
                            <div v-if="trainerTab === 'skills'" class="bg-white border border-slate-200 rounded-xl p-5 shadow-xs">
                                <div class="flex items-center justify-between pb-3 border-b border-slate-200 mb-4">
                                    <div>
                                        <h3 class="text-xs font-bold uppercase tracking-wider text-slate-900">Daftar Kompetensi &amp; Lisensi Mengajar</h3>
                                        <p class="text-xs text-slate-500">Materi yang berhak dibawakan oleh Trainer terverifikasi BNSP / ToT.</p>
                                    </div>
                                    <button type="button" @click="showAddSkillTrainerModal = true" class="px-3.5 py-1.5 text-xs font-bold text-white bg-blue-600 hover:bg-blue-700 rounded-lg shadow-sm">
                                        + Tambah Kompetensi Ajar
                                    </button>
                                </div>
                                <table class="w-full text-left text-xs text-slate-700">
                                    <thead class="bg-slate-50 border-b border-slate-200 text-[11px] font-bold uppercase text-slate-600">
                                        <tr>
                                            <th class="py-2 px-3">Kode &amp; Nama Kompetensi</th>
                                            <th class="py-2 px-3">Kategori</th>
                                            <th class="py-2 px-3">Jenis Lisensi ToT</th>
                                            <th class="py-2 px-3">Nomor Sertifikat</th>
                                            <th class="py-2 px-3">Berlaku Hingga</th>
                                            <th class="py-2 px-3 text-center">Status</th>
                                        </tr>
                                    </thead>
                                    <tbody class="divide-y divide-slate-100">
                                        <tr v-for="sk in selectedTrainerDetail.authorized_skills" :key="sk.id">
                                            <td class="py-2.5 px-3">
                                                <div class="font-bold text-blue-700 font-mono">{{ sk.code }}</div>
                                                <div class="text-slate-900 font-semibold">{{ sk.name }}</div>
                                            </td>
                                            <td class="py-2.5 px-3">{{ sk.category }}</td>
                                            <td class="py-2.5 px-3">{{ sk.license_type }}</td>
                                            <td class="py-2.5 px-3 font-mono text-slate-500">{{ sk.license_number }}</td>
                                            <td class="py-2.5 px-3">{{ sk.valid_until_formatted }}</td>
                                            <td class="py-2.5 px-3 text-center">
                                                <span :class="sk.status === 'active' ? 'bg-emerald-50 text-emerald-700 border-emerald-200' : 'bg-amber-50 text-amber-700 border-amber-200'" class="px-2 py-0.5 rounded text-[10px] font-bold border">
                                                    {{ sk.status === 'active' ? 'Aktif' : 'H-60 Segera Habis' }}
                                                </span>
                                            </td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>

                            <!-- TAB 2: KALENDER ROSTER -->
                            <div v-if="trainerTab === 'roster'" class="bg-white border border-slate-200 rounded-xl p-5 shadow-xs">
                                <div class="flex items-center justify-between pb-3 border-b border-slate-200 mb-4">
                                    <div>
                                        <h3 class="text-xs font-bold uppercase tracking-wider text-slate-900">Kalender Roster Oktober 2026</h3>
                                        <p class="text-xs text-slate-500">Jadwal On-Duty, Off-Roster, dan Cuti Tahunan Trainer.</p>
                                    </div>
                                    <button type="button" @click="showBulkRosterModalSim = true" class="px-3.5 py-1.5 text-xs font-bold text-white bg-blue-600 hover:bg-blue-700 rounded-lg shadow-sm">
                                        ⚡ Bulk Set Date Range
                                    </button>
                                </div>
                                <div class="grid grid-cols-2 sm:grid-cols-4 md:grid-cols-7 gap-2">
                                    <div
                                        v-for="d in 31"
                                        :key="'d-' + d"
                                        class="p-2.5 rounded-lg border border-slate-200 bg-white hover:border-blue-400 cursor-pointer flex flex-col justify-between min-h-[85px] transition-all"
                                    >
                                        <div class="flex justify-between items-center text-xs font-bold">
                                            <span>{{ d }} Okt</span>
                                            <span class="text-[9px] text-slate-400">{{ ['Min','Sen','Sel','Rab','Kam','Jum','Sab'][(d+3)%7] }}</span>
                                        </div>
                                        <div class="my-1">
                                            <span :class="[5,6,12,13,19,20,26,27].includes(d) ? 'bg-slate-100 text-slate-600 border-slate-300' : 'bg-emerald-50 text-emerald-800 border-emerald-300'" class="px-1.5 py-0.5 rounded text-[9px] font-bold border block text-center">
                                                {{ [5,6,12,13,19,20,26,27].includes(d) ? 'OFF ROSTER' : 'ON DUTY' }}
                                            </span>
                                        </div>
                                        <div class="text-[10px] text-slate-400 text-right">
                                            {{ d === 25 ? '1 Sesi Kelas' : '-' }}
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- TAB 3: RIWAYAT MENGAJAR & PESERTA QR -->
                            <div v-if="trainerTab === 'teaching_logs'" class="bg-white border border-slate-200 rounded-xl p-5 shadow-xs">
                                <div class="flex items-center justify-between pb-3 border-b border-slate-200 mb-4">
                                    <div>
                                        <h3 class="text-xs font-bold uppercase tracking-wider text-slate-900">Log Mengajar &amp; Jam Diakui (Teaching Hours)</h3>
                                        <p class="text-xs text-slate-500">Hasil absensi scan QR proyektor &amp; entri manual L&amp;D.</p>
                                    </div>
                                    <button type="button" @click="showManualLogModalSim = true" class="px-3.5 py-1.5 text-xs font-bold text-white bg-blue-600 hover:bg-blue-700 rounded-lg shadow-sm">
                                        + Input Jam Mengajar Manual
                                    </button>
                                </div>
                                <table class="w-full text-left text-xs text-slate-700">
                                    <thead class="bg-slate-50 border-b border-slate-200 text-[11px] font-bold uppercase text-slate-600">
                                        <tr>
                                            <th class="py-2 px-3">Tanggal</th>
                                            <th class="py-2 px-3">Topik Sesi &amp; Kode</th>
                                            <th class="py-2 px-3">Sumber Input</th>
                                            <th class="py-2 px-3 text-right">Durasi Jam</th>
                                            <th class="py-2 px-3 text-center">Peserta Hadir QR</th>
                                            <th class="py-2 px-3">Lokasi</th>
                                        </tr>
                                    </thead>
                                    <tbody class="divide-y divide-slate-100">
                                        <tr v-for="lg in selectedTrainerDetail.teaching_logs" :key="lg.id">
                                            <td class="py-2.5 px-3 font-mono">{{ lg.log_date_formatted }}</td>
                                            <td class="py-2.5 px-3">
                                                <div class="font-bold text-slate-900">{{ lg.training_title }}</div>
                                                <div class="text-[10px] text-blue-700 font-mono">{{ lg.course_code }}</div>
                                            </td>
                                            <td class="py-2.5 px-3">
                                                <span :class="lg.entry_source === 'auto_qr_session' ? 'bg-blue-50 text-blue-700 border-blue-200' : 'bg-purple-50 text-purple-700 border-purple-200'" class="px-2 py-0.5 rounded text-[10px] font-bold border">
                                                    {{ lg.entry_source === 'auto_qr_session' ? 'Auto QR' : 'Manual LnD' }}
                                                </span>
                                            </td>
                                            <td class="py-2.5 px-3 text-right font-extrabold text-slate-900">{{ lg.duration_hours }} Jam</td>
                                            <td class="py-2.5 px-3 text-center">
                                                <button
                                                    type="button"
                                                    @click="openParticipantsDrawerSim(lg)"
                                                    class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full bg-indigo-50 hover:bg-indigo-600 text-indigo-700 hover:text-white font-bold text-[11px] border border-indigo-200 transition-colors"
                                                >
                                                    👥 {{ lg.scanned_participants_count }} Peserta &rarr;
                                                </button>
                                            </td>
                                            <td class="py-2.5 px-3 text-slate-500">{{ lg.location }}</td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>

                            <!-- TAB 4: PENUGASAN & KPI -->
                            <div v-if="trainerTab === 'kpis'" class="bg-white border border-slate-200 rounded-xl p-5 shadow-xs">
                                <div class="flex items-center justify-between pb-3 border-b border-slate-200 mb-4">
                                    <div>
                                        <h3 class="text-xs font-bold uppercase tracking-wider text-slate-900">Target KPI &amp; Penugasan Admin LnD</h3>
                                        <p class="text-xs text-slate-500">Evaluasi pencapaian Jam Mengajar, Peserta, dan Rating Bintang aktual vs target.</p>
                                    </div>
                                    <button type="button" @click="showKpiModalSim = true" class="px-3.5 py-1.5 text-xs font-bold text-white bg-blue-600 hover:bg-blue-700 rounded-lg shadow-sm">
                                        + Tetapkan Target KPI Baru
                                    </button>
                                </div>
                                <div class="space-y-3">
                                    <div v-for="kp in selectedTrainerDetail.kpis" :key="kp.id" class="p-4 rounded-xl border border-slate-200 bg-slate-50/50">
                                        <div class="flex items-center justify-between mb-2">
                                            <div class="flex items-center gap-2">
                                                <h4 class="text-xs font-bold text-slate-900">{{ kp.title }}</h4>
                                                <span class="px-2 py-0.5 rounded text-[10px] font-bold bg-blue-50 text-blue-700 border border-blue-200">{{ kp.period_label }}</span>
                                            </div>
                                            <span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-emerald-100 text-emerald-800">
                                                Progress: {{ kp.progress_percentage }}%
                                            </span>
                                        </div>
                                        <div class="grid grid-cols-1 md:grid-cols-3 gap-3 pt-2 text-[11px]">
                                            <div>
                                                <div class="flex justify-between mb-1"><span>Jam Mengajar:</span><strong>{{ kp.actual_teaching_hours }} / {{ kp.target_teaching_hours }} Jam</strong></div>
                                                <div class="w-full bg-slate-200 h-2 rounded-full overflow-hidden"><div class="bg-blue-600 h-2" :style="{ width: Math.min(100, (kp.actual_teaching_hours / (kp.target_teaching_hours || 1)) * 100) + '%' }"></div></div>
                                            </div>
                                            <div>
                                                <div class="flex justify-between mb-1"><span>Peserta:</span><strong>{{ kp.actual_participants_count }} / {{ kp.target_participants_count }} Org</strong></div>
                                                <div class="w-full bg-slate-200 h-2 rounded-full overflow-hidden"><div class="bg-indigo-600 h-2" :style="{ width: Math.min(100, (kp.actual_participants_count / (kp.target_participants_count || 1)) * 100) + '%' }"></div></div>
                                            </div>
                                            <div>
                                                <div class="flex justify-between mb-1"><span>Rating:</span><strong>★ {{ kp.actual_rating }} / Min {{ kp.target_rating }}</strong></div>
                                                <div class="w-full bg-slate-200 h-2 rounded-full overflow-hidden"><div class="bg-amber-500 h-2" :style="{ width: Math.min(100, (kp.actual_rating / (kp.target_rating || 1)) * 100) + '%' }"></div></div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- TAB 5: EVALUASI & FEEDBACK -->
                            <div v-if="trainerTab === 'evaluations'" class="space-y-4">
                                <div class="grid grid-cols-2 sm:grid-cols-4 gap-3">
                                    <div class="bg-white border border-slate-200 rounded-xl p-3.5 text-center">
                                        <div class="text-[10px] font-bold text-slate-500 uppercase">Skor Keseluruhan</div>
                                        <div class="text-xl font-extrabold text-amber-500 mt-1">★ {{ selectedTrainerDetail.average_rating }} / 5</div>
                                    </div>
                                    <div class="bg-white border border-slate-200 rounded-xl p-3.5 text-center">
                                        <div class="text-[10px] font-bold text-blue-600 uppercase">Penguasaan Materi</div>
                                        <div class="text-xl font-extrabold text-blue-700 mt-1">4.9 / 5</div>
                                    </div>
                                    <div class="bg-white border border-slate-200 rounded-xl p-3.5 text-center">
                                        <div class="text-[10px] font-bold text-indigo-600 uppercase">Cara Penyampaian</div>
                                        <div class="text-xl font-extrabold text-indigo-700 mt-1">4.8 / 5</div>
                                    </div>
                                    <div class="bg-white border border-slate-200 rounded-xl p-3.5 text-center">
                                        <div class="text-[10px] font-bold text-emerald-600 uppercase">Ketepatan Waktu</div>
                                        <div class="text-xl font-extrabold text-emerald-700 mt-1">5.0 / 5</div>
                                    </div>
                                </div>

                                <div class="bg-white border border-slate-200 rounded-xl p-5 shadow-xs">
                                    <h3 class="text-xs font-bold uppercase tracking-wider text-slate-900 pb-3 border-b border-slate-200 mb-3">
                                        Ulasan &amp; Masukan Peserta Hadir ({{ selectedTrainerDetail.evaluations.length }})
                                    </h3>
                                    <div class="space-y-3">
                                        <div v-for="ev in selectedTrainerDetail.evaluations" :key="ev.id" class="p-3.5 rounded-lg border border-slate-200 bg-slate-50/50 space-y-1.5">
                                            <div class="flex items-center justify-between text-xs font-bold">
                                                <span>{{ ev.participant_name }} ({{ ev.participant_dept }})</span>
                                                <span class="text-amber-500">★ {{ ev.rating }}/5</span>
                                            </div>
                                            <p class="text-xs text-slate-800 italic bg-white p-2 rounded border border-slate-200">
                                                "{{ ev.comment }}"
                                            </p>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- DAFTAR INDEX SELURUH TRAINER (JIKA selectedTrainerDetail == null) -->
                        <div v-else class="space-y-6">
                            <!-- EXECUTIVE SUMMARY METRICS -->
                            <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-3">
                                <div class="bg-white border border-slate-200 rounded-xl p-3.5 shadow-xs">
                                    <div class="text-[10px] font-bold uppercase text-slate-500">Total Trainer</div>
                                    <div class="text-xl font-extrabold text-slate-900 mt-1">{{ trainersListSim.length }}</div>
                                    <div class="text-[11px] text-slate-500">SME &amp; Instruktur PBJ</div>
                                </div>
                                <div class="bg-white border border-slate-200 rounded-xl p-3.5 shadow-xs">
                                    <div class="text-[10px] font-bold uppercase text-emerald-600">On Duty Hari Ini</div>
                                    <div class="text-xl font-extrabold text-emerald-700 mt-1">2</div>
                                    <div class="text-[11px] text-emerald-600">Siap Mengajar</div>
                                </div>
                                <div class="bg-white border border-slate-200 rounded-xl p-3.5 shadow-xs">
                                    <div class="text-[10px] font-bold uppercase text-amber-600">Off / Cuti Hari Ini</div>
                                    <div class="text-xl font-extrabold text-amber-700 mt-1">2</div>
                                    <div class="text-[11px] text-amber-600">Off Roster &amp; Cuti</div>
                                </div>
                                <div class="bg-white border border-slate-200 rounded-xl p-3.5 shadow-xs">
                                    <div class="text-[10px] font-bold uppercase text-blue-600">Jam Mengajar Bulan Ini</div>
                                    <div class="text-xl font-extrabold text-blue-700 mt-1">63.0 Jam</div>
                                    <div class="text-[11px] text-blue-600">Akumulasi Terverifikasi</div>
                                </div>
                                <div class="bg-white border border-slate-200 rounded-xl p-3.5 shadow-xs">
                                    <div class="text-[10px] font-bold uppercase text-indigo-600">Total Peserta QR</div>
                                    <div class="text-xl font-extrabold text-indigo-700 mt-1">147</div>
                                    <div class="text-[11px] text-indigo-600">Tercatat di Proyektor</div>
                                </div>
                                <div class="bg-white border border-slate-200 rounded-xl p-3.5 shadow-xs">
                                    <div class="text-[10px] font-bold uppercase text-amber-500">Rata-rata Rating</div>
                                    <div class="text-xl font-extrabold text-amber-600 mt-1">★ 4.86</div>
                                    <div class="text-[11px] text-slate-500">Ulasan Peserta Hadir</div>
                                </div>
                            </div>

                            <!-- ========================================================================= -->
                            <!-- SECTION 2: JADWAL TRAINER MINGGU INI & BULAN INI (KALENDER & LIST)        -->
                            <!-- ========================================================================= -->
                            <div class="bg-white border border-slate-200 rounded-xl p-5 shadow-xs space-y-4">
                                <div class="flex flex-col md:flex-row md:items-center justify-between gap-3 pb-3 border-b border-slate-200">
                                    <div>
                                        <div class="flex items-center gap-2">
                                            <h3 class="text-sm sm:text-base font-bold text-slate-900">Jadwal Mengajar Instruktur (Minggu Ini &amp; Bulan Ini)</h3>
                                            <span class="px-2 py-0.5 rounded text-[10px] font-bold bg-blue-50 text-blue-700 border border-blue-200">
                                                Sync Live Roster
                                            </span>
                                        </div>
                                        <p class="text-xs text-slate-500 mt-0.5">
                                            Monitoring jadwal mengajar, ketersediaan roster, dan sesi aktif seluruh instruktur di Site PBJ
                                        </p>
                                    </div>

                                    <!-- VIEW SWITCHER & FILTER TRAINER -->
                                    <div class="flex flex-wrap items-center gap-2">
                                        <select
                                            v-model="trainerScheduleFilter"
                                            class="text-xs rounded-lg border-slate-300 py-1.5 px-2.5 font-medium focus:ring-blue-500 focus:border-blue-500"
                                        >
                                            <option value="">Semua Trainer (SME)</option>
                                            <option v-for="t in trainersListSim" :key="t.id" :value="t.id">{{ t.name }}</option>
                                        </select>

                                        <div class="inline-flex rounded-lg border border-slate-200 p-0.5 bg-slate-50 text-xs font-semibold">
                                            <button
                                                type="button"
                                                @click="trainerScheduleViewMode = 'week'"
                                                class="px-2.5 py-1 rounded-md transition-all"
                                                :class="trainerScheduleViewMode === 'week' ? 'bg-white text-blue-700 shadow-2xs font-bold' : 'text-slate-600 hover:text-slate-900'"
                                            >
                                                Minggu Ini (7 Hari)
                                            </button>
                                            <button
                                                type="button"
                                                @click="trainerScheduleViewMode = 'month'"
                                                class="px-2.5 py-1 rounded-md transition-all"
                                                :class="trainerScheduleViewMode === 'month' ? 'bg-white text-blue-700 shadow-2xs font-bold' : 'text-slate-600 hover:text-slate-900'"
                                            >
                                                Bulan Ini
                                            </button>
                                            <button
                                                type="button"
                                                @click="trainerScheduleViewMode = 'list'"
                                                class="px-2.5 py-1 rounded-md transition-all"
                                                :class="trainerScheduleViewMode === 'list' ? 'bg-white text-blue-700 shadow-2xs font-bold' : 'text-slate-600 hover:text-slate-900'"
                                            >
                                                Mode List
                                            </button>
                                        </div>
                                    </div>
                                </div>

                                <!-- 2A: TAMPILAN MINGGUAN (7-COLUMN GRID) -->
                                <div v-if="trainerScheduleViewMode === 'week'" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-7 gap-3">
                                    <div
                                        v-for="d in trainerWeekDays"
                                        :key="d.date"
                                        class="rounded-xl border p-3 flex flex-col min-h-[220px]"
                                        :class="d.isToday ? 'bg-blue-50/40 border-blue-300 ring-1 ring-blue-200' : 'bg-slate-50/60 border-slate-200'"
                                    >
                                        <div class="flex items-center justify-between pb-2 border-b border-slate-200/80 mb-2">
                                            <div>
                                                <div class="text-[10px] font-bold uppercase text-slate-500">{{ d.dayName }}</div>
                                                <div class="text-xs font-extrabold text-slate-900">{{ d.dayNum }} Okt</div>
                                            </div>
                                            <span v-if="d.isToday" class="px-1.5 py-0.5 rounded text-[9px] font-extrabold bg-blue-600 text-white uppercase tracking-wider">
                                                Hari Ini
                                            </span>
                                        </div>

                                        <!-- EVENT CARDS DALAM HARI INI -->
                                        <div class="flex-1 space-y-2">
                                            <div
                                                v-for="ev in getEventsForDay(d.date)"
                                                :key="ev.id"
                                                class="p-2.5 rounded-lg border bg-white shadow-2xs hover:border-blue-400 transition-all cursor-pointer"
                                                :class="ev.is_today ? 'border-blue-300' : 'border-slate-200'"
                                                @click="openTrainerScheduleDetail(ev)"
                                            >
                                                <div class="flex items-center justify-between text-[10px] font-bold">
                                                    <span class="text-blue-700">{{ ev.course_code }}</span>
                                                    <span :class="ev.status === 'in_progress' ? 'text-emerald-700 bg-emerald-50' : 'text-amber-700 bg-amber-50'" class="px-1.5 py-0.2 rounded font-mono">
                                                        {{ ev.status === 'in_progress' ? 'LIVE' : 'Plan' }}
                                                    </span>
                                                </div>
                                                <div class="text-[11px] font-bold text-slate-900 mt-1 line-clamp-2 leading-tight">
                                                    {{ ev.course_title }}
                                                </div>
                                                <div class="text-[10px] text-slate-500 font-medium mt-1">
                                                    👤 {{ ev.trainer_name.split(',')[0] }}
                                                </div>
                                                <div class="text-[10px] text-slate-500 font-mono mt-0.5">
                                                    🕒 {{ ev.start_time }} ({{ ev.duration_hours }}j)
                                                </div>
                                                <div class="mt-2 pt-1.5 border-t border-slate-100 flex items-center justify-between text-[10px]">
                                                    <span class="text-slate-600">{{ ev.quota_attended }}/{{ ev.quota_total }} Hadir</span>
                                                    <button class="text-blue-600 font-bold hover:underline">Detail &rarr;</button>
                                                </div>
                                            </div>

                                            <div v-if="getEventsForDay(d.date).length === 0" class="h-24 flex items-center justify-center text-[11px] text-slate-400 italic">
                                                Tidak ada sesi
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <!-- 2B: TAMPILAN BULANAN (GRID BULANAN LENGKAP) -->
                                <div v-else-if="trainerScheduleViewMode === 'month'" class="border border-slate-200 rounded-xl p-4 bg-slate-50/50">
                                    <div class="flex items-center justify-between mb-3 text-xs">
                                        <span class="font-bold text-slate-800">Kalender Sesi Mengajar — Oktober 2026</span>
                                        <span class="text-slate-500">Total {{ filteredTrainerScheduleEvents.length }} Sesi Terjadwal</span>
                                    </div>
                                    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-3">
                                        <div v-for="ev in filteredTrainerScheduleEvents" :key="ev.id" class="p-3.5 rounded-lg border border-slate-200 bg-white hover:border-blue-400 transition-colors shadow-2xs">
                                            <div class="flex items-center justify-between text-xs">
                                                <span class="font-bold text-blue-700">{{ ev.session_date_formatted }}</span>
                                                <span class="px-2 py-0.5 rounded text-[10px] font-bold bg-slate-100 text-slate-700">{{ ev.course_code }}</span>
                                            </div>
                                            <div class="text-xs font-bold text-slate-900 mt-1.5">{{ ev.course_title }}</div>
                                            <div class="text-[11px] text-slate-500 mt-0.5">{{ ev.session_title }}</div>
                                            <div class="mt-2.5 pt-2 border-t border-slate-100 flex items-center justify-between text-xs">
                                                <span class="font-medium text-slate-600">Instruktur: <b>{{ ev.trainer_name }}</b></span>
                                                <button @click="openTrainerScheduleDetail(ev)" class="px-2 py-0.5 rounded text-[11px] font-bold bg-blue-50 text-blue-700 hover:bg-blue-100">
                                                    Lihat Detail
                                                </button>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <!-- 2C: TAMPILAN MODE LIST (TABEL LENGKAP) -->
                                <div v-else-if="trainerScheduleViewMode === 'list'" class="overflow-x-auto border border-slate-200 rounded-lg">
                                    <table class="w-full text-left border-collapse text-xs">
                                        <thead>
                                            <tr class="border-b border-slate-200 bg-slate-50 text-slate-600 uppercase text-[10px] font-bold">
                                                <th class="py-2.5 px-3">Tanggal &amp; Waktu</th>
                                                <th class="py-2.5 px-3">Instruktur / Trainer</th>
                                                <th class="py-2.5 px-3">Kursus &amp; Sesi</th>
                                                <th class="py-2.5 px-3">Lokasi / Ruang</th>
                                                <th class="py-2.5 px-3 text-center">Durasi</th>
                                                <th class="py-2.5 px-3 text-center">Status</th>
                                                <th class="py-2.5 px-3 text-right">Aksi</th>
                                            </tr>
                                        </thead>
                                        <tbody class="divide-y divide-slate-100">
                                            <tr v-for="ev in filteredTrainerScheduleEvents" :key="ev.id" class="hover:bg-slate-50/80 transition-colors">
                                                <td class="py-2.5 px-3">
                                                    <div class="font-bold text-slate-900">{{ ev.session_date_formatted }}</div>
                                                    <div class="text-[10px] text-slate-500 font-mono">{{ ev.time_formatted }}</div>
                                                </td>
                                                <td class="py-2.5 px-3">
                                                    <div class="font-bold text-slate-900">{{ ev.trainer_name }}</div>
                                                    <div class="text-[10px] text-slate-500">{{ ev.trainer_type }}</div>
                                                </td>
                                                <td class="py-2.5 px-3">
                                                    <div class="font-bold text-blue-700">{{ ev.course_code }}</div>
                                                    <div class="text-slate-800 font-medium">{{ ev.course_title }}</div>
                                                </td>
                                                <td class="py-2.5 px-3 text-slate-600">{{ ev.room }}</td>
                                                <td class="py-2.5 px-3 text-center font-mono">{{ ev.duration_hours }} Jam</td>
                                                <td class="py-2.5 px-3 text-center">
                                                    <span :class="ev.status === 'in_progress' ? 'bg-emerald-50 text-emerald-700 border-emerald-200' : 'bg-amber-50 text-amber-700 border-amber-200'" class="px-2 py-0.5 rounded-full text-[10px] font-bold border">
                                                        {{ ev.status === 'in_progress' ? 'Berjalan' : 'Terjadwal' }}
                                                    </span>
                                                </td>
                                                <td class="py-2.5 px-3 text-right">
                                                    <button @click="openTrainerScheduleDetail(ev)" class="px-2.5 py-1 text-xs font-bold text-blue-600 bg-blue-50 hover:bg-blue-100 rounded">
                                                        Detail
                                                    </button>
                                                </td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </div>
                            </div>

                            <!-- FILTER BAR & ANGKAT MANPOWER JADI TRAINER -->
                            <div class="bg-white border border-slate-200 rounded-xl p-4 shadow-xs flex flex-col md:flex-row md:items-center justify-between gap-3">
                                <div class="grid grid-cols-1 sm:grid-cols-3 gap-2.5 flex-1">
                                    <input
                                        v-model="trainerSearchFilter"
                                        type="text"
                                        placeholder="Cari nama, NIK, departemen..."
                                        class="w-full text-xs rounded-lg border-slate-300 focus:border-blue-600 focus:ring-blue-600"
                                    />
                                    <select
                                        v-model="trainerTypeFilter"
                                        class="w-full text-xs rounded-lg border-slate-300 focus:border-blue-600 focus:ring-blue-600"
                                    >
                                        <option value="">Semua Tipe Trainer</option>
                                        <option value="INTERNAL_SME">Internal SME</option>
                                        <option value="FULL_TIME_LND">Full-Time LnD</option>
                                        <option value="EXTERNAL_VENDOR">External Vendor</option>
                                    </select>
                                    <select
                                        v-model="trainerRosterFilter"
                                        class="w-full text-xs rounded-lg border-slate-300 focus:border-blue-600 focus:ring-blue-600"
                                    >
                                        <option value="">Semua Status Roster</option>
                                        <option value="on_duty">ON DUTY</option>
                                        <option value="off_roster">OFF ROSTER</option>
                                        <option value="annual_leave">CUTI TAHUNAN</option>
                                    </select>
                                </div>

                                <button
                                    type="button"
                                    @click="showPromoteTrainerModal = true"
                                    class="px-4 py-2 text-xs font-bold text-white bg-blue-600 hover:bg-blue-700 rounded-lg shadow-sm flex items-center gap-1.5 transition-colors shrink-0"
                                >
                                    + Angkat Manpower Jadi Trainer
                                </button>
                            </div>

                            <!-- TABEL TRAINER -->
                            <div class="bg-white border border-slate-200 rounded-xl overflow-hidden shadow-xs">
                                <table class="w-full text-left text-xs text-slate-700">
                                    <thead class="bg-slate-50 border-b border-slate-200 text-[11px] font-bold uppercase text-slate-600">
                                        <tr>
                                            <th class="py-3 px-4">Nama Trainer / Instruktur</th>
                                            <th class="py-3 px-3">Tipe &amp; Pola Roster</th>
                                            <th class="py-3 px-3">Roster Hari Ini</th>
                                            <th class="py-3 px-3 text-center">Kompetensi Ajar</th>
                                            <th class="py-3 px-3 text-right">Jam Bulan Ini</th>
                                            <th class="py-3 px-3 text-right">Peserta QR</th>
                                            <th class="py-3 px-3 text-center">Rating Peserta</th>
                                            <th class="py-3 px-4 text-center">Aksi Kendali</th>
                                        </tr>
                                    </thead>
                                    <tbody class="divide-y divide-slate-100">
                                        <tr v-for="tr in filteredTrainersList" :key="tr.id" class="hover:bg-slate-50/70">
                                            <td class="py-3 px-4">
                                                <div class="font-bold text-slate-900">{{ tr.name }}</div>
                                                <div class="text-[11px] text-slate-500 font-mono">{{ tr.nik }} • {{ tr.department }}</div>
                                            </td>
                                            <td class="py-3 px-3">
                                                <span :class="tr.trainer_type === 'INTERNAL_SME' ? 'bg-blue-50 text-blue-700 border-blue-200' : tr.trainer_type === 'FULL_TIME_LND' ? 'bg-purple-50 text-purple-700 border-purple-200' : 'bg-amber-50 text-amber-700 border-amber-200'" class="px-2 py-0.5 rounded text-[10px] font-bold border">
                                                    {{ tr.trainer_type }}
                                                </span>
                                                <div class="text-[10px] text-slate-400 mt-0.5 font-mono">{{ tr.roster_pattern }}</div>
                                            </td>
                                            <td class="py-3 px-3">
                                                <span :class="tr.today_roster.status === 'on_duty' ? 'bg-emerald-50 text-emerald-700 border-emerald-200' : 'bg-slate-100 text-slate-700 border-slate-300'" class="px-2 py-0.5 rounded-full text-[10px] font-bold border">
                                                    {{ tr.today_roster.label }}
                                                </span>
                                            </td>
                                            <td class="py-3 px-3 text-center">
                                                <span class="px-2 py-0.5 rounded bg-blue-50 text-blue-700 font-extrabold text-[11px] border border-blue-200">
                                                    {{ tr.authorized_skills.length }} Skill
                                                </span>
                                            </td>
                                            <td class="py-3 px-3 text-right font-extrabold text-slate-900">{{ tr.month_teaching_hours }} Jam</td>
                                            <td class="py-3 px-3 text-right font-bold text-indigo-700">{{ tr.total_scanned_participants }}</td>
                                            <td class="py-3 px-3 text-center font-bold text-amber-500">★ {{ tr.average_rating }}</td>
                                            <td class="py-3 px-4 text-center">
                                                <button
                                                    type="button"
                                                    @click="selectedTrainerDetail = tr"
                                                    class="px-3 py-1.5 rounded-lg bg-blue-50 hover:bg-blue-600 text-blue-700 hover:text-white text-xs font-bold border border-blue-200 transition-colors"
                                                >
                                                    Buka Detail 360° &rarr;
                                                </button>
                                            </td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>

                        <!-- MODAL: ANGKAT MANPOWER SIM -->
                        <div v-if="showPromoteTrainerModal" class="fixed inset-0 z-50 bg-slate-900/60 backdrop-blur-xs flex items-center justify-center p-4">
                            <div class="bg-white rounded-xl shadow-2xl max-w-lg w-full p-6 space-y-4">
                                <div class="flex justify-between items-center pb-3 border-b border-slate-200">
                                    <h3 class="text-sm font-bold text-slate-900">Angkat Manpower Jadi Trainer</h3>
                                    <button @click="showPromoteTrainerModal = false" class="text-slate-400 hover:text-slate-600 text-lg">✕</button>
                                </div>
                                <form @submit.prevent="submitPromoteTrainerSim" class="space-y-3">
                                    <div>
                                        <label class="block text-xs font-bold text-slate-700 mb-1">Pilih Karyawan:</label>
                                        <select v-model="promoteTrainerForm.manpower_id" required class="w-full text-xs rounded-lg border-slate-300">
                                            <option value="">-- Pilih Karyawan Terdaftar --</option>
                                            <option v-for="p in participants" :key="p.id" :value="p.id">{{ p.name }} ({{ p.nik }}) - {{ p.department }}</option>
                                        </select>
                                    </div>
                                    <div class="grid grid-cols-2 gap-3">
                                        <div>
                                            <label class="block text-xs font-bold text-slate-700 mb-1">Tipe Trainer:</label>
                                            <select v-model="promoteTrainerForm.trainer_type" class="w-full text-xs rounded-lg border-slate-300">
                                                <option value="INTERNAL_SME">INTERNAL_SME</option>
                                                <option value="FULL_TIME_LND">FULL_TIME_LND</option>
                                                <option value="EXTERNAL_VENDOR">EXTERNAL_VENDOR</option>
                                            </select>
                                        </div>
                                        <div>
                                            <label class="block text-xs font-bold text-slate-700 mb-1">Pola Roster:</label>
                                            <input v-model="promoteTrainerForm.roster_pattern" type="text" class="w-full text-xs rounded-lg border-slate-300" />
                                        </div>
                                    </div>
                                    <div>
                                        <label class="block text-xs font-bold text-slate-700 mb-1">Pilih Kompetensi Ajar:</label>
                                        <div class="max-h-32 overflow-y-auto border border-slate-200 rounded p-2 bg-slate-50 space-y-1">
                                            <label v-for="sk in skills" :key="sk.id" class="flex items-center gap-2 text-xs">
                                                <input type="checkbox" :value="sk.id" v-model="promoteTrainerForm.skill_ids" class="rounded text-blue-600" />
                                                <span>[{{ sk.code }}] {{ sk.name }}</span>
                                            </label>
                                        </div>
                                    </div>
                                    <div class="flex justify-end gap-2 pt-3 border-t border-slate-200">
                                        <button type="button" @click="showPromoteTrainerModal = false" class="px-3.5 py-1.5 text-xs font-bold bg-slate-100 rounded-lg">Batal</button>
                                        <button type="submit" class="px-4 py-1.5 text-xs font-bold text-white bg-blue-600 rounded-lg">Simpan &amp; Angkat</button>
                                    </div>
                                </form>
                            </div>
                        </div>

                        <!-- MODAL: TAMBAH KOMPETENSI AJAR SIM -->
                        <div v-if="showAddSkillTrainerModal" class="fixed inset-0 z-50 bg-slate-900/60 backdrop-blur-xs flex items-center justify-center p-4">
                            <div class="bg-white rounded-xl shadow-2xl max-w-md w-full p-5 space-y-3">
                                <div class="flex justify-between items-center pb-2 border-b border-slate-200">
                                    <h3 class="text-sm font-bold text-slate-900">Tambah Lisensi Kompetensi Ajar</h3>
                                    <button @click="showAddSkillTrainerModal = false">✕</button>
                                </div>
                                <form @submit.prevent="submitAddSkillTrainerSim" class="space-y-3">
                                    <div>
                                        <label class="block text-xs font-bold text-slate-700 mb-1">Kompetensi:</label>
                                        <select v-model="addSkillTrainerForm.skill_id" required class="w-full text-xs rounded-lg border-slate-300">
                                            <option value="">-- Pilih Kompetensi --</option>
                                            <option v-for="sk in skills" :key="sk.id" :value="sk.id">[{{ sk.code }}] {{ sk.name }}</option>
                                        </select>
                                    </div>
                                    <div>
                                        <label class="block text-xs font-bold text-slate-700 mb-1">Jenis Lisensi ToT:</label>
                                        <input v-model="addSkillTrainerForm.license_type" type="text" class="w-full text-xs rounded-lg border-slate-300" />
                                    </div>
                                    <div>
                                        <label class="block text-xs font-bold text-slate-700 mb-1">Nomor Lisensi:</label>
                                        <input v-model="addSkillTrainerForm.license_number" type="text" placeholder="BNSP-TOT/..." class="w-full text-xs rounded-lg border-slate-300" />
                                    </div>
                                    <div class="flex justify-end gap-2 pt-2 border-t">
                                        <button type="button" @click="showAddSkillTrainerModal = false" class="px-3 py-1 text-xs font-bold bg-slate-100 rounded">Batal</button>
                                        <button type="submit" class="px-4 py-1 text-xs font-bold bg-blue-600 text-white rounded">Simpan</button>
                                    </div>
                                </form>
                            </div>
                        </div>

                        <!-- MODAL: INPUT JAM MENGAJAR MANUAL SIM -->
                        <div v-if="showManualLogModalSim" class="fixed inset-0 z-50 bg-slate-900/60 backdrop-blur-xs flex items-center justify-center p-4">
                            <div class="bg-white rounded-xl shadow-2xl max-w-md w-full p-5 space-y-3">
                                <div class="flex justify-between items-center pb-2 border-b border-slate-200">
                                    <h3 class="text-sm font-bold text-slate-900">Input Jam Mengajar Manual</h3>
                                    <button @click="showManualLogModalSim = false">✕</button>
                                </div>
                                <form @submit.prevent="submitManualLogSim" class="space-y-3">
                                    <div>
                                        <label class="block text-xs font-bold text-slate-700 mb-1">Nama Sesi Pelatihan:</label>
                                        <input v-model="manualLogFormSim.training_title" required type="text" placeholder="Pelatihan Offline K3" class="w-full text-xs rounded-lg border-slate-300" />
                                    </div>
                                    <div class="grid grid-cols-2 gap-3">
                                        <div>
                                            <label class="block text-xs font-bold text-slate-700 mb-1">Durasi Jam:</label>
                                            <input v-model.number="manualLogFormSim.duration_hours" type="number" step="0.5" class="w-full text-xs rounded-lg border-slate-300" />
                                        </div>
                                        <div>
                                            <label class="block text-xs font-bold text-slate-700 mb-1">Jumlah Peserta:</label>
                                            <input v-model.number="manualLogFormSim.scanned_participants_count" type="number" class="w-full text-xs rounded-lg border-slate-300" />
                                        </div>
                                    </div>
                                    <div class="flex justify-end gap-2 pt-2 border-t">
                                        <button type="button" @click="showManualLogModalSim = false" class="px-3 py-1 text-xs font-bold bg-slate-100 rounded">Batal</button>
                                        <button type="submit" class="px-4 py-1 text-xs font-bold bg-blue-600 text-white rounded">Simpan Log</button>
                                    </div>
                                </form>
                            </div>
                        </div>

                        <!-- MODAL: BULK SET ROSTER SIM -->
                        <div v-if="showBulkRosterModalSim" class="fixed inset-0 z-50 bg-slate-900/60 backdrop-blur-xs flex items-center justify-center p-4">
                            <div class="bg-white rounded-xl shadow-2xl max-w-md w-full p-5 space-y-3">
                                <div class="flex justify-between items-center pb-2 border-b border-slate-200">
                                    <h3 class="text-sm font-bold text-slate-900">Bulk Set Date Range Roster</h3>
                                    <button @click="showBulkRosterModalSim = false">✕</button>
                                </div>
                                <form @submit.prevent="submitBulkRosterSim" class="space-y-3">
                                    <div class="grid grid-cols-2 gap-3">
                                        <div>
                                            <label class="block text-xs font-bold text-slate-700 mb-1">Dari:</label>
                                            <input v-model="bulkRosterFormSim.start_date" type="date" class="w-full text-xs rounded-lg border-slate-300" />
                                        </div>
                                        <div>
                                            <label class="block text-xs font-bold text-slate-700 mb-1">Sampai:</label>
                                            <input v-model="bulkRosterFormSim.end_date" type="date" class="w-full text-xs rounded-lg border-slate-300" />
                                        </div>
                                    </div>
                                    <div>
                                        <label class="block text-xs font-bold text-slate-700 mb-1">Status Roster:</label>
                                        <select v-model="bulkRosterFormSim.status" class="w-full text-xs rounded-lg border-slate-300">
                                            <option value="on_duty">ON DUTY (Masuk)</option>
                                            <option value="off_roster">OFF ROSTER (Libur)</option>
                                            <option value="annual_leave">CUTI TAHUNAN</option>
                                        </select>
                                    </div>
                                    <div class="flex justify-end gap-2 pt-2 border-t">
                                        <button type="button" @click="showBulkRosterModalSim = false" class="px-3 py-1 text-xs font-bold bg-slate-100 rounded">Batal</button>
                                        <button type="submit" class="px-4 py-1 text-xs font-bold bg-blue-600 text-white rounded">Terapkan</button>
                                    </div>
                                </form>
                            </div>
                        </div>

                        <!-- MODAL: TAMBAH KPI SIM -->
                        <div v-if="showKpiModalSim" class="fixed inset-0 z-50 bg-slate-900/60 backdrop-blur-xs flex items-center justify-center p-4">
                            <div class="bg-white rounded-xl shadow-2xl max-w-md w-full p-5 space-y-3">
                                <div class="flex justify-between items-center pb-2 border-b border-slate-200">
                                    <h3 class="text-sm font-bold text-slate-900">Tetapkan Target KPI Baru</h3>
                                    <button @click="showKpiModalSim = false">✕</button>
                                </div>
                                <form @submit.prevent="submitKpiSim" class="space-y-3">
                                    <div>
                                        <label class="block text-xs font-bold text-slate-700 mb-1">Judul Target KPI:</label>
                                        <input v-model="kpiFormSim.title" required type="text" placeholder="Target Mengajar Bulanan" class="w-full text-xs rounded-lg border-slate-300" />
                                    </div>
                                    <div class="grid grid-cols-2 gap-3">
                                        <div>
                                            <label class="block text-xs font-bold text-slate-700 mb-1">Periode:</label>
                                            <select v-model="kpiFormSim.period" class="w-full text-xs rounded-lg border-slate-300">
                                                <option value="daily">Harian</option>
                                                <option value="weekly">Mingguan</option>
                                                <option value="monthly">Bulanan</option>
                                                <option value="yearly">Tahunan</option>
                                            </select>
                                        </div>
                                        <div>
                                            <label class="block text-xs font-bold text-slate-700 mb-1">Batas Waktu:</label>
                                            <input v-model="kpiFormSim.due_date" type="date" class="w-full text-xs rounded-lg border-slate-300" />
                                        </div>
                                    </div>
                                    <div class="grid grid-cols-3 gap-2">
                                        <div><label class="text-[10px] font-bold">Target Jam:</label><input v-model.number="kpiFormSim.target_hours" type="number" class="w-full text-xs rounded border-slate-300" /></div>
                                        <div><label class="text-[10px] font-bold">Target Peserta:</label><input v-model.number="kpiFormSim.target_participants" type="number" class="w-full text-xs rounded border-slate-300" /></div>
                                        <div><label class="text-[10px] font-bold">Target Rating:</label><input v-model.number="kpiFormSim.target_rating" type="number" step="0.1" class="w-full text-xs rounded border-slate-300" /></div>
                                    </div>
                                    <div class="flex justify-end gap-2 pt-2 border-t">
                                        <button type="button" @click="showKpiModalSim = false" class="px-3 py-1 text-xs font-bold bg-slate-100 rounded">Batal</button>
                                        <button type="submit" class="px-4 py-1 text-xs font-bold bg-blue-600 text-white rounded">Simpan Target</button>
                                    </div>
                                </form>
                            </div>
                        </div>

                        <!-- DRAWER: DAFTAR PESERTA QR -->
                        <div v-if="showParticipantsDrawerSim" class="fixed inset-0 z-50 bg-slate-900/60 backdrop-blur-xs flex items-center justify-center p-4">
                            <div class="bg-white rounded-xl shadow-2xl max-w-xl w-full p-5 space-y-3">
                                <div class="flex justify-between items-center pb-2 border-b border-slate-200">
                                    <div>
                                        <h3 class="text-sm font-bold text-slate-900">Daftar Lengkap Peserta Hadir (Scan QR)</h3>
                                        <p class="text-xs text-slate-500">{{ currentDrawerSessionTitleSim }}</p>
                                    </div>
                                    <button @click="showParticipantsDrawerSim = false" class="text-slate-400 hover:text-slate-600 text-lg">✕</button>
                                </div>
                                <div class="max-h-60 overflow-y-auto">
                                    <table v-if="currentDrawerParticipantsSim.length" class="w-full text-left text-xs text-slate-700">
                                        <thead class="bg-slate-50 border-b text-[10px] uppercase font-bold text-slate-500">
                                            <tr>
                                                <th class="py-1.5 px-2">Nama</th>
                                                <th class="py-1.5 px-2">NIK</th>
                                                <th class="py-1.5 px-2">Departemen</th>
                                                <th class="py-1.5 px-2 text-right">Waktu Scan</th>
                                            </tr>
                                        </thead>
                                        <tbody class="divide-y divide-slate-100">
                                            <tr v-for="cp in currentDrawerParticipantsSim" :key="cp.id">
                                                <td class="py-2 px-2 font-bold">{{ cp.name }}</td>
                                                <td class="py-2 px-2 font-mono text-slate-500">{{ cp.nik }}</td>
                                                <td class="py-2 px-2">{{ cp.department }}</td>
                                                <td class="py-2 px-2 text-right font-mono text-emerald-700 font-bold">{{ cp.scanned_at }}</td>
                                            </tr>
                                        </tbody>
                                    </table>
                                    <p v-else class="text-xs text-slate-400 py-6 text-center">Sesi input manual L&amp;D (tidak memiliki riwayat scan barcode perorangan).</p>
                                </div>
                                <div class="flex justify-end pt-2 border-t">
                                    <button type="button" @click="showParticipantsDrawerSim = false" class="px-4 py-1.5 text-xs font-bold bg-slate-100 hover:bg-slate-200 rounded">Tutup</button>
                                </div>
                            </div>
                        </div>

                        <!-- MODAL: LIVE ROTATING BARCODE / QR CODE ABSENSI (COMMAND CENTER) -->
                        <div v-if="showTrainerLiveQrModal" class="fixed inset-0 z-50 bg-slate-900/70 backdrop-blur-xs flex items-center justify-center p-4">
                            <div class="bg-white rounded-2xl shadow-2xl max-w-md w-full overflow-hidden border border-slate-200">
                                <div class="bg-blue-600 px-5 py-4 text-white flex items-center justify-between">
                                    <div class="flex items-center gap-2.5">
                                        <div class="w-8 h-8 rounded-lg bg-white/20 flex items-center justify-center font-bold">
                                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v1m6 11h2m-6 0h-2v4m0-11v3m0 0h.01M12 12h4.01M16 20h4M4 12h4m12 0h.01M5 8h2a1 1 0 001-1V5a1 1 0 00-1-1H5a1 1 0 00-1 1v2a1 1 0 001 1zm12 0h2a1 1 0 001-1V5a1 1 0 00-1-1h-2a1 1 0 00-1 1v2a1 1 0 001 1zM5 20h2a1 1 0 001-1v-2a1 1 0 00-1-1H5a1 1 0 00-1 1v2a1 1 0 001 1z"></path></svg>
                                        </div>
                                        <div>
                                            <h3 class="text-sm font-bold leading-tight">Barcode / QR Absen Peserta</h3>
                                            <p class="text-[11px] text-blue-100">Live Dynamic Token • Rotasi 15 Detik</p>
                                        </div>
                                    </div>
                                    <button @click="closeTrainerLiveQr" class="text-white/80 hover:text-white text-lg font-bold">✕</button>
                                </div>

                                <div class="p-6 text-center space-y-4">
                                    <div>
                                        <span class="px-2 py-0.5 rounded text-[10px] font-extrabold uppercase bg-emerald-100 text-emerald-800">
                                            SESI AKTIF HARI INI
                                        </span>
                                        <h4 class="text-sm font-bold text-slate-900 mt-1">Pelatihan K3 Dasar &amp; Pengenalan Tambang Emas</h4>
                                        <p class="text-xs text-slate-500 font-medium">Sesi 1 • Ruang Diklat Gd. Utama Lt. 2 (Site PBJ)</p>
                                    </div>

                                    <!-- NATIVE SVG QR MATRIX -->
                                    <div class="mx-auto w-48 h-48 p-2.5 rounded-xl border-2 border-slate-200 bg-white shadow-inner flex items-center justify-center">
                                        <svg viewBox="0 0 21 21" class="w-full h-full" shape-rendering="crispEdges">
                                            <rect width="21" height="21" fill="#ffffff" />
                                            <rect x="1" y="1" width="5" height="5" fill="#0f172a" />
                                            <rect x="2" y="2" width="3" height="3" fill="#ffffff" />
                                            <rect x="15" y="1" width="5" height="5" fill="#0f172a" />
                                            <rect x="16" y="2" width="3" height="3" fill="#ffffff" />
                                            <rect x="1" y="15" width="5" height="5" fill="#0f172a" />
                                            <rect x="2" y="16" width="3" height="3" fill="#ffffff" />
                                            <rect x="8" y="2" width="5" height="1" fill="#0f172a" />
                                            <rect x="10" y="4" width="3" height="2" fill="#0f172a" />
                                            <rect x="7" y="7" width="7" height="7" fill="#0f172a" />
                                            <rect x="8" y="8" width="5" height="5" fill="#ffffff" />
                                            <rect x="10" y="10" width="1" height="1" fill="#0f172a" />
                                            <rect x="2" y="8" width="4" height="2" fill="#0f172a" />
                                            <rect x="15" y="8" width="4" height="2" fill="#0f172a" />
                                            <rect x="8" y="15" width="5" height="2" fill="#0f172a" />
                                            <rect x="15" y="15" width="4" height="4" fill="#0f172a" />
                                        </svg>
                                    </div>

                                    <!-- ROTATION COUNTDOWN BAR -->
                                    <div class="space-y-1.5 max-w-xs mx-auto">
                                        <div class="flex items-center justify-between text-xs font-bold text-slate-600">
                                            <span class="flex items-center gap-1.5">
                                                <span class="w-2 h-2 rounded-full bg-emerald-500 animate-ping"></span>
                                                Rotasi Barcode
                                            </span>
                                            <span class="font-mono text-blue-700">{{ trainerQrTimer }}s</span>
                                        </div>
                                        <div class="w-full bg-slate-100 rounded-full h-2 overflow-hidden border border-slate-200">
                                            <div class="bg-blue-600 h-2 rounded-full transition-all duration-1000" :style="{ width: ((trainerQrTimer / 15) * 100) + '%' }"></div>
                                        </div>
                                    </div>

                                    <!-- BACKUP 6-DIGIT MANUAL PIN -->
                                    <div class="bg-slate-50 border border-slate-200 rounded-xl p-3.5 max-w-xs mx-auto">
                                        <div class="text-[10px] font-bold uppercase tracking-wider text-slate-500">Kode Input Manual Cadangan</div>
                                        <div class="text-xl font-extrabold text-slate-900 font-mono tracking-widest mt-0.5">
                                            {{ trainerQrCode }}
                                        </div>
                                        <div class="text-[10px] text-slate-400 mt-0.5">Jika kamera HP peserta kendala fokus</div>
                                    </div>

                                    <div class="text-xs text-slate-500 font-medium">
                                        Live Status: <span class="text-emerald-700 font-bold">18 Peserta Sudah Scan</span> • Kuota Total: 20
                                    </div>
                                </div>

                                <div class="bg-slate-50 px-5 py-3 border-t border-slate-200 flex items-center justify-between">
                                    <button
                                        type="button"
                                        @click="refreshTrainerQr"
                                        class="px-3 py-1.5 text-xs font-bold text-blue-700 bg-white border border-blue-200 hover:bg-blue-50 rounded-lg transition-colors flex items-center gap-1.5"
                                    >
                                        🔄 Refresh Token
                                    </button>
                                    <button
                                        type="button"
                                        @click="closeTrainerLiveQr"
                                        class="px-4 py-1.5 text-xs font-bold text-slate-700 bg-slate-200 hover:bg-slate-300 rounded-lg transition-colors"
                                    >
                                        Tutup Jendela
                                    </button>
                                </div>
                            </div>
                        </div>

                        <!-- MODAL: DETAIL JADWAL SESI TRAINER -->
                        <div v-if="trainerScheduleDetailModal" class="fixed inset-0 z-50 bg-slate-900/60 backdrop-blur-xs flex items-center justify-center p-4">
                            <div class="bg-white rounded-2xl shadow-2xl max-w-lg w-full overflow-hidden border border-slate-200">
                                <div class="bg-slate-900 px-5 py-4 text-white flex items-center justify-between">
                                    <div>
                                        <span class="px-2 py-0.5 rounded text-[10px] font-bold bg-blue-500 text-white uppercase">
                                            {{ trainerScheduleDetailModal.course_code }}
                                        </span>
                                        <h3 class="text-sm font-bold text-white mt-1">{{ trainerScheduleDetailModal.course_title }}</h3>
                                    </div>
                                    <button @click="closeTrainerScheduleDetail" class="text-slate-400 hover:text-white text-lg font-bold">✕</button>
                                </div>
                                <div class="p-5 space-y-4 text-xs">
                                    <div class="grid grid-cols-2 gap-3 bg-slate-50 p-3 rounded-xl border border-slate-200">
                                        <div>
                                            <span class="text-slate-500 text-[10px] uppercase font-bold block">Instruktur / Trainer</span>
                                            <span class="font-bold text-slate-900">{{ trainerScheduleDetailModal.trainer_name }}</span>
                                            <span class="text-[10px] text-slate-500 block">({{ trainerScheduleDetailModal.trainer_type }})</span>
                                        </div>
                                        <div>
                                            <span class="text-slate-500 text-[10px] uppercase font-bold block">Waktu &amp; Tanggal</span>
                                            <span class="font-bold text-slate-900">{{ trainerScheduleDetailModal.session_date_formatted }}</span>
                                            <span class="text-[10px] text-slate-600 font-mono block">{{ trainerScheduleDetailModal.time_formatted }}</span>
                                        </div>
                                        <div>
                                            <span class="text-slate-500 text-[10px] uppercase font-bold block">Ruangan / Lokasi</span>
                                            <span class="font-bold text-slate-800">{{ trainerScheduleDetailModal.room }}</span>
                                        </div>
                                        <div>
                                            <span class="text-slate-500 text-[10px] uppercase font-bold block">Durasi Diakui</span>
                                            <span class="font-bold text-blue-700 font-mono">{{ trainerScheduleDetailModal.duration_hours }} Jam (Sah)</span>
                                        </div>
                                    </div>

                                    <div>
                                        <h4 class="font-bold text-slate-900 uppercase text-[11px] mb-1.5">Topik &amp; Silabus Sesi</h4>
                                        <p class="text-slate-700 p-3 bg-slate-50 rounded-lg border border-slate-200 leading-relaxed">
                                            {{ trainerScheduleDetailModal.session_title }}
                                        </p>
                                    </div>

                                    <div>
                                        <div class="flex items-center justify-between mb-1.5">
                                            <h4 class="font-bold text-slate-900 uppercase text-[11px]">Daftar Peserta Terdaftar ({{ trainerScheduleDetailModal.participants?.length || 0 }})</h4>
                                            <span class="text-[11px] font-bold text-blue-600">{{ trainerScheduleDetailModal.quota_attended }}/{{ trainerScheduleDetailModal.quota_total }} Hadir</span>
                                        </div>
                                        <div class="max-h-36 overflow-y-auto border border-slate-200 rounded-lg divide-y divide-slate-100">
                                            <div v-for="(p, idx) in trainerScheduleDetailModal.participants" :key="idx" class="p-2 flex items-center justify-between bg-white text-[11px]">
                                                <div>
                                                    <span class="font-bold text-slate-900">{{ p.name }}</span>
                                                    <span class="text-slate-400 font-mono"> ({{ p.nik }})</span>
                                                    <span class="text-slate-500 ml-1">• {{ p.dept }}</span>
                                                </div>
                                                <span :class="p.status === 'Present' ? 'bg-emerald-50 text-emerald-700' : 'bg-slate-100 text-slate-600'" class="px-2 py-0.5 rounded text-[10px] font-bold">
                                                    {{ p.status }}
                                                </span>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div class="bg-slate-50 px-5 py-3 border-t border-slate-200 flex justify-end gap-2">
                                    <button
                                        type="button"
                                        @click="closeTrainerScheduleDetail"
                                        class="px-4 py-1.5 text-xs font-bold text-slate-700 bg-slate-200 hover:bg-slate-300 rounded-lg"
                                    >
                                        Tutup
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
            </div>
        </div>

        <!-- ================================================================ -->
        <!-- 2. MOBILE WEB APP PESERTA LAYOUT (max-w-md mx-auto)              -->
        <!-- ================================================================ -->
        <div v-else-if="currentView.startsWith('mobile-')" class="bg-slate-200 min-h-[calc(100vh-41px)]">
            <div class="max-w-md mx-auto min-h-[calc(100vh-41px)] bg-slate-50 border-x border-slate-300 flex flex-col relative pb-20 shadow-xl">
                <!-- KOMPONEN PWA INSTALL BANNER (PwaInstallBanner.vue - Calm Soft Emerald/Blue Banner) -->
                <div v-if="showPwaBanner" class="bg-blue-50/90 text-slate-800 px-4 py-3 flex items-center justify-between border-b border-blue-200">
                    <div class="text-xs pr-2">
                        <div class="flex items-center gap-2">
                            <p class="font-bold text-blue-700">Install Aplikasi Pelatihan</p>
                            <button @click="previewIosPwa = !previewIosPwa" class="text-[10px] px-2 py-0.5 rounded-md bg-white text-slate-600 border border-slate-200">
                                Mode: {{ previewIosPwa ? 'iOS Safari' : 'Android Chrome' }}
                            </button>
                        </div>
                        <p v-if="!previewIosPwa" class="text-slate-600 mt-0.5">Akses Scan QR Absen &amp; Rapor Skill 2x lebih cepat dari layar utama HP.</p>
                        <p v-else class="text-slate-600 mt-0.5">
                            Ketuk ikon <b>Share (Bagikan)</b> di bawah browser, lalu pilih <b>"Add to Home Screen"</b>.
                        </p>
                    </div>
                    <div class="flex items-center gap-2 shrink-0">
                        <button
                            v-if="!previewIosPwa"
                            @click="notify('Simulasi PWA: Prompt Install Aplikasi TrainingApp berhasil dijalankan!'); showPwaBanner = false"
                            class="bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-bold px-3.5 py-1.5 rounded-lg"
                        >
                            Install
                        </button>
                        <button @click="showPwaBanner = false" class="text-slate-400 hover:text-slate-700 text-xs px-1.5 py-1">
                            ✕
                        </button>
                    </div>
                </div>

                <!-- Mobile Sticky Header -->
                <header class="sticky top-[41px] z-20 bg-white border-b border-slate-200 px-4 py-3 flex items-center justify-between">
                    <div>
                        <div class="text-[10px] font-bold uppercase tracking-wider text-blue-600">L&D Mobile Portal</div>
                        <h1 class="text-sm font-bold text-slate-900">
                            {{ currentView === 'mobile-home' ? 'Beranda & Kelas Saya' : currentView === 'mobile-scan' ? 'Presensi Rotating QR' : 'Profil & Radar Kompetensi' }}
                        </h1>
                    </div>
                    <div class="text-right">
                        <select v-model="activeParticipantId" class="text-xs font-bold text-slate-800 border-slate-200 rounded py-1 pl-2 pr-6 bg-slate-50">
                            <option v-for="p in participants" :key="p.id" :value="p.id">{{ p.name }} ({{ p.nik }})</option>
                        </select>
                    </div>
                </header>

                <!-- Flash Message Mobile -->
                <div v-if="flashMessage" class="px-4 pt-3">
                    <div :class="['p-2.5 rounded border text-xs font-semibold', flashType === 'error' ? 'bg-rose-50 border-rose-200 text-rose-800' : 'bg-emerald-50 border-emerald-200 text-emerald-800']">
                        {{ flashMessage }}
                    </div>
                </div>

                <main class="flex-1 p-4">
                    <!-- MOBILE VIEW 2A: HOME & KELAS SAYA -->
                    <div v-if="currentView === 'mobile-home'">
                        <div class="bg-blue-50 border border-blue-200 text-slate-800 rounded-xl p-4 mb-4 flex items-center justify-between shadow-sm">
                            <div>
                                <div class="text-[10px] font-bold uppercase text-blue-700">Presensi Cepat</div>
                                <div class="text-xs font-bold mt-0.5 text-slate-900">Sedang di ruang kelas pelatihan?</div>
                                <div class="text-[11px] text-slate-600">PIN Aktif: <strong class="text-amber-700 font-mono">{{ dynamicQrPayload.manual_code }}</strong></div>
                            </div>
                            <button @click="currentView = 'mobile-scan'" class="px-3.5 py-2 rounded-lg bg-blue-600 hover:bg-blue-700 text-white text-xs font-bold shrink-0 shadow-sm">
                                Scan QR →
                            </button>
                        </div>

                        <div class="flex items-center justify-between mb-2.5">
                            <h2 class="text-xs font-bold uppercase tracking-wider text-slate-700">Kelas Pelatihan Aktif</h2>
                            <button @click="currentView = 'mobile-skills'" class="text-[11px] font-semibold text-blue-600">Lihat Radar Skill →</button>
                        </div>

                        <div class="space-y-3">
                            <div v-for="c in courses" :key="c.id" class="bg-white border border-slate-200 rounded-md p-4">
                                <div class="flex justify-between items-start">
                                    <div>
                                        <span class="text-[10px] font-bold px-1.5 py-0.5 rounded bg-blue-50 text-blue-700 border border-blue-200">{{ c.code }}</span>
                                        <h3 class="text-xs font-bold text-slate-900 mt-1.5">{{ c.title }}</h3>
                                        <p class="text-[11px] text-slate-500 mt-0.5">Trainer: {{ c.trainer_name }}</p>
                                    </div>
                                    <span class="px-2 py-0.5 rounded text-[10px] font-bold uppercase bg-emerald-50 text-emerald-700 border border-emerald-200">APPROVED</span>
                                </div>
                                <div class="mt-3 pt-3 border-t border-slate-100">
                                    <div class="flex justify-between text-xs mb-1.5">
                                        <span class="text-slate-600">Progres Penyelesaian Modul</span>
                                        <span class="font-extrabold text-blue-600">75%</span>
                                    </div>
                                    <svg viewBox="0 0 200 8" class="w-full h-2 rounded overflow-hidden">
                                        <rect x="0" y="0" width="200" height="8" fill="#e2e8f0" />
                                        <rect x="0" y="0" width="150" height="8" fill="#2563eb" />
                                    </svg>
                                </div>
                            </div>
                        </div>
                        <div class="mt-4 pt-3 border-t border-slate-200">
                            <h2 class="text-xs font-bold uppercase tracking-wider text-slate-700 mb-2">
                                Jadwal Mendatang &amp; Sertifikat Saya
                            </h2>
                            <div class="bg-white border border-slate-200 rounded-md p-3.5 flex items-center justify-between gap-2">
                                <div>
                                    <div class="text-xs font-bold text-slate-900">Sertifikat Kompetensi &amp; Rapor A4</div>
                                    <div class="text-[11px] text-slate-500">No: CERT/PANI-LND/2026/00{{ activeParticipant.id }} &bull; Berlaku s/d Des 2027</div>
                                </div>
                                <button @click="openPrintReport(activeParticipant.id)" class="px-3 py-1.5 rounded bg-emerald-600 hover:bg-emerald-700 text-white text-[11px] font-bold shrink-0">
                                    Unduh Sertifikat Saya →
                                </button>
                            </div>
                        </div>
                    </div>

                    <!-- MOBILE VIEW 2B: SCAN QR & INPUT PIN 6-DIGIT -->
                    <div v-else-if="currentView === 'mobile-scan'">
                        <div class="bg-white border border-slate-200 rounded-md p-4 mb-4 text-center">
                            <div class="flex items-center justify-between mb-3 text-left">
                                <div>
                                    <h2 class="text-xs font-bold uppercase text-slate-900">Scanner Kamera Rotating QR</h2>
                                    <p class="text-[11px] text-slate-500">Toleransi lag jaringan: 15-30 detik (Window T & T-1)</p>
                                </div>
                                <span class="px-2 py-0.5 rounded text-[10px] font-bold bg-blue-50 text-blue-700 border border-blue-200">HMAC-SHA256</span>
                            </div>

                            <div class="py-6 px-4 rounded border border-dashed border-slate-300 bg-slate-50">
                                <div class="text-xs font-semibold text-slate-700 mb-2">PIN Proyektor Aktif Saat Ini ({{ rotationCountdown }}d):</div>
                                <div class="text-2xl font-mono font-black tracking-widest text-blue-700 mb-3">{{ dynamicQrPayload.manual_code }}</div>
                                <button @click="fillCurrentPin" class="w-full py-2.5 px-4 rounded bg-blue-600 hover:bg-blue-700 text-white text-xs font-bold">
                                    ⚡ Ambil Token / PIN dari Proyektor
                                </button>
                                <button @click="focusManualPinInput" class="mt-2 w-full py-2 px-4 rounded bg-slate-200 hover:bg-slate-300 text-slate-800 text-xs font-bold">
                                    ⌨️ Ketik Kode Manual 6-Digit (Fallback iOS/Android)
                                </button>
                            </div>
                        </div>

                        <div class="bg-white border border-slate-200 rounded-md p-4">
                            <h3 class="text-xs font-bold uppercase text-slate-900 mb-1">Input Kode PIN 6-Digit / Payload</h3>
                            <p class="text-[11px] text-slate-500 mb-3">Ketik 6 digit PIN yang tampil di layar proyektor Trainer:</p>
                            <form @submit.prevent="submitMobileScan" class="space-y-3">
                                <input id="manual-pin-input" v-model="mobileScanInput" type="text" required placeholder="Ketik 6-digit PIN..." class="w-full rounded border-slate-300 font-mono text-sm tracking-widest uppercase py-2.5 px-3" />
                                <button type="submit" class="w-full py-2.5 px-4 rounded-lg bg-blue-600 hover:bg-blue-700 text-white text-xs sm:text-sm font-bold shadow-sm">
                                    Verifikasi & Catat Kehadiran
                                </button>
                            </form>
                        </div>

                        <!-- FORM SINGKAT: NILAI TRAINER SESI INI (TUGAS 3 - Poin 2) -->
                        <div v-if="showMobileEvalCard" class="bg-white border-2 border-amber-300 rounded-xl p-4 mt-4 shadow-lg animate-fade-in">
                            <div class="flex items-center justify-between pb-2 border-b border-slate-200 mb-3">
                                <div class="flex items-center gap-2">
                                    <span class="text-xl">⭐</span>
                                    <div>
                                        <h3 class="text-xs font-bold text-slate-900">Nilai Trainer Sesi Ini</h3>
                                        <p class="text-[10px] text-slate-500">Dr. Siti Rahmawati — K3 Dasar Tambang</p>
                                    </div>
                                </div>
                                <button type="button" @click="showMobileEvalCard = false" class="text-slate-400 hover:text-slate-600 text-sm">✕</button>
                            </div>

                            <form @submit.prevent="submitMobileEvaluationSim" class="space-y-3">
                                <div>
                                    <label class="block text-[11px] font-bold text-slate-700 mb-1">Kepuasan Keseluruhan (Rating Bintang 1-5):</label>
                                    <div class="flex items-center gap-2 text-2xl text-amber-400">
                                        <button v-for="star in 5" :key="star" type="button" @click="mobileEvalForm.rating = star" class="transition-transform hover:scale-125">
                                            {{ star <= mobileEvalForm.rating ? '★' : '☆' }}
                                        </button>
                                        <span class="text-xs font-bold text-slate-700 ml-1">({{ mobileEvalForm.rating }}/5)</span>
                                    </div>
                                </div>

                                <div class="grid grid-cols-3 gap-2 text-[10px]">
                                    <div>
                                        <span class="font-bold text-slate-600">Penguasaan:</span>
                                        <select v-model.number="mobileEvalForm.material_mastery" class="w-full rounded text-xs border-slate-300 py-1">
                                            <option v-for="n in 5" :key="n" :value="n">{{ n }} ★</option>
                                        </select>
                                    </div>
                                    <div>
                                        <span class="font-bold text-slate-600">Penyampaian:</span>
                                        <select v-model.number="mobileEvalForm.delivery_method" class="w-full rounded text-xs border-slate-300 py-1">
                                            <option v-for="n in 5" :key="n" :value="n">{{ n }} ★</option>
                                        </select>
                                    </div>
                                    <div>
                                        <span class="font-bold text-slate-600">Ketepatan:</span>
                                        <select v-model.number="mobileEvalForm.punctuality" class="w-full rounded text-xs border-slate-300 py-1">
                                            <option v-for="n in 5" :key="n" :value="n">{{ n }} ★</option>
                                        </select>
                                    </div>
                                </div>

                                <div>
                                    <label class="block text-[11px] font-bold text-slate-700 mb-1">Komentar / Masukan Konstruktif:</label>
                                    <textarea v-model="mobileEvalForm.comment" rows="2" placeholder="Bagikan tanggapan Anda tentang cara mengajar Trainer..." class="w-full rounded text-xs border-slate-300 p-2"></textarea>
                                </div>

                                <div class="flex justify-end gap-2 pt-2 border-t">
                                    <button type="button" @click="showMobileEvalCard = false" class="px-3 py-1.5 text-xs font-bold text-slate-600 bg-slate-100 rounded">Nanti Saja</button>
                                    <button type="submit" class="px-4 py-1.5 text-xs font-bold text-white bg-amber-500 hover:bg-amber-600 rounded shadow-sm">Kirim Penilaian</button>
                                </div>
                            </form>
                        </div>
                    </div>

                    <!-- MOBILE VIEW 2C: PROFIL & NATIVE SVG RADAR CHART -->
                    <div v-else-if="currentView === 'mobile-skills'">
                        <div class="grid grid-cols-3 gap-2.5 mb-4">
                            <div class="bg-white border border-slate-200 rounded-md p-3 text-center">
                                <div class="text-[10px] font-bold uppercase text-slate-400">Rata-rata</div>
                                <div class="text-base font-extrabold text-blue-600 mt-0.5">{{ participantRadar.avgCur }} <span class="text-xs text-slate-400 font-normal">/ {{ participantRadar.avgTar }}</span></div>
                            </div>
                            <div class="bg-white border border-emerald-200 rounded-md p-3 text-center">
                                <div class="text-[10px] font-bold uppercase text-emerald-700">Kompeten</div>
                                <div class="text-base font-extrabold text-emerald-700 mt-0.5">{{ participantRadar.compCount }} Skill</div>
                            </div>
                            <div class="bg-white border border-rose-200 rounded-md p-3 text-center">
                                <div class="text-[10px] font-bold uppercase text-rose-700">Gap Minus</div>
                                <div class="text-base font-extrabold text-rose-700 mt-0.5">{{ participantRadar.gapCount }} Skill</div>
                            </div>
                        </div>

                        <!-- Native SVG Radar Chart -->
                        <div class="bg-white border border-slate-200 rounded-md p-4 mb-4 flex flex-col items-center">
                            <h2 class="text-xs font-bold uppercase text-slate-900">Peta Radar Kompetensi Pribadi</h2>
                            <p class="text-[11px] text-slate-500 mb-3">{{ activeParticipant.name }} ({{ activeParticipant.department }})</p>

                            <div class="flex items-center gap-4 text-xs mb-2">
                                <span class="flex items-center gap-1.5"><span class="w-3 h-3 rounded-sm bg-blue-600/30 border-2 border-blue-600"></span> Current Level</span>
                                <span class="flex items-center gap-1.5"><span class="w-4 h-0.5 border-b-2 border-dashed border-amber-500"></span> Target Level</span>
                            </div>

                            <svg viewBox="0 0 320 320" class="w-full max-w-[300px] h-auto overflow-visible">
                                <g v-for="r in participantRadar.rings" :key="r.level">
                                    <polygon :points="r.points" :fill="r.level % 2 === 0 ? '#f8fafc' : 'none'" stroke="#e2e8f0" stroke-width="1" />
                                    <text x="164" :y="r.labelY + 9" class="fill-slate-400 text-[9px] font-semibold">{{ r.level }}</text>
                                </g>
                                <g v-for="(ax, i) in participantRadar.axes" :key="i">
                                    <line x1="160" y1="160" :x2="ax.x2" :y2="ax.y2" stroke="#cbd5e1" stroke-width="1" />
                                    <text :x="ax.labelX" :y="ax.labelY" :text-anchor="ax.anchor" dominant-baseline="middle" class="fill-slate-700 text-[10px] font-bold">{{ ax.skill.code }}</text>
                                </g>
                                <polygon :points="participantRadar.targetPoly" fill="rgba(245, 158, 11, 0.08)" stroke="#f59e0b" stroke-width="2" stroke-dasharray="5 3" />
                                <polygon :points="participantRadar.currentPoly" fill="rgba(37, 99, 235, 0.25)" stroke="#2563eb" stroke-width="2.2" />
                                <g v-for="d in participantRadar.dots" :key="d.id">
                                    <circle :cx="d.tar.x" :cy="d.tar.y" r="3" fill="#fff" stroke="#f59e0b" stroke-width="2" />
                                    <circle :cx="d.cur.x" :cy="d.cur.y" r="4" :fill="d.current_level < d.target_level ? '#e11d48' : '#2563eb'" stroke="#fff" stroke-width="1.5" />
                                </g>
                            </svg>
                        </div>

                        <div class="bg-white border border-slate-200 rounded-md p-4 space-y-2.5">
                            <h3 class="text-xs font-bold uppercase text-slate-900">Rincian Nilai Kompetensi</h3>
                            <div v-for="item in participantRadar.list" :key="item.id" class="p-3 rounded border border-slate-200 bg-slate-50 flex items-center justify-between">
                                <div>
                                    <div class="text-[10px] font-bold text-blue-600">{{ item.code }} • {{ item.category }}</div>
                                    <div class="text-xs font-bold text-slate-900">{{ item.name }}</div>
                                </div>
                                <span :class="['px-2 py-0.5 rounded text-[10px] font-extrabold border shrink-0', item.current_level < item.target_level ? 'bg-rose-50 text-rose-700 border-rose-200' : 'bg-emerald-50 text-emerald-700 border-emerald-200']">
                                    Lv. {{ item.current_level }} / {{ item.target_level }}
                                </span>
                            </div>
                        </div>
                    </div>

                    <!-- MOBILE VIEW 2D: SELF-REPORT SERTIFIKAT MANDIRI (SelfReportTraining.vue) -->
                    <div v-else-if="currentView === 'mobile-self-report'">
                        <div class="bg-white border border-slate-200 rounded-md p-4 mb-4">
                            <h2 class="text-xs font-bold uppercase tracking-wider text-slate-900 mb-1">
                                Lapor Pelatihan &amp; Upload Sertifikat Mandiri
                            </h2>
                            <p class="text-[11px] text-slate-500 mb-3">
                                Unggah sertifikat pelatihan eksternal Anda (PDF/JPG). Status awal <code class="font-mono">pending</code> hingga diverifikasi Tim LnD.
                            </p>
                            <form @submit.prevent="submitMobileSelfReportSim" class="space-y-3 text-xs">
                                <div>
                                    <label class="block font-bold text-slate-700 mb-1">Nama Pelatihan / Sertifikasi</label>
                                    <input v-model="mobileSelfReportForm.course_name" type="text" required placeholder="Contoh: Sertifikasi Ahli K3 Umum BNSP" class="w-full rounded border-slate-300 text-xs py-2 px-3" />
                                </div>
                                <div>
                                    <label class="block font-bold text-slate-700 mb-1">Lembaga Penyelenggara</label>
                                    <input v-model="mobileSelfReportForm.organizer" type="text" required placeholder="Contoh: Kemnaker RI / BNSP" class="w-full rounded border-slate-300 text-xs py-2 px-3" />
                                </div>
                                <div>
                                    <label class="block font-bold text-slate-700 mb-1">Nomor Sertifikat</label>
                                    <input v-model="mobileSelfReportForm.certificate_number" type="text" required placeholder="SER-BNSP-2026-9912" class="w-full rounded border-slate-300 text-xs py-2 px-3 font-mono uppercase" />
                                </div>
                                <div class="grid grid-cols-2 gap-2.5">
                                    <div>
                                        <label class="block font-bold text-slate-700 mb-1">Tgl Terbit</label>
                                        <input v-model="mobileSelfReportForm.issued_at" type="date" required class="w-full rounded border-slate-300 text-xs py-2 px-2.5" />
                                    </div>
                                    <div>
                                        <label class="block font-bold text-slate-700 mb-1">Masa Berlaku s/d</label>
                                        <input v-model="mobileSelfReportForm.expires_at" type="date" class="w-full rounded border-slate-300 text-xs py-2 px-2.5" />
                                    </div>
                                </div>
                                <div>
                                    <label class="block font-bold text-slate-700 mb-1">Upload File Sertifikat (PDF/JPG)</label>
                                    <input type="file" accept=".pdf,.jpg,.jpeg,.png" class="w-full text-xs text-slate-600" />
                                </div>
                                <button type="submit" class="w-full py-2.5 px-4 rounded-lg bg-blue-600 hover:bg-blue-700 text-white text-xs sm:text-sm font-bold shadow-sm">
                                    Kirim untuk Verifikasi Tim LnD
                                </button>
                            </form>
                        </div>

                        <div class="bg-white border border-slate-200 rounded-md p-4">
                            <h3 class="text-xs font-bold uppercase tracking-wider text-slate-900 mb-2.5">
                                Riwayat Status Verifikasi ({{ selfReportsList.length }})
                            </h3>
                            <div class="space-y-2.5">
                                <div v-for="item in selfReportsList" :key="item.id" class="p-3 rounded border border-slate-200 bg-slate-50 text-xs">
                                    <div class="flex items-start justify-between gap-2">
                                        <div>
                                            <div class="font-bold text-slate-900">{{ item.course_name }}</div>
                                            <div class="text-[11px] text-slate-500">{{ item.organizer }} &bull; {{ item.certificate_number }}</div>
                                            <div class="text-[10px] text-slate-400 mt-0.5">Terbit: {{ item.issued_at }} &bull; Exp: {{ item.expires_at }}</div>
                                        </div>
                                        <span :class="['px-2 py-0.5 rounded text-[10px] font-bold uppercase shrink-0', item.status === 'approved' ? 'bg-emerald-100 text-emerald-800' : item.status === 'rejected' ? 'bg-rose-100 text-rose-800' : 'bg-amber-100 text-amber-800']">
                                            {{ item.status }}
                                        </span>
                                    </div>
                                    <div v-if="item.review_notes" class="mt-2 pt-2 border-t border-slate-200 text-[11px] text-slate-600">
                                        <strong>Catatan Reviewer LnD:</strong> {{ item.review_notes }}
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Bottom Navigation Bar (4 Menu) -->
                <nav class="fixed bottom-0 left-1/2 -translate-x-1/2 w-full max-w-md bg-white border-t border-slate-200 z-30">
                    <div class="grid grid-cols-4 h-16 text-xs font-medium">
                        <button @click="currentView = 'mobile-home'" :class="['flex flex-col items-center justify-center gap-1', currentView === 'mobile-home' ? 'text-blue-600 font-bold bg-blue-50/40' : 'text-slate-500']">
                            <span>🏠</span><span>Home</span>
                        </button>
                        <button @click="currentView = 'mobile-scan'" :class="['flex flex-col items-center justify-center gap-1', currentView === 'mobile-scan' ? 'text-blue-600 font-bold bg-blue-50/40' : 'text-slate-500']">
                            <span>📷</span><span>Scan QR</span>
                        </button>
                        <button @click="currentView = 'mobile-skills'" :class="['flex flex-col items-center justify-center gap-1', currentView === 'mobile-skills' ? 'text-blue-600 font-bold bg-blue-50/40' : 'text-slate-500']">
                            <span>🕸️</span><span>Radar Skill</span>
                        </button>
                        <button @click="currentView = 'mobile-self-report'" :class="['flex flex-col items-center justify-center gap-1', currentView === 'mobile-self-report' ? 'text-blue-600 font-bold bg-blue-50/40' : 'text-slate-500']">
                            <span>📄</span><span>Self-Report</span>
                        </button>
                    </div>
                </nav>
            </div>
        </div>

        <!-- ================================================================ -->
        <!-- 3. STANDALONE PRINT-READY A4 RAPOR & SERTIFIKAT VIEW             -->
        <!-- ================================================================ -->
        <div v-else-if="currentView === 'print-report'" class="min-h-screen bg-slate-200 py-8 px-4 print:bg-white print:p-0 print:m-0 [-webkit-print-color-adjust:exact] [print-color-adjust:exact]">
            <!-- Floating Controls -->
            <div class="fixed bottom-6 right-6 z-50 flex items-center gap-2.5 print:hidden bg-slate-900/95 text-white p-2.5 rounded-lg shadow-xl border border-slate-700">
                <select v-model="printParticipantId" class="rounded bg-slate-800 border-slate-700 text-white text-xs py-1.5 px-2.5">
                    <option v-for="p in participants" :key="p.id" :value="p.id">{{ p.name }} ({{ p.nik }})</option>
                </select>
                <button onclick="window.print()" class="px-4 py-2 rounded bg-blue-600 hover:bg-blue-500 text-xs font-bold text-white">
                    🖨️ Cetak / Simpan PDF (A4)
                </button>
            </div>

            <!-- Kanvas A4 -->
            <div class="mx-auto bg-white text-slate-900 w-full max-w-[210mm] min-h-[297mm] p-8 sm:p-10 shadow-lg border border-slate-300 print:shadow-none print:border-0 flex flex-col justify-between">
                <div>
                    <div class="border-b-2 border-slate-900 pb-4 mb-5 flex items-start justify-between gap-4">
                        <div class="flex items-center gap-3.5">
                            <div class="w-12 h-12 rounded bg-slate-900 text-white flex items-center justify-center font-black text-base">PANI</div>
                            <div>
                                <div class="text-[10px] font-bold uppercase tracking-[0.2em] text-blue-700">Learning & Development Division</div>
                                <h1 class="text-lg font-black uppercase tracking-tight text-slate-900">Sertifikat & Rapor Evaluasi Kompetensi Karyawan</h1>
                                <div class="text-[11px] text-slate-500 font-mono">Nomor: CERT/PANI-LND/2026/00{{ printParticipant.id }}</div>
                            </div>
                        </div>
                        <div class="text-right">
                            <span :class="['inline-block px-3 py-1 rounded text-xs font-extrabold uppercase border', printRadar.gapCount === 0 ? 'bg-emerald-50 text-emerald-800 border-emerald-300' : 'bg-amber-50 text-amber-800 border-amber-300']">
                                {{ printRadar.gapCount === 0 ? 'KOMPETEN & LULUS' : 'DALAM PENGEMBANGAN' }}
                            </span>
                            <div class="text-[10px] text-slate-400 mt-1">Tanggal Terbit: 24 Oktober 2026</div>
                        </div>
                    </div>

                    <div class="grid grid-cols-12 gap-3 bg-slate-50 border border-slate-200 rounded p-3.5 mb-5 text-xs">
                        <div class="col-span-5 border-r border-slate-200 pr-3">
                            <div class="text-[10px] font-bold uppercase text-slate-400">Nama Lengkap Peserta</div>
                            <div class="text-sm font-extrabold text-slate-900 mt-0.5">{{ printParticipant.name }}</div>
                            <div class="text-[11px] text-slate-600 mt-1">NIK: <span class="font-mono font-bold">{{ printParticipant.nik }}</span></div>
                        </div>
                        <div class="col-span-4 border-r border-slate-200 px-2">
                            <div class="text-[10px] font-bold uppercase text-slate-400">Departemen</div>
                            <div class="text-xs font-bold text-slate-900 mt-0.5">{{ printParticipant.department }}</div>
                            <div class="text-[11px] text-slate-600 mt-1">Status Kelas: <span class="font-bold text-blue-700">Aktif Terdaftar</span></div>
                        </div>
                        <div class="col-span-3 pl-2">
                            <div class="text-[10px] font-bold uppercase text-slate-400">Tingkat Kehadiran</div>
                            <div class="text-base font-black text-emerald-700 mt-0.5">95.0%</div>
                            <div class="text-[10px] text-slate-500">(Hadir Tepat Waktu)</div>
                        </div>
                    </div>

                    <!-- Tengah Kiri: Radar Chart | Tengah Kanan: Tabel Rincian -->
                    <div class="grid grid-cols-12 gap-5 items-start mb-5">
                        <div class="col-span-5 border border-slate-200 rounded p-3.5 flex flex-col items-center">
                            <div class="w-full text-left border-b border-slate-100 pb-2 mb-2">
                                <h2 class="text-xs font-extrabold uppercase text-slate-800">Peta Radar Kompetensi</h2>
                                <p class="text-[10px] text-slate-500">Kurva Aktual vs Standar Target</p>
                            </div>
                            <svg viewBox="0 0 320 320" class="w-full max-w-[260px] h-auto overflow-visible">
                                <g v-for="r in printRadar.rings" :key="r.level">
                                    <polygon :points="r.points" :fill="r.level % 2 === 0 ? '#f8fafc' : 'none'" stroke="#e2e8f0" stroke-width="1" />
                                </g>
                                <g v-for="(ax, i) in printRadar.axes" :key="i">
                                    <line x1="160" y1="160" :x2="ax.x2" :y2="ax.y2" stroke="#cbd5e1" stroke-width="1" />
                                    <text :x="ax.labelX" :y="ax.labelY" :text-anchor="ax.anchor" dominant-baseline="middle" class="fill-slate-700 text-[10px] font-bold">{{ ax.skill.code }}</text>
                                </g>
                                <polygon :points="printRadar.targetPoly" fill="rgba(245, 158, 11, 0.08)" stroke="#f59e0b" stroke-width="2" stroke-dasharray="5 3" />
                                <polygon :points="printRadar.currentPoly" fill="rgba(37, 99, 235, 0.25)" stroke="#2563eb" stroke-width="2.2" />
                            </svg>
                            <div class="w-full mt-2 pt-2 border-t border-slate-100 flex justify-between text-[11px]">
                                <span class="text-slate-500">Rata-rata Skor:</span>
                                <span class="font-extrabold">{{ printRadar.avgCur }} / {{ printRadar.avgTar }}</span>
                            </div>
                        </div>

                        <div class="col-span-7 border border-slate-200 rounded-lg overflow-hidden">
                            <div class="bg-slate-100 text-slate-800 border-b border-slate-200 px-3.5 py-2.5 flex justify-between items-center">
                                <h2 class="text-xs font-extrabold uppercase">Rincian Evaluasi Skill & Gap Analysis</h2>
                                <span class="text-[10px] text-slate-600 font-semibold">Kompeten: {{ printRadar.compCount }} / 6 Skill</span>
                            </div>
                            <table class="w-full border-collapse text-[11px]">
                                <thead>
                                    <tr class="bg-slate-100 text-slate-700 border-b border-slate-200 font-bold">
                                        <th class="py-2 px-2.5 text-left">Kode & Kompetensi</th>
                                        <th class="py-2 px-2 text-center">Target</th>
                                        <th class="py-2 px-2 text-center">Current</th>
                                        <th class="py-2 px-2 text-center">Gap</th>
                                        <th class="py-2 px-2.5 text-right">Status</th>
                                    </tr>
                                </thead>
                                <tbody class="divide-y divide-slate-200">
                                    <tr v-for="sk in printRadar.list" :key="sk.id">
                                        <td class="py-2 px-2.5">
                                            <div class="font-bold text-slate-900">{{ sk.name }}</div>
                                            <div class="text-[10px] text-slate-500 font-mono">{{ sk.code }} • {{ sk.category }}</div>
                                        </td>
                                        <td class="py-2 px-2 text-center font-semibold">{{ sk.target_level }}</td>
                                        <td class="py-2 px-2 text-center font-extrabold text-blue-700">{{ sk.current_level }}</td>
                                        <td class="py-2 px-2 text-center font-mono font-bold">
                                            <span :class="sk.gap < 0 ? 'text-rose-600' : 'text-emerald-700'">{{ sk.gap > 0 ? '+' + sk.gap : sk.gap }}</span>
                                        </td>
                                        <td class="py-2 px-2.5 text-right">
                                            <span :class="['px-2 py-0.5 rounded text-[10px] font-bold uppercase border', sk.gap < 0 ? 'bg-rose-50 text-rose-700 border-rose-200' : 'bg-emerald-50 text-emerald-700 border-emerald-200']">
                                                {{ sk.gap < 0 ? 'Gap Minus' : 'Kompeten' }}
                                            </span>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>

                <!-- Footer Tanda Tangan & QR Verifikasi -->
                <div class="pt-4 border-t-2 border-slate-900 grid grid-cols-12 gap-4 items-end text-xs">
                    <div class="col-span-4 text-center">
                        <div class="text-[11px] text-slate-500">Dievaluasi Oleh,</div>
                        <div class="text-[10px] font-bold uppercase text-slate-400">Lead Trainer / Assessor</div>
                        <div class="h-14"></div>
                        <div class="font-extrabold text-slate-900 underline">Ir. Hendra Wijaya, M.T.</div>
                        <div class="text-[10px] text-slate-500">Technical Instructor L&D</div>
                    </div>
                    <div class="col-span-4 flex flex-col items-center text-center">
                        <div class="p-1.5 border border-slate-300 rounded bg-white">
                            <svg viewBox="0 0 29 29" class="w-20 h-20" shape-rendering="crispEdges">
                                <rect x="0" y="0" width="29" height="29" fill="#ffffff" />
                                <template v-for="(row, rIdx) in printVerifyQr" :key="'vr'+rIdx">
                                    <template v-for="(cell, cIdx) in row" :key="'vc'+rIdx+'-'+cIdx">
                                        <rect v-if="cell === 1" :x="cIdx + 2" :y="rIdx + 2" width="1" height="1" fill="#0f172a" />
                                    </template>
                                </template>
                            </svg>
                        </div>
                        <div class="text-[9px] font-mono font-bold text-slate-600 mt-1">VERIFY: {{ printParticipant.nik }}</div>
                    </div>
                    <div class="col-span-4 text-center">
                        <div class="text-[11px] text-slate-500">Disahkan Oleh,</div>
                        <div class="text-[10px] font-bold uppercase text-slate-400">Head of Learning & Development</div>
                        <div class="h-14"></div>
                        <div class="font-extrabold text-slate-900 underline">Budi Santoso, S.T., M.M.</div>
                        <div class="text-[10px] text-slate-500">Human Capital & LND Department</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    `
};

createApp(App).mount('#app');
</script>
</body>
</html>
