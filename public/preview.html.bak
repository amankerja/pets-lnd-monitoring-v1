            } else {
                currentDrawerParticipantsSim.value = [
                    { id: 1, name: 'Adi Pratama', nik: 'PANI-0101', department: 'Mining Operations', scanned_at: '25 Okt 2026 - 08:05:12' },
                    { id: 2, name: 'Siti Nurhaliza', nik: 'PANI-0102', department: 'Processing Plant', scanned_at: '25 Okt 2026 - 08:06:44' },
