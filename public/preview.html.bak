        const submitAddSkillTrainerSim = () => {
            if (!selectedTrainerDetail.value || !addSkillTrainerForm.skill_id) return;
            const sk = skills.value.find(s => s.id === Number(addSkillTrainerForm.skill_id));
            selectedTrainerDetail.value.authorized_skills.push({
                id: Date.now(),
                code: sk?.code || 'SKL-NEW',
                name: sk?.name || 'Kompetensi Baru',
                category: sk?.category || 'General',
                license_type: addSkillTrainerForm.license_type,
                license_number: addSkillTrainerForm.license_number || 'BNSP-TOT/2026/NEW',
                valid_until: addSkillTrainerForm.valid_until,
                valid_until_formatted: '30 Jun 2028',
                status: 'active',
            });
            showAddSkillTrainerModal.value = false;
            notify(`Kompetensi [${sk?.code}] berhasil ditambahkan ke profil ajar Trainer!`);
        };

        // Modal Input Jam Mengajar Manual
        const showManualLogModalSim = ref(false);
        const manualLogFormSim = reactive({
            training_title: '',
            log_date: '2026-10-25',
            duration_hours: 2.0,
            scanned_participants_count: 10,
            location: 'Site PBJ Training Room',
        });

        const submitManualLogSim = () => {
            if (!selectedTrainerDetail.value || !manualLogFormSim.training_title) return;
            selectedTrainerDetail.value.teaching_logs.unshift({
                id: Date.now(),
                attendance_session_id: null,
                training_title: manualLogFormSim.training_title,
                course_code: 'MANUAL',
                log_date_formatted: manualLogFormSim.log_date,
                entry_source: 'manual_lnd_entry',
                duration_hours: Number(manualLogFormSim.duration_hours),
                scanned_participants_count: Number(manualLogFormSim.scanned_participants_count),
                location: manualLogFormSim.location,
            });
            selectedTrainerDetail.value.month_teaching_hours += Number(manualLogFormSim.duration_hours);
            selectedTrainerDetail.value.total_scanned_participants += Number(manualLogFormSim.scanned_participants_count);
            showManualLogModalSim.value = false;
            notify(`Jam mengajar manual (${manualLogFormSim.duration_hours} Jam) berhasil dicatat ke profil Trainer!`);
        };

        // Modal & Drawer Peserta QR
        const showParticipantsDrawerSim = ref(false);
        const currentDrawerParticipantsSim = ref([]);
        const currentDrawerSessionTitleSim = ref('');

        const openParticipantsDrawerSim = (log) => {
            currentDrawerSessionTitleSim.value = log.training_title;
